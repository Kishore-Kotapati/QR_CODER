   symbol[167] = 'b000000011000100111101000011110111010101001111101010110000101000011001010010011010111111010010100001111100010001111110111111100110111100100110011101001100101010011111100000101100;
   symbol[168] = 'b000000111111111100001110110111111001100010111100110101101111100000101011111000110101111111111111001100000001001011111100111001010101100101001111100010100100110000111100111110100;
   symbol[169] = 'b000000001110111011000010101110001001011000101110001101011000111000010011000000001101100011000111110100111001110110001100101001001101011111011000101000111000001001001110100010111;
   symbol[170] = 'b111111100001000101011100010010101001111100101000000011001010110010010100001110010010101011001011110010010111110110101010101111100011010001111010100100110110000101001000101010110;
   symbol[171] = 'b100000100111110001011110100110001110011111001011100000101000110011111101000101111001100010100010111000110100100110001001001100000000110010001000100111010101100110101010100011010;
   symbol[172] = 'b101110100010010001100011010011111010001111010001011000011111101010100111110101000000111110010010100000001100111011111001010000111000001000101111111111001101011110010001111111001;
   symbol[173] = 'b101110101101100000011001110000111000000011110101010110001000000100101001111011001110101110011100101110000010110100001111110100010110000100010010001011100101010111110101010011110;
   symbol[174] = 'b101110101111110011101010100000101111001010011110110101100011100001000011111000110101000101111101000101100001010111001100011111010101100111011001001010000110110100011110110010000;
   symbol[175] = 'b100000101010011100110011001010100001110010100110001101010001011001010001001000001101010101001111010101011001010111110100100111101101011111100001110010111110001100100110001010100;
   symbol[176] = 'b111111101001001010111000001010110111010100001010000011011101010110011101010110000011111011001001111011010111111011100010001011100011010011101111110100010010000010001010000100010;

   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;

   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);

   rule tick;
      cycle <= cycle + 1;
   endrule

   rule go (!started);
      dut.start(fromInteger(n));
      started <= True;
      startAt <= cycle;
      $display("start: %0dx%0d symbol (Version 40, Mask 3)", n, n);
   endrule

   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule

   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp;
      dut.mem.resp(answer);
   endrule

   rule get (started);
      let b <- dut.getByte;
      $display("output byte: '%c' (0x%02h)%s", b.data, b.data, b.last ? " <- last" : "");
      if (b.last) begin
         $display("cycles: %0d", cycle - startAt);
         $display("PASS: Version 40 Mask 3 successfully decoded!");
         $finish(0);
      end
   endrule

   rule fail (started && dut.failed);
      $display("FAIL: Decoder raised failed after %0d cycles", cycle - startAt);
      $finish(1);
   endrule

   rule timeout (started && cycle - startAt > 150000);
      $display("TIMEOUT: after %0d cycles", cycle - startAt);
      $finish(1);
   endrule
endmodule

endpackage
