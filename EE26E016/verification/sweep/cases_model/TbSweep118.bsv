   symbol[137] = 'b0001010100001010000100100001010110011000001011011001100111101110111011101111110100011011101010111110101000010001000100010001000101000100010001000101000101010;
   symbol[138] = 'b1110101001111100100110001001000000000001101011011100000000001100110011001101110010110011001010110000100011011101110111011100101111101110111010101110001111110;
   symbol[139] = 'b0100010001110101101110011101110001010001000011001001000111101100110011001100111011000010001000100011101001110111011101110111100101000100010000000101000101011;
   symbol[140] = 'b0100001110110001111100111110010010100101011011011001001100011100010001000101110001101000100010001000101011000101110011001101100111101110111010101110001101110;
   symbol[141] = 'b0110010100001000000100100001010001101010001011001011000111100110111011101111110011000010001000100011001001001101010011001100110101000100011001010010000001000;
   symbol[142] = 'b1000111001111011000110001001100001011011101011010011001100100100110111001101110111101010101010101010000010101101101000100011010111101110101011100000001011101;
   symbol[143] = 'b0111100001110001101110011101111111011101000011010010001110001100110101001100111100110010011101001100001000010001000010001001000101000100001001011011000001000;
   symbol[144] = 'b1010111110101101111100111111100010111111011011011011000101010100010101000101110110010001111000010101001010111101101110111010000111101110111011101010001111101;
   symbol[145] = 'b1101010100001010000100100000100101101001101011011001000111110110111111101111110100111011001100110110001000010111000100010001001101000100010001000101000101010;
   symbol[146] = 'b0000001001100011000110001000011101011000001011011101000000000100110011001101110010110010101110110010000011011101110111011100100111101110111011101110001111110;
   symbol[147] = 'b0000000001101001101110011101100111011000100011001000001111111100110011001100111010000100101000110011001111110111011101110111101101000100010001000101000101011;
   symbol[148] = 'b0000001110110101111100111110111110111100111011011001111111110010010001000101111111001111000010010000111111011100110111001101111111101110111011101110111111110;
   symbol[149] = 'b0000000010001010000100100000100011101000001101011000100010000000111011101110100010000100101000111011100011010100110101001101100010000100010100000100100011001;
   symbol[150] = 'b1111111001111011000110001100101011011001101011011100101010101000110011001100101010001110101010110011101010111010001110100011101011001111011001001110101011110;
   symbol[151] = 'b1000001001110001101110011111100011111001000111001001100011001100110011001100100010110010001100110011100010010100100010001000100011100100110001100101100010011;
   symbol[152] = 'b1011101010111101111010011011111111111101011001011001111110000100011001000101111110010001100100010000111110111011101100111011111111001110111111101110111110110;
   symbol[153] = 'b1011101000000010000011100110011101101000001011000000111011101110101011101111001110111011001110111010110010010011000110010001001001000000010001101100010001000;
   symbol[154] = 'b1011101011110011001000001001111011011001101011001100011000001100101011001101001100110011101100110010010110111101110001011101100011101100111011011110111011100;
   symbol[155] = 'b1000001001100001111000011100000011011001000011001000011001001100111011001101001001000100010100111110111110010111011111110110001001000000010001111100010001000;
   symbol[156] = 'b1111111010110100010100111110011000111101011011000000010011000100010001000101000011101110111100011010110110101100110011001101101011101010111010100110111011100;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
