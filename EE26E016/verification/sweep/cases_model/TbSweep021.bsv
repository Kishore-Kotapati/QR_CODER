package TbSweep021;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep021(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100111010101111111011100111101100101110000001111111;
   symbol[  1] = 'b100000100010000111101000010110000010100110011000001000001;
   symbol[  2] = 'b101110100001010011000110110101010010111010001000001011101;
   symbol[  3] = 'b101110101010111010001111100011011110010000100100001011101;
   symbol[  4] = 'b101110100011010111101000011111111010111010001100001011101;
   symbol[  5] = 'b100000101110010000001100001000111100010000011000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001101011011010100001000101110000100010111100000000;
   symbol[  8] = 'b011000100010110001011101001111110100001000111101101101000;
   symbol[  9] = 'b001111000101101111000110101111010110100110010111100100101;
   symbol[ 10] = 'b000100100100000101110100000001011110001110111110101111101;
   symbol[ 11] = 'b010110000011010010010001111010110000010100010001010011111;
   symbol[ 12] = 'b010110100111001010110001001101110010010111011110101100000;
   symbol[ 13] = 'b001000000010101010110111100111110000110100110111000101110;
   symbol[ 14] = 'b111011111111100010110111001001010010000111111010000111010;
   symbol[ 15] = 'b010111010011010011110111010001110111000000000110000111100;
   symbol[ 16] = 'b011011100000111011111111001101100100001010100101001011100;
   symbol[ 17] = 'b000111000110101011100011101000110110100100001111000000010;
   symbol[ 18] = 'b101011101100001011110011000111000110101010100110001000110;
   symbol[ 19] = 'b010000000011011010010011011101110010011011110011111100011;
   symbol[ 20] = 'b000101100111011000110000101100000010010101011011110110100;
   symbol[ 21] = 'b011011000010101100110111100000010010111101110011111100011;
   symbol[ 22] = 'b011000111111101000110010101111100000011111111101011110111;
   symbol[ 23] = 'b000100010011000111110011100110001011000001100111100000010;
   symbol[ 24] = 'b011010100000100101110110101000001001111001000101001010111;
   symbol[ 25] = 'b111000000110110101100100101010111001001011101111100111000;
   symbol[ 26] = 'b100011111100110001111001101111100001100001100110111111000;
   symbol[ 27] = 'b010110001011111110010110101000101110011001010001100010101;
   symbol[ 28] = 'b000110101111000000110110111010101100010001011010101011000;
   symbol[ 29] = 'b011010001011011100111001101000111110111011010000100010010;
   symbol[ 30] = 'b011011111010100001111110101111110110011000111010111110110;
   symbol[ 31] = 'b000111010010010110010011111001101011010101100101110000010;
   symbol[ 32] = 'b010111101111010011001001101101001011100111000000000010110;
   symbol[ 33] = 'b111101001011010000111001000001011011001101101011001001110;
   symbol[ 34] = 'b100110100010110001110000101011100111111111100000000011011;
   symbol[ 35] = 'b011001001010011100101110001101101110011000010000000001110;
   symbol[ 36] = 'b001010110110111001011110110110101100010000101011011111111;
   symbol[ 37] = 'b011000011010100110101001110010011110111010000000011110000;
   symbol[ 38] = 'b010110110100000101011110111110010110011000111011001100100;
   symbol[ 39] = 'b001001010101101110110011100000001001110101100000010110001;
   symbol[ 40] = 'b100111111011111110110001001101001010000111000011000010100;
   symbol[ 41] = 'b001100001000010111010000100101011000011101101010011000110;
   symbol[ 42] = 'b010001110100101001101001001101100011000111100101111010011;
   symbol[ 43] = 'b000010010100110110000111000101100111011000000010101000010;
   symbol[ 44] = 'b100011111000110111011110100110111101100010100110100101011;
   symbol[ 45] = 'b000001010110100110001001101100001111011000001011101100000;
   symbol[ 46] = 'b000000111100001010111010101110001111111100100110000100100;
   symbol[ 47] = 'b000000011001101110110100000010010000011101110000000100101;
   symbol[ 48] = 'b000000111101100110010011011111111010010111011011111111100;
   symbol[ 49] = 'b000000001010000110110010011000110000111101110001100011110;
   symbol[ 50] = 'b111111100100101011001100011010111010011111111010101011011;
   symbol[ 51] = 'b100000100100101110100010001000100110100010000110100011110;
   symbol[ 52] = 'b101110100000100111111101011111101101001110000100111111111;
   symbol[ 53] = 'b101110100110100111101110001000111111000110001110011111110;
   symbol[ 54] = 'b101110101100010010111101011010110110001010000110001111011;
   symbol[ 55] = 'b100000101011110100010110011000000110011100001000111111100;
   symbol[ 56] = 'b111111100110000111001110010100000100010110110110011001100;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
