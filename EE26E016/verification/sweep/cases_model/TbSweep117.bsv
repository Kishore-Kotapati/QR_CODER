   symbol[127] = 'b00000001101000101101001100101111101011000000001100001111100010100110010101000111111110010101011001010010000001101000101110100100010101110;
   symbol[128] = 'b00000011100001101110110011111000001010000100001010111111000010011000011110111111110011010010010101010111111010110010000100001000111110010;
   symbol[129] = 'b00000000110010011101010110001001001101101011001100100010010001001010011000111000110010111010110010111010001010100010110110101010100010101;
   symbol[130] = 'b11111110101010101001001010101010101000000010101001101011001111011001001110011010111101010111111101010010101000110000000000110001101011001;
   symbol[131] = 'b10000010111001001101111110001001101101000111101100100011110101100111110100101000111000010010111000010010001110001011101110011011100010001;
   symbol[132] = 'b10111010011101000110011111111101100011101111100111111110110000110000110011111111111000111010011000111011111001011101101000001100111110100;
   symbol[133] = 'b10111010011010010010011111101101100011000111100101010010110010000010110001110011000110010010011011110010101100001010011111101101100111100;
   symbol[134] = 'b10111010001011101001111011010000101110000010101001101101001000011011001111110111110011010111111100110111011010101000100001010110100010110;
   symbol[135] = 'b10000010110000100101000010000011000011101111000100011101011010001001011101101100000110111010010001011011000000110011100110010101101111000;
   symbol[136] = 'b11111110110001001111110111111000001111000010001011111111011000011011011110101000100011010111110100010111110010111001100101001010000010010;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
