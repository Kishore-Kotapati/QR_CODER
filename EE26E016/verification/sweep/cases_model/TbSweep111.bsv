package TbSweep111;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep111(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101100001110100111100101000010011110110000001111111;
   symbol[  1] = 'b100000100110100010001101100110001101000011100100001000001;
   symbol[  2] = 'b101110100100001000011101101110001101000100000000001011101;
   symbol[  3] = 'b101110100110011111101011000101110001110010111000001011101;
   symbol[  4] = 'b101110101100001010110011001111110101100111101100001011101;
   symbol[  5] = 'b100000101000110111001000101000101000010100011100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000001111100110000101000101011100101111101000000000;
   symbol[  8] = 'b011111110000001111000000011111111111110010110111100110001;
   symbol[  9] = 'b101001011101001000100111000011100011000110110110100000100;
   symbol[ 10] = 'b111101100001100000001101101000001100010011011101110101111;
   symbol[ 11] = 'b000011000001101100010100010110011000111001001100111100101;
   symbol[ 12] = 'b011110111011011000001010000110010001001101101000101101111;
   symbol[ 13] = 'b101101000101101111010011001011011110011000010100011011010;
   symbol[ 14] = 'b100001100100001001101100000010011011000100111001100010000;
   symbol[ 15] = 'b100000001111100111010111100101010011101101000011100001010;
   symbol[ 16] = 'b100000101011100100100000010101011110100011011111110100100;
   symbol[ 17] = 'b000010011010011001000101001110110011101110101000100000100;
   symbol[ 18] = 'b110010100111010100101100011000111100100010011001110101111;
   symbol[ 19] = 'b110100000111111000110011111111001000101001010100111000101;
   symbol[ 20] = 'b011101111100100011101101110101000001001100000000101101111;
   symbol[ 21] = 'b111101000111101000000111011000110000001001010101011000100;
   symbol[ 22] = 'b000011100101000011110011111000110011010100100000000101101;
   symbol[ 23] = 'b100000001110011011000101000110000101100101010011000100100;
   symbol[ 24] = 'b000001101010110000111011110101010000110010000111110011100;
   symbol[ 25] = 'b010000011011011001010000001000110101100111000010100110000;
   symbol[ 26] = 'b100011111111001010101000111111101000110010101101111110101;
   symbol[ 27] = 'b100110001110011000111010001000101010111101111100100011001;
   symbol[ 28] = 'b111110101100011011101111101010110111001011100000101010100;
   symbol[ 29] = 'b111110001111111000011101001000111010011110011100100010100;
   symbol[ 30] = 'b000011111001111010100101111111101101000011010000111111111;
   symbol[ 31] = 'b100011000110110010010111001001101011100001000010010010101;
   symbol[ 32] = 'b000100111100001100001011110110000100110100011111001001111;
   symbol[ 33] = 'b010001011111110100011100011101101001100001001011111101010;
   symbol[ 34] = 'b111001101001101100100010101000111000110100111101001000000;
   symbol[ 35] = 'b111001011110111110010010001001010010111100100100100101010;
   symbol[ 36] = 'b011111111100011010000101101010010111001010100000011100100;
   symbol[ 37] = 'b111100010110011000001101000000100010011111011100101010100;
   symbol[ 38] = 'b101000110010110011000101111011110101000011000000111111111;
   symbol[ 39] = 'b010000000001001010010111000101101101111001000100100010101;
   symbol[ 40] = 'b101100101011100110101011110010010000111100011001110001111;
   symbol[ 41] = 'b111101011110010110010100100101111101100001001100101100110;
   symbol[ 42] = 'b001001101110101111110111110110111000100100111000100001100;
   symbol[ 43] = 'b100001010000111001100110100101011011000010000010000101010;
   symbol[ 44] = 'b111000111011111101000011000101111110110111111111111100000;
   symbol[ 45] = 'b100101010010011010101000000000100010000001001011001011100;
   symbol[ 46] = 'b000000110111010001000110101101001100010111011101011110111;
   symbol[ 47] = 'b000000011111001011110111110110110110011001010100100010101;
   symbol[ 48] = 'b000000100100111100001111001111100010001100010000111111011;
   symbol[ 49] = 'b000000001100100010010010011000110100011001000111100011001;
   symbol[ 50] = 'b111111101011111001110110101010100010000100101000101010000;
   symbol[ 51] = 'b100000101001011011100111101000110011100100100010100011001;
   symbol[ 52] = 'b101110101001100101011110011111100111010011111110111110111;
   symbol[ 53] = 'b101110101110000010100010100100011011100110101010000000100;
   symbol[ 54] = 'b101110101111000001001000010001110100110011111101010111000;
   symbol[ 55] = 'b100000101111000001010110111100100011110000101110100011101;
   symbol[ 56] = 'b111111100101101001011100000111011111111101100000110110100;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
