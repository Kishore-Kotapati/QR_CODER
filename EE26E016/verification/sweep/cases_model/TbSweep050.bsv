package TbSweep050;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep050(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110111110100001100001010001000000000000001111111;
   symbol[  1] = 'b10000010000100000011000010001000100010100000001000001;
   symbol[  2] = 'b10111010000100001011011111011100110000010100001011101;
   symbol[  3] = 'b10111010101101100010111100000100100011010000001011101;
   symbol[  4] = 'b10111010101100010101111111111000010000111100001011101;
   symbol[  5] = 'b10000010101001000110010010001111100100100000001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000110110001101010110001111100111010100100000000;
   symbol[  8] = 'b10001011100101101000000111111100001000101010111111001;
   symbol[  9] = 'b10010101010010000100100000111011001001010101011000110;
   symbol[ 10] = 'b01010011011010000101110011110101000111010100110011001;
   symbol[ 11] = 'b01100100111101110111001010011011100100110011001011000;
   symbol[ 12] = 'b00100110100011001111001010100010101100101101001000011;
   symbol[ 13] = 'b01110100111111100111111100011101110111001100001010001;
   symbol[ 14] = 'b01011010111101000100010111101000010111101101110010110;
   symbol[ 15] = 'b00100000101110110001101000001001100001100011011110111;
   symbol[ 16] = 'b11011011101001010110110111100011010110001001111101001;
   symbol[ 17] = 'b00011100001010100110111011010101101011001010001001001;
   symbol[ 18] = 'b11100011100010010101001111110011100000100010000101010;
   symbol[ 19] = 'b01101101110000100000101000010001100011010000111100000;
   symbol[ 20] = 'b11101111111011101001101100010011001110000100101100001;
   symbol[ 21] = 'b01000101101101100110010001001011101101000000110111010;
   symbol[ 22] = 'b01001011101010111000111010000111001010111110001100011;
   symbol[ 23] = 'b00111000111010010100010100010101001000100111101001100;
   symbol[ 24] = 'b10111111111000001110101011111100000001101010111111111;
   symbol[ 25] = 'b01001000101011010000111110001100010110111111100011011;
   symbol[ 26] = 'b11101010101100011001101110101111111010101000101010110;
   symbol[ 27] = 'b10101000100010111101110010001000111110111000100010000;
   symbol[ 28] = 'b10011111101100110011101011111101100000110001111111110;
   symbol[ 29] = 'b01101100111000111100101010100110100100110010101001001;
   symbol[ 30] = 'b10100110000110100111110011000100010110010000011110100;
   symbol[ 31] = 'b11000101111010011100000011001110001000101101110111010;
   symbol[ 32] = 'b01100110011010110100101011010110100101110111000011000;
   symbol[ 33] = 'b11001100111101010101001111000110001110000110100010100;
   symbol[ 34] = 'b01100011110011011010111010100111011001100011101000011;
   symbol[ 35] = 'b00110101011101101000111101011011001000010111000111101;
   symbol[ 36] = 'b11000010101000101100000001001111000101011110010011111;
   symbol[ 37] = 'b00111100101001101001100110010011000111000111001110000;
   symbol[ 38] = 'b00001010010111110101100001111100111011011100000100000;
   symbol[ 39] = 'b00010101010110000101000001110011000000110010101111011;
   symbol[ 40] = 'b11111010000000010111100000001010101011110011001110010;
   symbol[ 41] = 'b01101001110010010110000001001110110011101100011011000;
   symbol[ 42] = 'b00000010011011011000110001100100011001000010101110000;
   symbol[ 43] = 'b00000000101011111000001011000001101100100010011011110;
   symbol[ 44] = 'b00000011111100001101101011111011010011110100111110000;
   symbol[ 45] = 'b00000000111000101101001110001010101111110010100010110;
   symbol[ 46] = 'b11111110111110000010010010101000000101101010101010010;
   symbol[ 47] = 'b10000010001000010110011110001001100110111011100010000;
   symbol[ 48] = 'b10111010101100110110000011111011100011000001111110010;
   symbol[ 49] = 'b10111010000010010100100001001111001111001101110100100;
   symbol[ 50] = 'b10111010000001000000001101000010100111100011101001110;
   symbol[ 51] = 'b10000010001110011110101000001100111111001101111011010;
   symbol[ 52] = 'b11111110100011000010000101000110001100010110111100000;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
