   symbol[ 61] = 'b1110000111011000011010110000001101011010010111001010010101010010101101111;
   symbol[ 62] = 'b0000001011000010100011001000100111001110101110010011001111000010101001010;
   symbol[ 63] = 'b0000000001001000000100111011100010001001011011011001111000111100011010000;
   symbol[ 64] = 'b0000001011000110101011001111111111101111111011111110101101111001111110001;
   symbol[ 65] = 'b0000000010100000000010111000100101111001010110001100000111010011100010011;
   symbol[ 66] = 'b1111111011100010101010101010101110010000001110101001010011000010101010110;
   symbol[ 67] = 'b1000001010011000000101001000110010001100111110001111001011100100100011100;
   symbol[ 68] = 'b1011101011111110101011011111111111010011111111111000011100000001111111001;
   symbol[ 69] = 'b1011101000001000000011011001000101011010010101010011110011100011010011001;
   symbol[ 70] = 'b1011101001001010101010100111100110111010101011101011000110110011110100110;
   symbol[ 71] = 'b1000001000011101000001001100110010001001001110000101111001100000011110010;
   symbol[ 72] = 'b1111111001100100101011010010011110100111111000000110101100001001100111111;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
