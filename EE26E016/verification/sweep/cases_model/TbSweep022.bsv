   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b1111111000001111110100001100000001100100110101001110111000001100001111111;
   symbol[  1] = 'b1000001010100010001101011000111110001011011101010110100001010100001000001;
