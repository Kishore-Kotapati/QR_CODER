   symbol[ 49] = 'b0010100110010001111010110100000101111110000011001100011101101010111111111;
   symbol[ 50] = 'b1110111001110111100011001011101111110000011000010001011100010010101101010;
   symbol[ 51] = 'b0000010111011110010100111011010010001100011101011111100110011100011000000;
   symbol[ 52] = 'b1001001101110010111010000011111111101111011000000000110001111001110010001;
   symbol[ 53] = 'b0100100110011100101011010110101100111111110111001010011011010100001111110;
