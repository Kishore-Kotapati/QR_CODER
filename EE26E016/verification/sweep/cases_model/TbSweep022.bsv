   symbol[ 35] = 'b1101100011011000111000010001100001111000011011111100100000010010101100000;
   symbol[ 36] = 'b1000001110100110011110011111011000101110011111001000110101100101001110001;
   symbol[ 37] = 'b1101010110010001100001111100010001101001010111101011111111001100110010011;
   symbol[ 38] = 'b0110011111010010011101101111011011111011101111011010011011010111111001111;
   symbol[ 39] = 'b0100110010011000000000001100001111011101111000111001100000110100001111111;
   symbol[ 40] = 'b0101101000100111010110110110100100000110111100101110110111001000101110110;
   symbol[ 41] = 'b1110000001110010100100100010100011001110010100001100011011101111100111011;
