   symbol[ 33] = 'b0011010100000110000100001000100001010011101110010101001101100001001110101;
   symbol[ 34] = 'b1000001100011011000110100111101010000110100111010000100011011011001111000;
   symbol[ 35] = 'b1001110011100100111000111011000110001100110000111110010010110110111001010;
   symbol[ 36] = 'b1100111111010100000111010111010100101000001111101101011010001001001000000;
   symbol[ 37] = 'b1110110100100010000101100011100011110000111100111000000001110011101100001;
   symbol[ 38] = 'b1001001011110100111100101001011010110010101011110100101001111110100010110;
   symbol[ 39] = 'b0010100011011110011111101010110010011110100100110001000111001010111010100;
   symbol[ 40] = 'b1001011101001001010010110010001100001101001111001001011110001110001100000;
   symbol[ 41] = 'b0010010110100100110110110010111110100111101100001101011101011010111010111;
   symbol[ 42] = 'b1111011000011110110011111001000100100000011001100001110011100011101001100;
   symbol[ 43] = 'b1110000101001010101101101001101010001010000110010110101100001111101110100;
   symbol[ 44] = 'b0111111111010111010101001111101010001011111011111100101001100101111110110;
   symbol[ 45] = 'b1000100010110111000000011000101111010101111010001001000100001001100010101;
   symbol[ 46] = 'b1111101010110010111001111010100001011100111110101010011111010010101010000;
   symbol[ 47] = 'b1000100011101101011110001000111001001100110010001110000010011011100010110;
   symbol[ 48] = 'b1101111111000101010100011111101110001000101111111000101011101110111110100;
   symbol[ 49] = 'b0100000110110010111110101010111010110001111000011011111000100101011000001;
   symbol[ 50] = 'b1101001110111100000101000000011001010011001011011110110001110101010110110;
   symbol[ 51] = 'b1010000101101111010001011000001110111110001000110010000000000100101100100;
   symbol[ 52] = 'b0001011101101000001011111111001100110100000111000010011111000000000010000;
   symbol[ 53] = 'b1010110000000100000010000111101101000111001110101011010110010011000110111;
   symbol[ 54] = 'b0111011001111010011100011100101101100001001111001110111011111000110100100;
   symbol[ 55] = 'b1010100101101011110000011111001011111001000010010000110100100100000000000;
   symbol[ 56] = 'b0111101110101101011100111100111010011000011011110010110001111101001100110;
   symbol[ 57] = 'b0000100010111110010000101110111110010110111010111111011101110000111101001;
   symbol[ 58] = 'b0111111001011110111000010101001001100100011101111000010111100011111001100;
   symbol[ 59] = 'b1100010110000001000110110101111100101000011010100000011000111010101111010;
   symbol[ 60] = 'b1101111100110111101111111111001001111000011011101110111101111111011111100;
   symbol[ 61] = 'b1100100000100011110101101111111010101101011000000101100000100100011000010;
   symbol[ 62] = 'b0000001111111011101110100010111111001010001101000100101001101101001110101;
   symbol[ 63] = 'b0000000101000101110110000001101100011101100110111100010001000000111100111;
   symbol[ 64] = 'b0000001010101110101101111111101110001110110111111010000110010011111110000;
   symbol[ 65] = 'b0000000010101101100000111000101101000100100110001011000110011011100011010;
   symbol[ 66] = 'b1111111011001110011110001010101010100000111110101100110001010111101011110;
   symbol[ 67] = 'b1000001000110010010100111000101010101110100110001110101110101100100011100;
   symbol[ 68] = 'b1011101010100110011111001111111010100010011011111101101110100101111111011;
   symbol[ 69] = 'b1011101010000111110100100011111111001001111000111000000010001001101010101;
   symbol[ 70] = 'b1011101001001110111000110011001000000100111111011011011001110011001000011;
   symbol[ 71] = 'b1000001001010100100110011011111110100111101110010110100111111011000100111;
   symbol[ 72] = 'b1111111000001011010111011100101101001010011011101000010010010110101110101;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
