   symbol[ 28] = 'b1000111111111000100001101111101001101011000111111010110111101100111110001;
   symbol[ 29] = 'b1001100010001000010100001010110101000110110100010011000000111101010010111;
   symbol[ 30] = 'b1001101100111111101000001000110000100100110011111111101011001101101000100;
