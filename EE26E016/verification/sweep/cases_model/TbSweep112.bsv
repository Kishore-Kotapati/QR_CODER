   symbol[ 18] = 'b1011101100111011010100000001011000101010000001100101001001101000011110111;
   symbol[ 19] = 'b0110000111010110111111000010111110110010001101011110100111110001011001010;
   symbol[ 20] = 'b1110001111001010010111000110111100101011100101011101001110011011010111111;
   symbol[ 21] = 'b1001000100011100000110000111111101011101101000010001000111110111100101001;
   symbol[ 22] = 'b1111101000011001011100110010010010000100100101100010111111111000100010001;
   symbol[ 23] = 'b0001000011100100011011111001001000010100011010101010110110110101111110001;
   symbol[ 24] = 'b1110111111011110000100101111111000101000011111111110111010001001111110110;
   symbol[ 25] = 'b1101100010100100110011101000101001110000011110001101000010110101100010000;
