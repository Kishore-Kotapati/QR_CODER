package TbSweep112;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 73 N;
(* synthesize *)
module mkTbSweep112(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b1111111000010001001101010011010000001100100101100101110111111100001111111;
   symbol[  1] = 'b1000001000110100000010111001001011000000000111100110101110001000001000001;
   symbol[  2] = 'b1011101011101101000011011000010101001000101000011111110110110000001011101;
   symbol[  3] = 'b1011101011100001001010110001100001100000000110111010010111011100001011101;
