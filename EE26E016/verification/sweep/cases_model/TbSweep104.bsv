   symbol[170] = 'b111111101100101110000110111110101001010111101010010000101010100000100110100101101000101011001100000101111101001110101011000110110000110111001010101011111001001011100011101011011;
   symbol[171] = 'b100000100001101011111100011110001011110111000101011011011000111011100010101101111000100010001010110011001101101110001000011100101100011100001000110000101010010000100001100011000;
   symbol[172] = 'b101110100110101011001001010011111101101100111011001100001111111100000101111001000001111111110001010010011110110011111011100101000111100001001111100011100001000101100111111111011;
   symbol[173] = 'b101110100101011111010011111011000110010010111111010110101001000110100001000101110000101101100111011011001111100100111000110000111010111110100001100001001001111101011000111010111;
   symbol[174] = 'b101110100101101000001010100011111010010010100100010101111011000011111100100010101011111100000010010001100111101001010110111110010110111001000010001101000010010111011010010010101;
   symbol[175] = 'b100000101110111111000111001111010011110100011011011101101110111001101001000101101010110110100010111100111100111001011100110000011100110000101001000111011100111101001000011100100;
   symbol[176] = 'b111111100001100011001011010000000001110000000100100011110010100100000100000001010101011110001101011101101101001011010101100101010101100111011000010000110011100100101001000111110;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
