   symbol[171] = 'b100000101000010111111010000010001111101000011110111101011000100110000110100010111111100010101110001010110010101110001001001100111000101100001000100001001011000111001010100010110;
   symbol[172] = 'b101110101101101001101011101111111111110000000100111110001111101100100111010010110011111110000100110101100011011011111100111111100100111001001111110100111101010000111100111110100;
   symbol[173] = 'b101110101110111010011110010010111001010111100101011000001000011100101101111111101111011110010111100110110010010011100001000111100001000101010011111101100111100100100011100101000;
   symbol[174] = 'b101110101101001110011100111011001000110111101011011000111010100110001100100011001001100101010100001001100111010001010010011001100000011000100110101011111010110011111110110010000;
   symbol[175] = 'b100000101111100110010000010011010110011001101011011101010010110110000111000000110110100001110100001101011111100000000111001000101001001101100011111111101011100110101011100111000;
   symbol[176] = 'b111111100111001001001001010101010011101100011011011100000000011100100110011101001010000111111000110010010000110101000010111010000110111000110100100011111000110011111100110010110;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
