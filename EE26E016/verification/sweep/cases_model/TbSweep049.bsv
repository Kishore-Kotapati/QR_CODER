package TbSweep049;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep049(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101100011000111110100101101000001111111;
   symbol[  1] = 'b100000101010000011110100000111000000001000001;
   symbol[  2] = 'b101110100001001001011110100011111000001011101;
   symbol[  3] = 'b101110100000100001110100001001011100001011101;
   symbol[  4] = 'b101110101101101001111111100011110100001011101;
   symbol[  5] = 'b100000101000100011101000100001011000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001110010110111000100101100001100000000;
   symbol[  8] = 'b111001101001111010011111101111000011111110011;
   symbol[  9] = 'b111010010001110000000110000101101001100100010;
   symbol[ 10] = 'b100011111111000011111100001111100011001110101;
   symbol[ 11] = 'b010001000011001001011110100001110001100000011;
   symbol[ 12] = 'b000101101011000011110110001001011010101000100;
   symbol[ 13] = 'b101001011000100001011110000011110000000010000;
   symbol[ 14] = 'b010101110000100011111100001001111010101000100;
   symbol[ 15] = 'b100100010010101001011110111000010110011000001;
   symbol[ 16] = 'b001001111110100111110110010000111100110001000;
   symbol[ 17] = 'b001110011100000111011001011010010110011011110;
   symbol[ 18] = 'b011111101001011100001011111000111110111001000;
   symbol[ 19] = 'b110010001101010110100001011100000110011101110;
   symbol[ 20] = 'b010011111010111110001111110110100101111111101;
   symbol[ 21] = 'b000110001001110110001000111100001110100010110;
   symbol[ 22] = 'b011110101100011100011010111110100110101011111;
   symbol[ 23] = 'b100110001110110110101000100101100001100010010;
   symbol[ 24] = 'b010111111011111010001111101111000011111111111;
   symbol[ 25] = 'b110110010001110000000100000101101001101000001;
   symbol[ 26] = 'b001111111101000011110110101111100010100010110;
   symbol[ 27] = 'b001101001011101001000100000001110000100000000;
   symbol[ 28] = 'b110100101011100011111110101001011010111010100;
   symbol[ 29] = 'b110110011101100001001100000011110001110001100;
   symbol[ 30] = 'b101000111111000011101001101001111010011011000;
   symbol[ 31] = 'b110100001011101001011011111000010110010001101;
   symbol[ 32] = 'b111100101110100111101001010000111101011111100;
   symbol[ 33] = 'b001101010100000111001001111010010110010111111;
   symbol[ 34] = 'b000000100110111100001001111000111111011101000;
   symbol[ 35] = 'b000000000100010110111011111100000110010111101;
   symbol[ 36] = 'b000000111010111110001111110110100101111111111;
   symbol[ 37] = 'b000000001100010110011000111100001111100010010;
   symbol[ 38] = 'b111111100010111100011010111110100111101010111;
   symbol[ 39] = 'b100000101100010110101000100101100000100010010;
   symbol[ 40] = 'b101110100001111010011111101111000011111110111;
   symbol[ 41] = 'b101110100101110000010110100101101000011000000;
   symbol[ 42] = 'b101110101101000011111110001111100010010000111;
   symbol[ 43] = 'b100000101011101001010001000001110000111010010;
   symbol[ 44] = 'b111111101011100011111011101001011010011000111;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
