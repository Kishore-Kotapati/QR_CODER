package TbSweep006;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep006(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101100001010111011010001000101100001001100001111111;
   symbol[  1] = 'b100000100111010111110100100001010000110100111000001000001;
   symbol[  2] = 'b101110100010011101111100101110001011011100100100001011101;
   symbol[  3] = 'b101110100111101111000111011100111111001011110100001011101;
   symbol[  4] = 'b101110101100001100100111111111100010011110111100001011101;
   symbol[  5] = 'b100000101101010111101100111000101101000011111000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000001100011110101101000101100011001000100100000000;
   symbol[  8] = 'b011111110100011001101011111111110000101100011000100110001;
   symbol[  9] = 'b110111000110000100010010001111010100011001001101011111010;
   symbol[ 10] = 'b111100100100110011101000010100001001100100111000000010000;
   symbol[ 11] = 'b110001001111111111010001110010000001000101000111000111010;
   symbol[ 12] = 'b110001101011101100111001100101101000001010011101110100100;
   symbol[ 13] = 'b110000011010001101010111001001100111101110101110100011100;
   symbol[ 14] = 'b100010100111011011110100011100010111110011111001110001011;
   symbol[ 15] = 'b110101011111100101000100111001001101111001000100110101001;
   symbol[ 16] = 'b001101101100010101101001110001111001001100000000111011111;
   symbol[ 17] = 'b011100011110011100110001001000011100011001010101001111010;
   symbol[ 18] = 'b000010111100111011101100000001010000100100110000001010000;
   symbol[ 19] = 'b110001000111100101010100100100001010000010100011100001010;
   symbol[ 20] = 'b010010111010010110100001010111111111110111111111111010100;
   symbol[ 21] = 'b100011010011011001000000011100111011100110101010111001000;
   symbol[ 22] = 'b110001111111100010111010101100110100010001111101111000001;
   symbol[ 23] = 'b110101000110011010101010000111001010110100010100111001010;
   symbol[ 24] = 'b101101111100111011101010110101010111001000100001101100101;
   symbol[ 25] = 'b111100000111100000000100010000011010010110110100111001110;
   symbol[ 26] = 'b000011111100011010100101001111101101001101100001111111000;
   symbol[ 27] = 'b100010001110010011101101001000101001100000110001100011110;
   symbol[ 28] = 'b000010101011101110101011111010101100110100111110101011000;
   symbol[ 29] = 'b010010001011010001110110011000100001100000111001100011001;
   symbol[ 30] = 'b110011111101101011100010101111100000110100101001111110000;
   symbol[ 31] = 'b110101000001011011100010001000101010011101010100000101000;
   symbol[ 32] = 'b011100111001111110010101101101110111001010000001000100110;
   symbol[ 33] = 'b111001011000011110111101010110111010111111010100010010100;
   symbol[ 34] = 'b001100100100111101111101101101001100000010000001100111111;
   symbol[ 35] = 'b101111010000010111110111001100101101011001011010010011001;
   symbol[ 36] = 'b001100111001001110001011111111110000000100010111100000111;
   symbol[ 37] = 'b011001011000010000110100000100111101110001011011010101010;
   symbol[ 38] = 'b001101110100001011110010110000111001101100100101100000011;
   symbol[ 39] = 'b110001001010011010100010000000001010100100110010010101010;
   symbol[ 40] = 'b000100110111111011100101111001110111010011100111110110101;
   symbol[ 41] = 'b110101001000011011101100001100111010000110110011001110111;
   symbol[ 42] = 'b000000101111011101100100010101001101010010000101101001101;
   symbol[ 43] = 'b110111011111001110010111000000100100110001100100100110110;
   symbol[ 44] = 'b001111100100101111001011110100000001010100100010100001111;
   symbol[ 45] = 'b110101000100111100010101100001111100000000001000010101000;
   symbol[ 46] = 'b000000101111110101110000010110111001011100000000000000010;
   symbol[ 47] = 'b000000001000001001100111100101011011100110000010110101000;
   symbol[ 48] = 'b000000111011100111000001101111111110110101011111111110100;
   symbol[ 49] = 'b000000001010000100101001011000100011100001101010100010100;
   symbol[ 50] = 'b111111101111010101000000111010101100110101111101101011111;
   symbol[ 51] = 'b100000101111001000110111101000100100101010111100100010101;
   symbol[ 52] = 'b101110101100100111001000011111111001000100111000111111111;
   symbol[ 53] = 'b101110101101100010110100100101101010011101010101101010000;
   symbol[ 54] = 'b101110101110010111110111000000111011010101100000100011001;
   symbol[ 55] = 'b100000101000011001100101101111010100001101000011101101111;
   symbol[ 56] = 'b111111100011011101011110000100100001111010011110110111111;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
