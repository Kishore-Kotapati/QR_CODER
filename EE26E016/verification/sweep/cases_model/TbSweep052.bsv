   symbol[ 34] = 'b1110011010000001011100001001110010010110101010110000001101001001011000010;
   symbol[ 35] = 'b0000010010010101101000001100110111011101000001010011100011000010001001000;
   symbol[ 36] = 'b1000111001101011110111100001100011011111011110111001001101011100111110010;
   symbol[ 37] = 'b1001110011111101000111100100110101110110011101011010100111110110101011001;
   symbol[ 38] = 'b1101101100001000101000101101110110010110101100010000001101011000011110010;
   symbol[ 39] = 'b0001000110011100111101001001010000011101000001110111100111100110101001000;
   symbol[ 40] = 'b0011001101110011110000010000011111011111011101011110001111011011111110010;
   symbol[ 41] = 'b0010100001110101110111010011101110110110011011111100100001110100101010001;
   symbol[ 42] = 'b0010101010001000101101001110010011110110101010110010001011010101011110010;
