typedef 73 N;
(* synthesize *)
module mkTbSweep052(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b1111111010001111101011100101100011000110110011111110100010010100001111111;
   symbol[  1] = 'b1000001010011111001000111110001110110111000001111011110001111100001000001;
