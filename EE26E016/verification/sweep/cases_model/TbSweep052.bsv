   symbol[ 50] = 'b0001101010010000101011011100111011000110111111100011101111010001101011010;
   symbol[ 51] = 'b1101100100000100010111111101101111011101100011001000010100101011011110100;
   symbol[ 52] = 'b1111001011101010011000011001000010111111110101001001010010000101001001010;
   symbol[ 53] = 'b0111000011110101110010101000001000110110000111011010010110101111111110001;
   symbol[ 54] = 'b0101101011000101001010001010000111010111011001111001001110001100001011110;
   symbol[ 55] = 'b1001110110110000010111011110001100111111000101010111110111000000111110000;
   symbol[ 56] = 'b1111011010111001111000011100011110110101011111010110010101010000101101010;
   symbol[ 57] = 'b0011010001011110010011001101011101110100011001011100111001111011011010101;
   symbol[ 58] = 'b1001101011111110101011001110011011110110101011111010000001000001101001110;
   symbol[ 59] = 'b1001010101010100010110111010001101110001100101010001111101101011011000100;
   symbol[ 60] = 'b1011001110000100111000111010011110101110111101010000010001000001101001010;
   symbol[ 61] = 'b1011110010100100010011001101011101101010011111011010111101101011011111011;
   symbol[ 62] = 'b0000001101011000101010001110011011111110101101100000001101000001101010011;
   symbol[ 63] = 'b0000000110100101110110111000010111101110000011000110011011101011010111011;
   symbol[ 64] = 'b0000001000111010011001011111101110011100111011111111000101000001111110000;
   symbol[ 65] = 'b0000000011011010010011001000111000111101011010001101010111101110100010100;
   symbol[ 66] = 'b1111111001111010011010001010111000000110001010101010001111001011101011100;
   symbol[ 67] = 'b1000001001110101010101101000101101101001101110001000100001111011100010101;
   symbol[ 68] = 'b1011101010000010100111101111111110011000100011111001101011011001111111011;
   symbol[ 69] = 'b1011101011100100001011000010011100110100000000001010000001110010000111100;
   symbol[ 70] = 'b1011101011011100111000100001011010011000110010001001000001010001010101010;
   symbol[ 71] = 'b1000001000100101011011101011010101110110011000100111110010101010001111000;
   symbol[ 72] = 'b1111111001111100000001101101110110011100101000011110010100100001011000010;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
