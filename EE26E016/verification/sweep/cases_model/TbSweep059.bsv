   symbol[170] = 'b111111101100111000011110100110101101011111110000010001111010101010000010010010100110101011001110000110101110111110101011110110110010010000111010111010010000011110000011101010001;
   symbol[171] = 'b100000100111101111101010001110001000001001101110101000001000110011010010100011000110100011010110111001000111001010001000111100011001111110011000110000111011010110110001100010100;
   symbol[172] = 'b101110101001101101000101101011111011100110001010010010001111100001101000111100000001111110000011111011101011000011111010110100111010110110101111111010110010011010110000111110101;
   symbol[173] = 'b101110100101000100001111101011001001100100010100101101101110101001011101001001001110101111110110010001000111101100010000110110110000110100000010001101000010101011100010010100110;
   symbol[174] = 'b101110101011000010010110110101000111011011100111010100110000101000000010101010100011101011000010000011101101001110011100010110111100011110101000100101100001101100101000111100001;
   symbol[175] = 'b100000101110010001100001100010100110001110011110101010100111000111010111010101000001010001000101111100100100010100010110111110010110110100000010001111011011010100111010010110110;
   symbol[176] = 'b111111100001000111000101011011011101100110010001010110001110010010101001110010000100001000110110111100001110111100101100110110101100111110101010101101110010100000110010111100111;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
