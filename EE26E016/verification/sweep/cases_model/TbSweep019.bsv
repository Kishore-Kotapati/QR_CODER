package TbSweep019;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep019(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101110110100111010100001001100001111111;
   symbol[  1] = 'b100000100100110101000010111001010100001000001;
   symbol[  2] = 'b101110101000011011001100110011100000001011101;
   symbol[  3] = 'b101110101010011000100101010010000100001011101;
   symbol[  4] = 'b101110101110101000011111101010111000001011101;
   symbol[  5] = 'b100000100101101110001000100100010100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000011000000001000110001011111000000000;
   symbol[  8] = 'b111100101001101010001111111101010001010011101;
   symbol[  9] = 'b010111001111100011111101111110110010101111011;
   symbol[ 10] = 'b111000110111101010011101001110001000001001111;
   symbol[ 11] = 'b100100011101000100110011001110010100001111110;
   symbol[ 12] = 'b101010100100000101110000101101111110101100110;
   symbol[ 13] = 'b101011010100011111001110010101000110110100111;
   symbol[ 14] = 'b101011101001010001100100010011001010110010010;
   symbol[ 15] = 'b011010010111010010000101100001000101010101110;
   symbol[ 16] = 'b011001101001001100111111011001110101010011101;
   symbol[ 17] = 'b000011000111100010010100010111111011100000010;
   symbol[ 18] = 'b011011110110011000100101010100111000000111101;
   symbol[ 19] = 'b010111000101000000010101101000111100100001001;
   symbol[ 20] = 'b100011111111001110011111100100110101111111010;
   symbol[ 21] = 'b110010001111000101111000100111010100100010100;
   symbol[ 22] = 'b100010101100010101011010111111001111101011010;
   symbol[ 23] = 'b010110001101111011001000111010000100100010011;
   symbol[ 24] = 'b111011111011111100111111110011100111111111111;
   symbol[ 25] = 'b010100001111001110000100101011011111011111001;
   symbol[ 26] = 'b110101100011010001101100001101010010010000111;
   symbol[ 27] = 'b100010010010110010001011011110100010111010100;
   symbol[ 28] = 'b011010101100001000110101100110010011001011111;
   symbol[ 29] = 'b011100011100000100011101101100011100011010000;
   symbol[ 30] = 'b101111111101100111000101100111111101100110100;
   symbol[ 31] = 'b110000000001011111101101001100101111101010011;
   symbol[ 32] = 'b100111111000010111101011000010101001001110010;
   symbol[ 33] = 'b100101011011010100100000100001001111001100110;
   symbol[ 34] = 'b000000100101110101000000011001010000010100011;
   symbol[ 35] = 'b000000000001111011010110010011100010010010010;
   symbol[ 36] = 'b000000101000111000101111110010000000111111100;
   symbol[ 37] = 'b000000001010101000001000101010111001100011101;
   symbol[ 38] = 'b111111100000101111011010100100010111101011101;
   symbol[ 39] = 'b100000100111001100011000111010110010100010001;
   symbol[ 40] = 'b101110100110010001011111100000001011111110110;
   symbol[ 41] = 'b101110101100010100111011001000000101011001110;
   symbol[ 42] = 'b101110101001100111011000100101100100110010000;
   symbol[ 43] = 'b100000101111011111101111010101001110010100111;
   symbol[ 44] = 'b111111101101010011101001111011001000011010010;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
