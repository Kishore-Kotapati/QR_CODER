   symbol[138] = 'b0001111010100000011101010010000010011010110000000110011011010111101000010110101001101000010111101001111000000110101100000111110100110101100000110101010100101;
   symbol[139] = 'b0000110101010101001010111001000101110101100111101100101011001000010111101000011111100110101100000111001101010011111001010011000001100000110101100001100001111;
   symbol[140] = 'b1100101010010001011000011010100100011001111111111101100001100000110101100001010101001100000110101100001111111001010111101001010011001010011111001010101001010;
   symbol[141] = 'b0101100111010001011111111010011100110011010000000010011100010101100000110100101000011001010011111000010010001110001000010111100110011111001010011000011110011;
   symbol[142] = 'b0011001010100000011101010010000000000010110000000110011100110111101000010110101100110001110001110001011001100000110011111000001100110101100000110011010000110;
   symbol[143] = 'b0011010101010101001010111001000011111101100111101100101001001000010111101000011000010111101000010110101100110101100110101101110001100000110101100111100011100;
   symbol[144] = 'b1110011010010001011000011010100110011001111111111101100001100000110101100001010010110101100000110101101110011111001010011110101011001010011111001110101011001;
   symbol[145] = 'b0110000111010001011111111010011110110011010000000010011100110101100000110100101111100000110101100001110011001010011111001010011110011111001010011110011110001;
   symbol[146] = 'b0000001010100000011101010010000110000010110000000110011011010111101000010110101001101000010111101001111000000110101100000111110100110101100000110101010100101;
   symbol[147] = 'b0000000101010101001010111001000011111101100111101100101011001000010111101000011111100000101100010111001101010011111001010011000001100000110101100001100001111;
   symbol[148] = 'b0000001010010001011000011010111110011001111111111101111111100000110101100001111111001010000110110100111111111000010111101001111111001010011111001010111111010;
   symbol[149] = 'b0000000011010001011111111011100010110011010000000011100010010101100000110100100010011111010011100000100010001111101000010110100010011111001010011111100010011;
   symbol[150] = 'b1111111010100000011101010011101010000010110000000111101010110111101000010111101010110101110001101001101011100001010011111000101010110101100000110101101010110;
   symbol[151] = 'b1000001001010101001010111001100011111101100111101101100011001000010111101000100010010111101000010111100010110100000110101100100011100000110101100001100011100;
   symbol[152] = 'b1011101010010001011000011011111110011001111111111101111111100000110101100001111110110101100000110100111110011111001010011111111111001010011111001010111111001;
   symbol[153] = 'b1011101001010001011111111011000110110011010000000011100000110101100000110100110101100000110101100001101111001010011111001011010010011111001010011111001010001;
   symbol[154] = 'b1011101000100000011101010010100000000010110000000111000011010111101000010110010111101000010111101001001101100110101100000111111000110101100000110101100000110;
   symbol[155] = 'b1000001001010101001010111000100111111101100111101100111101001000010111101001101101100000110000010110011000110011111001010010101101100000110101100000110101100;
   symbol[156] = 'b1111111010010001011000011010111100011001111111111100110111100000110101100001100111001010011000110100010010001000010111101000001111001010011111001010011111001;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
