package TbSweep064;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep064(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100000111010110100101111000000001111111;
   symbol[  1] = 'b100000100100101001011110100101001000001000001;
   symbol[  2] = 'b101110101000100011110100001011011000001011101;
   symbol[  3] = 'b101110100110001001011100100011110100001011101;
   symbol[  4] = 'b101110100110101011101111101001011000001011101;
   symbol[  5] = 'b100000100010101000111000100011010000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001110011100101000101101000011000000000;
   symbol[  8] = 'b111011111001010011101111100101101001111000100;
   symbol[  9] = 'b100101000110010011000100001111000011001110011;
   symbol[ 10] = 'b101011100000001001011110101101101011101100011;
   symbol[ 11] = 'b010000011110000011110100001001010011001001111;
   symbol[ 12] = 'b100010101101101011011110100011110000000011110;
   symbol[ 13] = 'b110001001001000011010100001001011011001000000;
   symbol[ 14] = 'b011001110101101001011110101011110010101011001;
   symbol[ 15] = 'b100011000101100011110100010000110101110011000;
   symbol[ 16] = 'b111010100100101111011110111010010110111110101;
   symbol[ 17] = 'b000100011100100101010011010000111100110011010;
   symbol[ 18] = 'b010100110100010110101001011010110110011101111;
   symbol[ 19] = 'b011011001001011100101011110100100100110101001;
   symbol[ 20] = 'b001111111010110110001111101100001111111111111;
   symbol[ 21] = 'b001010001110010101101000100110100101100010110;
   symbol[ 22] = 'b000010101000010110111010110100101110101010010;
   symbol[ 23] = 'b010110001010011100001000101101000011100010111;
   symbol[ 24] = 'b110111111001110010101111100101101001111110110;
   symbol[ 25] = 'b001000011001010010011100101111000011000010111;
   symbol[ 26] = 'b111001110010001001011100101101101010001000001;
   symbol[ 27] = 'b111011011011000011101110101001010011100010101;
   symbol[ 28] = 'b011100100101101011010100000011110000010010110;
   symbol[ 29] = 'b011110000101000011010100101001011010111011000;
   symbol[ 30] = 'b100100110011101001000011101011110010110001101;
   symbol[ 31] = 'b100000001101000011110001010000111101110011000;
   symbol[ 32] = 'b011111100000101111000011111010010111110111101;
   symbol[ 33] = 'b010100001010100101010001010000101100111101011;
   symbol[ 34] = 'b000000100010010110100010011010100111110111111;
   symbol[ 35] = 'b000000000000111100010001110010100101110101010;
   symbol[ 36] = 'b000000100110110110101111111000001011111111111;
   symbol[ 37] = 'b000000001100110100011000110000100011100011010;
   symbol[ 38] = 'b111111101000010110101010111110101101101010110;
   symbol[ 39] = 'b100000101110111100001000101011000010100011011;
   symbol[ 40] = 'b101110101101110010111111100111101001111111010;
   symbol[ 41] = 'b101110100011010010011100001111000010010000110;
   symbol[ 42] = 'b101110101001101001010110001101101010111010001;
   symbol[ 43] = 'b100000101111000011110011001001010010010000110;
   symbol[ 44] = 'b111111101001101011010001000011110000111010111;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
