package TbSweep095;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep095(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110010000010000011000111100010011010100001111111;
   symbol[  1] = 'b10000010101110110100000010001000011001111000001000001;
   symbol[  2] = 'b10111010010110101111100100011110000010001000001011101;
   symbol[  3] = 'b10111010011110011110000010011100100000110100001011101;
   symbol[  4] = 'b10111010110011110111001111111000100001111000001011101;
   symbol[  5] = 'b10000010011000100010101110001101010011001100001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000001001110011110010001101011000010010100000000;
   symbol[  8] = 'b10101010001110010100000111111110100110111001100010010;
   symbol[  9] = 'b01010100101100100000100001101111111000110110111110011;
   symbol[ 10] = 'b01010110010010100011111100111100000111001100101111101;
   symbol[ 11] = 'b10111001010000010101111001001101100010000110000100001;
   symbol[ 12] = 'b01010110100110110000000010011101000000010011001110000;
   symbol[ 13] = 'b11101000101111010000000110111111000111000100001010111;
   symbol[ 14] = 'b11100110111110000011011000000100011001110110110110110;
   symbol[ 15] = 'b00100000001101110001000010001011011110000111101011010;
   symbol[ 16] = 'b11000011101011000011010101111110011110011010000001111;
   symbol[ 17] = 'b11111001011001101100100001111001100000111111010011001;
   symbol[ 18] = 'b00001110111011011101001011010101110101101111111101000;
   symbol[ 19] = 'b10011100111010110100110001101101000010101110110001111;
   symbol[ 20] = 'b10011110110011001110110110101110001101000110010010101;
   symbol[ 21] = 'b10011001111011001001111111100110001010100100110101011;
   symbol[ 22] = 'b11010011100111000111010100111100010101111010011101010;
   symbol[ 23] = 'b10100100111010000010010010110110101110110010101000111;
   symbol[ 24] = 'b01001111110001000000011011111000111010101110111110010;
   symbol[ 25] = 'b00101000100101010100101010001111111111000000100010111;
   symbol[ 26] = 'b11001010100101101001011010101100011011110001101011010;
   symbol[ 27] = 'b11011000110111001110110010001111001011000100100011010;
   symbol[ 28] = 'b01111111111011101110000011111110111110001100111111001;
   symbol[ 29] = 'b00100001100011010100111110011000110100110011101100101;
   symbol[ 30] = 'b00001111010001111111101111111000100010000101100000101;
   symbol[ 31] = 'b11000000100001101001111101110010110100000010011010010;
   symbol[ 32] = 'b10101011000100110001001001001001010110101110000111011;
   symbol[ 33] = 'b11100000000100010001100100101001010100101100101100101;
   symbol[ 34] = 'b01010011111010110111001000110101101010011111000001100;
   symbol[ 35] = 'b00001101100011110101011101111111101011111101111011111;
   symbol[ 36] = 'b10000010000000001111100011011000001000011101011011111;
   symbol[ 37] = 'b00110001111001100010000101011011011011001001010000000;
   symbol[ 38] = 'b11110010111101111110001011100001000011110011001110100;
   symbol[ 39] = 'b11101001010100000111111011101010110111011111111111101;
   symbol[ 40] = 'b01101111001010101101010110010110100010101110001010111;
   symbol[ 41] = 'b11111000101110110110000001100110011011001000111000000;
   symbol[ 42] = 'b00000011100000101100011110110100110001011100001000011;
   symbol[ 43] = 'b00000000101100011100010010010100100110110110111111100;
   symbol[ 44] = 'b00000011001100000101111011111110100100000001111111010;
   symbol[ 45] = 'b00000000100000100001100010001000101101010001100010110;
   symbol[ 46] = 'b11111110011011110011101010101000000111101111101011001;
   symbol[ 47] = 'b10000010011000111101001110001000000110111001100011011;
   symbol[ 48] = 'b10111010101100101001101011111110010111010111111111001;
   symbol[ 49] = 'b10111010011100011011110000011101101001100101100101000;
   symbol[ 50] = 'b10111010111100001001011101010010000011010101110101010;
   symbol[ 51] = 'b10000010001110010001100100111010110110110101011111001;
   symbol[ 52] = 'b11111110101110111100100000001011111111110111111000101;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
