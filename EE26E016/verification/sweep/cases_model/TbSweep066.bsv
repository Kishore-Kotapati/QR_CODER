package TbSweep066;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep066(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100100010101111011010010011001000111110000001111111;
   symbol[  1] = 'b100000101010000111010000111010010001000000111000001000001;
   symbol[  2] = 'b101110100110101010001111000100001111111011000000001011101;
   symbol[  3] = 'b101110101000010000100101010011101110011010010100001011101;
   symbol[  4] = 'b101110101101011001111011001111101100110000011100001011101;
   symbol[  5] = 'b100000100111110100001110011000100110010011111000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001001100110101100001000100110110000101111000000000;
   symbol[  8] = 'b010111101011111010110010011111110101010001110101111011010;
   symbol[  9] = 'b100111010010000101000000000101110100010000111100101000111;
   symbol[ 10] = 'b110100101010001010010110010011011100000010101100110010111;
   symbol[ 11] = 'b000111000110101100110101011000101010100110110001111001001;
   symbol[ 12] = 'b000111100011000000110111001100110011010111011111110010011;
   symbol[ 13] = 'b110011011110010101101101001110110000111101101111000001001;
   symbol[ 14] = 'b000001110110101001111110011001000010010110010110010110010;
   symbol[ 15] = 'b001100000001111001111101111001011101101010111001001111011;
   symbol[ 16] = 'b011000100011010001101101101010010111111010111100111101101;
   symbol[ 17] = 'b110111011100010000100001101011110100100001101101100110010;
   symbol[ 18] = 'b001011111100101011110111100001100111101000101000101111101;
   symbol[ 19] = 'b101010001011000010101110000011101010100001001000100101001;
   symbol[ 20] = 'b111110110110110001111111100110001011011001110010111110100;
   symbol[ 21] = 'b110011011000100110000001000110011010010101111011010110101;
   symbol[ 22] = 'b001001110001010010000100101001010110101010101001001100100;
   symbol[ 23] = 'b100100011111100101111010000011001100100011000100000101100;
   symbol[ 24] = 'b011110111101100101110010001101001011101000000100000000111;
   symbol[ 25] = 'b000101010101100100010111010000100011111010010111010010111;
   symbol[ 26] = 'b100111111100011001110011001111101100100000001111111110001;
   symbol[ 27] = 'b110110001001010101011011001000100001001010011011100010100;
   symbol[ 28] = 'b011110101101000010100010101010111010100011001001101010010;
   symbol[ 29] = 'b111110001000111111111010001000111000101000010010100010000;
   symbol[ 30] = 'b010011111010100001111100101111110011111000111011111111000;
   symbol[ 31] = 'b110110001010101110001111000000010001111101011111101110110;
   symbol[ 32] = 'b011010110110011100011001100110000010100110010100101011001;
   symbol[ 33] = 'b010011001001111110010010001000110011101111001100100011011;
   symbol[ 34] = 'b110100110000111011101101111001110001111101101101010001001;
   symbol[ 35] = 'b110010001001100101010001011111001100011010111011100010010;
   symbol[ 36] = 'b000111110110101001000101110010101111110001011011000111111;
   symbol[ 37] = 'b100001000010000010000100100000100110001010110000110111111;
   symbol[ 38] = 'b011010111111000000000111111011011111101000110010001101001;
   symbol[ 39] = 'b101101011111010101110000111010100011100111000110101101100;
   symbol[ 40] = 'b010101100000111000000010011010111001111100010111001000010;
   symbol[ 41] = 'b101010011000010111010010100000110010101110000001110010001;
   symbol[ 42] = 'b010010110001110000101000100101100011111110101101110011010;
   symbol[ 43] = 'b011101001011000000011110010101010010011000111100100001010;
   symbol[ 44] = 'b001010101000001110101111011001111011110001001011110000111;
   symbol[ 45] = 'b101011010100010100110010001010111010101001100101011000101;
   symbol[ 46] = 'b000000111110111000101111100000010110001011010010010000110;
   symbol[ 47] = 'b000000001001001101010000101111110001111111110111101101101;
   symbol[ 48] = 'b000000111111100110010100011111111010010111011001111110100;
   symbol[ 49] = 'b000000001000111110001110011000101000000101101001100011000;
   symbol[ 50] = 'b111111100101100011100100111010110101010111010010101010001;
   symbol[ 51] = 'b100000101110000101101101111000111101101010101100100011011;
   symbol[ 52] = 'b101110101011010100000111001111101111111000110111111111111;
   symbol[ 53] = 'b101110101100000101100101100011010100100101101101100100000;
   symbol[ 54] = 'b101110100100110010111001001010111111101100100110001101011;
   symbol[ 55] = 'b100000101010101100001100100000111110100100101000011011001;
   symbol[ 56] = 'b111111100110100101001010010101001101011111110011000000110;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
