   symbol[171] = 'b100000101000011110011011000110001111111000011111011101111000100110000110100000110111100010100110001000110100111010001001001101111000101101111000100001001011100001001010100011010;
   symbol[172] = 'b101110100010001100100110000011111110000101101000110010001111100001001010111001100110111111100001011000001100100011111001010101011001010101011111111001010001011001010001111111001;
   symbol[173] = 'b101110101010000101001000100100001110100001010011101110101110101010011011001110001001101000110001010110000010101011010111110011010111110011000101001010010101010010010101010011110;
   symbol[174] = 'b101110101101001110011100111011001001010111101011011000111110100110001100100100101001100101001100001101100001000001010010011000110010011000100110101011111110110011111110110010000;
   symbol[175] = 'b100000101010001011111101111110111010010100000110110000111001011011101011001001011011001111111001100000111000001001101010100000001010100000011110010011000110001011000110001010100;
   symbol[176] = 'b111111100001111111111111100011100101011010101101101010110110101010010001001010111100110111001110000100110110000011110100001110010100001110010010010101001010000101001010000100010;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
