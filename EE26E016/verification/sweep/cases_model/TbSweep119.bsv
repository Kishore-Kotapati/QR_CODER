   symbol[168] = 'b000000100111001001000001010011111011110100011011011101111111111100100110011000010010111111111000110010110010110111111010111011000011111011011111100101111100111011111100111110110;
   symbol[169] = 'b000000001101110000011010010010001101101011000110010011011000100001000000011101011111100010011110011011111100001110001000101100110001001111101000101100101110001100101110100010100;
   symbol[170] = 'b111111100000000000100111010110101111111111000001101100001010110000101010010010010000101010010110110101101010100110101010101000011011001010001010100010101000000010101000101010111;
   symbol[171] = 'b100000101000011010011111000010001111100000010111011101101000100110010110100000100011100010100010001000110100111010001001001001111000101111111000100001001011100001001010100011000;
   symbol[172] = 'b101110100110001100100110010011111110000101110000110010001111100000110010111011111010111111100001011000001010100011111001010101011001010101011111111001010001011001010001111111010;
   symbol[173] = 'b101110101110000101001100100101001110100000000011101010110000101010101001001100000111101000110001010110000010101010010111110111010111110011000101001010010101010010010111010011110;
   symbol[174] = 'b101110101011001110011100111011101001010110000010001000101111000110001101000100111101100101001110001101100011000000010010001110110010010000100110101011011111010011011000110010010;
   symbol[175] = 'b100000101010001011111101111111011010010111011111011010100101011011101111001001001111001111111001100000111000001000001010101110001010101000011110010010000111001011100000001010101;
   symbol[176] = 'b111111100111111111111111100011000101011100100101111010111101000010010001001010110100110111001110000100110110000100110101011110010100000110010010010101101011000101001000000100000;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
