   symbol[171] = 'b100000101110010001011101001010001001101110010001011011111000101101001001000110100001100010101111100111011010110110001111000011110110001011111000101111100101101111000001100011111;
   symbol[172] = 'b101110101101001001100010100111111010111001011100000110101111100011001111000100110010111111000011001100001000000111111101110011111101110001111111111101110101111101110011111111001;
   symbol[173] = 'b101110101001010101111001010101111011010000100010011001011111011110101010001111000000011001000111010110010011010010110110000000100110001010110000111001100100100011100100101000000;
   symbol[174] = 'b101110100110101101000101100000010110001100110000000111100100111010110110011111110010111110010011100110111010010010101001000111101111000011111001110110100111101000100101100111011;
   symbol[175] = 'b100000101010101010001110001111001111100101110111000111001000101000111011101000101010111110001000010001001001111000011011010111111101010001101011100010110101111010110111111111011;
   symbol[176] = 'b111111100010110000011111000111000011111110001001001110010011011000010101110110011000010011101010100000010010100111010000101010101010101010110100110101101000100000001110101010100;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
