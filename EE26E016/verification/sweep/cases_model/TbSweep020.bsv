package TbSweep020;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep020(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110101110111101111101001100110000000000001111111;
   symbol[  1] = 'b10000010111110010100010100100011101111110000001000001;
   symbol[  2] = 'b10111010101000001101101000111111110011001000001011101;
   symbol[  3] = 'b10111010000110000101100010001001100111000100001011101;
   symbol[  4] = 'b10111010100111001100010111111110111100001000001011101;
   symbol[  5] = 'b10000010011000000101000110001101001110100000001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000011001000011000010001100000000001110100000000;
   symbol[  8] = 'b10011111110101001001110111111111101010000110110010111;
   symbol[  9] = 'b00101100110111111011000010111011011100101100000010000;
   symbol[ 10] = 'b10010111001101010010111111111100010011000001100010111;
   symbol[ 11] = 'b11010100110010111111011100111110000000001110111011001;
   symbol[ 12] = 'b01000111100101100010001111111011101111011000011000101;
   symbol[ 13] = 'b00000001010010110111101110111101001001100011011011001;
   symbol[ 14] = 'b01011110011100001100111001000100010101010111010011110;
   symbol[ 15] = 'b00000101110011111000110000111100110100111101010100110;
   symbol[ 16] = 'b01101111011100101101111110100000100000001110111001010;
   symbol[ 17] = 'b00100101000100000001111000001111001001010011101011000;
   symbol[ 18] = 'b11000011000010111010100001111111111010011111100100000;
   symbol[ 19] = 'b01100101111011000101000000010010000010101110000001111;
   symbol[ 20] = 'b00001010101010010011011111001000001010110011111010010;
   symbol[ 21] = 'b00001101100110010000010001110110000111000010100011101;
   symbol[ 22] = 'b11111110101010011010000100010101001111111001000101101;
   symbol[ 23] = 'b11100100011110000011000100110000100111100110000100001;
   symbol[ 24] = 'b10101111111111101100101111111010011101110000111111100;
   symbol[ 25] = 'b01101000110101001011111110001011100000010100100011100;
   symbol[ 26] = 'b11011010100110110010111010101010011001001010101010000;
   symbol[ 27] = 'b10111000111100011010010010001011011011000010100011111;
   symbol[ 28] = 'b10001111111101110100101011111110111011101001111110001;
   symbol[ 29] = 'b10001000111010100110010011000000011011110010001111101;
   symbol[ 30] = 'b00111110000111000000110101110000001110010110001001011;
   symbol[ 31] = 'b10001100111001011100001010101100011111111011001000010;
   symbol[ 32] = 'b11101111001110011111101100101000101100101110110010111;
   symbol[ 33] = 'b10111000010111101110110111111001101000100111100100110;
   symbol[ 34] = 'b10101110100010100111111011101000111011111110010110011;
   symbol[ 35] = 'b01101100100111000100011010111101000100000111010011000;
   symbol[ 36] = 'b10001011100100001000100010101110101011100111110010111;
   symbol[ 37] = 'b01011001101000101001000100011001000011001101011011010;
   symbol[ 38] = 'b10100011101100001110000011111011100101101001010010100;
   symbol[ 39] = 'b10011100001010100010110111101001100010110011100010000;
   symbol[ 40] = 'b01101011000010100101100010100000100001111011001000000;
   symbol[ 41] = 'b01101101111101110010010011101111110110001111100001010;
   symbol[ 42] = 'b00000011110101011100110010100010000000100110000110011;
   symbol[ 43] = 'b00000001011000010001001101010111101100101101011010110;
   symbol[ 44] = 'b00000011000010111000000011111101111100011010111111110;
   symbol[ 45] = 'b00000000101100101111000110001010100011000000100010010;
   symbol[ 46] = 'b11111110110110101101100110101101000110011000101010011;
   symbol[ 47] = 'b10000010101101000000011110001001011011000010100010000;
   symbol[ 48] = 'b10111010100100001111111111111010001110010100111110000;
   symbol[ 49] = 'b10111010101001011100000001001111100111101101101110000;
   symbol[ 50] = 'b10111010001010010111001101010001100001011110011010111;
   symbol[ 51] = 'b10000010000000001101010110111010010000101010111100000;
   symbol[ 52] = 'b11111110100111010100011100110111110110110101000100010;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
