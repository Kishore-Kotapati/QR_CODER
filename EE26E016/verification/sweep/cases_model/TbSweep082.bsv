   symbol[ 49] = 'b1011100101011011101001111101001000110100001000000111000100110000101100110;
   symbol[ 50] = 'b0100101010100001011001010000111110100011010011010010000010101001110110010;
   symbol[ 51] = 'b0101110011100100000011011011101110101000111001101011000110111000111100100;
   symbol[ 52] = 'b0100101001010011001101100111000011001010011100111100010001011100010110110;
   symbol[ 53] = 'b1001110101011010111101001101101111100101101101100001000110001001010100100;
   symbol[ 54] = 'b0000101010101001100000110111110100001010110101001000000100010000010110101;
   symbol[ 55] = 'b1001010001101100110100111001010111001100011111111101010000010001011101000;
   symbol[ 56] = 'b1000011011100010001110000011111011001100011110100100001111000110110001101;
   symbol[ 57] = 'b1000000001111011110001101101010110100110001010011111011110010011110110000;
   symbol[ 58] = 'b0111101111111000100001011001111100101100110011001000001110001111110000000;
   symbol[ 59] = 'b0111110110011101110001100011010110101010010001111011001000011010111010110;
   symbol[ 60] = 'b1110101011011010000001100001111011101111001100110110001110111101110110000;
   symbol[ 61] = 'b0111110000000011010100010101010111100001010100000011010101001001110100000;
   symbol[ 62] = 'b0000001101011101111100010100111101001101100101010110011001011001101100101;
   symbol[ 63] = 'b0000000100001010100101111100111111000101111111111011011100011000110101100;
   symbol[ 64] = 'b0000001100010100011110101111100011101101011111111100001001011101111111001;
   symbol[ 65] = 'b0000000010011011001001101000101110010110001110001111011100001000100011010;
   symbol[ 66] = 'b1111111000110011111000111010111100110101010110101000101000011000101011101;
   symbol[ 67] = 'b1000001010101100100010101000101001111010010010001100111110011001100011010;
   symbol[ 68] = 'b1011101011011010001111111111110111101101010011111011100101011011111111101;
   symbol[ 69] = 'b1011101001000011011000100111101000110001000111000000100100001101100000110;
   symbol[ 70] = 'b1011101011011001100011111011101111111111111100110001110000011011111100001;
   symbol[ 71] = 'b1000001000000010100001101100010110101101011000001111100110011001001100110;
   symbol[ 72] = 'b1111111000111001000111110000111010000100001001010011111010011101000110111;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
