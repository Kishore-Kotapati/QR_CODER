   symbol[ 33] = 'b0101100101101010111111000010111000100111100100110001000010001001001010000;
   symbol[ 34] = 'b1111111100110001101011110010011100101010111100000000000000010000000001101;
   symbol[ 35] = 'b0010000111111010110000001101000101101001011101011001000100110101001001100;
   symbol[ 36] = 'b1001001011000110110010111011111101001010011111101100010001000010101011001;
   symbol[ 37] = 'b0100000101001010101011000111111011000101001010110001000100000110001001010;
   symbol[ 38] = 'b1101101110101001111110110101000001001011010000000000000000000010100010000;
   symbol[ 39] = 'b0000100111111100110110101001001011001001111110011101000100010010101100001;
   symbol[ 40] = 'b1001011011000010010010011010000000101010000001001011110001000010001100111;
   symbol[ 41] = 'b1001110011001010011101100001011000000101010111011110100100000100110110101;
   symbol[ 42] = 'b0101001000101000111111010111011101001010010111100010000000011111101110000;
