module mkTbSweep082(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b1111111010001010010001011000100100010000001001101111011101011100001111111;
   symbol[  1] = 'b1000001001000001110110010111100100101000001011001110011001011100001000001;
