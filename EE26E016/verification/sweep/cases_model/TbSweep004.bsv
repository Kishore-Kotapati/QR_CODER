package TbSweep004;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep004(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101011011111111001100010101000001111111;
   symbol[  1] = 'b100000101010111011001100111111111100001000001;
   symbol[  2] = 'b101110101001110001100110000011000100001011101;
   symbol[  3] = 'b101110101001000110110011000110011000001011101;
   symbol[  4] = 'b101110100010101110111111100100110000001011101;
   symbol[  5] = 'b100000101001011011011000111001100000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000000110001111000100010100111000000000;
   symbol[  8] = 'b110011100110111101011111101000000101000101111;
   symbol[  9] = 'b000011010001001000111110111101010000011100110;
   symbol[ 10] = 'b001011110001111011000100110111011011110110010;
   symbol[ 11] = 'b110110000110001110011001100110110110100111001;
   symbol[ 12] = 'b110110101111000100110001001110011101101001100;
   symbol[ 13] = 'b011001000110111001100110111011001000111101110;
   symbol[ 14] = 'b101101101001111011000100110001000010010010000;
   symbol[ 15] = 'b100110001101101110011001111111010001011110001;
   symbol[ 16] = 'b001111110001100000110001001111111011110111001;
   symbol[ 17] = 'b110101000100111111100001111010101110100011010;
   symbol[ 18] = 'b110100101101100100110011010000000110000001110;
   symbol[ 19] = 'b110101001100010001100110011011000001011010100;
   symbol[ 20] = 'b101111111100011001001111110111100010111110100;
   symbol[ 21] = 'b100010001000101110111000100100110110100010001;
   symbol[ 22] = 'b100110101101000101001010100010011110101011000;
   symbol[ 23] = 'b101110001000110001001000100010100110100010010;
   symbol[ 24] = 'b010011111100111100001111101000000100111111011;
   symbol[ 25] = 'b001110001001001000011100111101010001010000100;
   symbol[ 26] = 'b110111100001111011001110010111011010011010010;
   symbol[ 27] = 'b001010001110101110000011000110110111100111010;
   symbol[ 28] = 'b010010101110100100111001101110011101111101100;
   symbol[ 29] = 'b110110011111011001111100111011001001001001111;
   symbol[ 30] = 'b010010110111111011001001010001000010100010011;
   symbol[ 31] = 'b110110010100101110000100111111011001010110001;
   symbol[ 32] = 'b111011101001100100111110010111111010011000100;
   symbol[ 33] = 'b110101001100111001110001000010101110101111010;
   symbol[ 34] = 'b000000111010000100110001000000001111100101100;
   symbol[ 35] = 'b000000000101010001111100111011000001010000111;
   symbol[ 36] = 'b000000101111111001001111110001100010111110101;
   symbol[ 37] = 'b000000001100101110101000100100110111100010101;
   symbol[ 38] = 'b111111100010000100101010100110011111101010000;
   symbol[ 39] = 'b100000101011010001101000100010100111100011010;
   symbol[ 40] = 'b101110101110111101011111101000000000111110111;
   symbol[ 41] = 'b101110100101001000101110011101010000100000111;
   symbol[ 42] = 'b101110100111111011010110110111011000001000000;
   symbol[ 43] = 'b100000101010101110010110000110110111111101000;
   symbol[ 44] = 'b111111101110100100111100101110011101011111101;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
