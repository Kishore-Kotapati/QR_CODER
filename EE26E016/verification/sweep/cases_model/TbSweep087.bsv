   symbol[126] = 'b00000011110000001010110001111011101001000011001110100010001110111011101001100101111100010111011011110111011001100000000010000111110110010;
   symbol[127] = 'b00000001101001011100100000010111101010100000001101111110010010000111110101111110011111110100111000010011110000101111011110001111110101010;
   symbol[128] = 'b00000011100000101010001011111101001011101111001011111110101000111111101100001111111000010011111111010111111001010011100111110011111111010;
   symbol[129] = 'b00000000101111000100101010001011000101001001000100100011011100111011011100011000110000110010010000110010001000100010110100100011100010100;
   symbol[130] = 'b11111110111000000011101110101000100000001100100111101011000000010101000000001010110011011001110011011110101010101111101100101111101011000;
   symbol[131] = 'b10000010000101110001011010001101100111001011100000100011111000101101111000101000110100011110110100011010001011000011001011000010100010000;
   symbol[132] = 'b10111010000101101111001011111001101011001101101011111110001010011000001010011111111010110010111010110011111111110110101000110111111110101;
   symbol[133] = 'b10111010100110101100000101000110001010000100001100010100010101010000010110010011011101111011011000100010001001101010111110001010100100011;
   symbol[134] = 'b10111010010100101110110011001111001101100001001100001100101101111000101000010110011000110100011111100100110101000010000110100011101001001;
   symbol[135] = 'b10000010100010010101101000000001000011101111000000111101011110001001011001100100010110111010010000101011000001100111110001000111001111011;
   symbol[136] = 'b11111110101011000110000111100000100010000100100001000001000111010001000001100111110101111011110011101011101100111111101101011110001100100;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
