package TbSweep036;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep036(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101010000000101001111001001100010000111100001111111;
   symbol[  1] = 'b100000101111010010111100000111111100110010010100001000001;
   symbol[  2] = 'b101110101010000110010011100000000011101111001100001011101;
   symbol[  3] = 'b101110101111101111011010110110000001000101101000001011101;
   symbol[  4] = 'b101110101010000100111101001111111011101111000000001011101;
   symbol[  5] = 'b100000100001000111111001011000111001000101001100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001100001101000001011000111011010101000010100000000;
   symbol[  8] = 'b011010110011100011001111111111110001011101101001101011111;
   symbol[  9] = 'b011000001001111011010111011010010011110111000011010001010;
   symbol[ 10] = 'b110011101001001010100011010100000011011101101011111011110;
   symbol[ 11] = 'b110011010110011011000100101111101101001000100101001111011;
   symbol[ 12] = 'b010011110010010111100100011000111111000010001110100011110;
   symbol[ 13] = 'b011101010111111111100010111010101101101000100100101000100;
   symbol[ 14] = 'b111110101010111111100010001100000111001010101110001100001;
   symbol[ 15] = 'b010011011110001110100010010100100010010101010010110000100;
   symbol[ 16] = 'b011111100101101110101010011001010000111101110001111010101;
   symbol[ 17] = 'b110001001011111110110110111101000010010111011011010001010;
   symbol[ 18] = 'b111110101001011110100010010010110010111101110011111011110;
   symbol[ 19] = 'b000101010110001111000010001110100101001000100101001001011;
   symbol[ 20] = 'b010000110010001101100011111011010111000010001110100011110;
   symbol[ 21] = 'b001110010111111001100110111001000101101000100100101001001;
   symbol[ 22] = 'b001100101010110101100011101110110111001010101110001011111;
   symbol[ 23] = 'b010001011110011010100000110101011100010100110010110101010;
   symbol[ 24] = 'b001111100100110000100011111001011110111100010001111101101;
   symbol[ 25] = 'b100001001011101000111111111100001100010110111011010111010;
   symbol[ 26] = 'b111111111000000100111100111111110110111100110011111111110;
   symbol[ 27] = 'b000110001110001011001011111000111011001101000101100011111;
   symbol[ 28] = 'b010010101010010101100011101010111001000101101110101011010;
   symbol[ 29] = 'b001110001110001001101100111000101011101111000101100011010;
   symbol[ 30] = 'b001111111111110100101011111111100011001101101110111111110;
   symbol[ 31] = 'b010010010111000011100110101100111100010000110011100011011;
   symbol[ 32] = 'b000110101010000000000101111000011110111010010001110111110;
   symbol[ 33] = 'b100100001110000001101101110100001100010000111010111100100;
   symbol[ 34] = 'b110111111111100100101100111110110110111010110011010110001;
   symbol[ 35] = 'b001000010111001011100011111000111011001101000101010100100;
   symbol[ 36] = 'b010010100011110100001011111011111001000101101110010010101;
   symbol[ 37] = 'b001100001111101001111100101111001011101111000101011011010;
   symbol[ 38] = 'b000110100101010100101011101011000011001101101110010001110;
   symbol[ 39] = 'b010010000100100011100110111101011100001000110101010011011;
   symbol[ 40] = 'b110010100100100100000101011010011110100010010110001111110;
   symbol[ 41] = 'b011100001111000111100100110100001100001000111101010100100;
   symbol[ 42] = 'b000111100001100011111100111000110110101010110110101110001;
   symbol[ 43] = 'b010000000001101010010011010000100010010101010011110100100;
   symbol[ 44] = 'b110110110101110011001011010011101000111101110001110010101;
   symbol[ 45] = 'b010100001011101011011101111001011010010111011010111011010;
   symbol[ 46] = 'b000000111001011111101000111011010010111101110011010001110;
   symbol[ 47] = 'b000000011110111011100110010111000101001000100101010011011;
   symbol[ 48] = 'b000000101010110011000001001111101111000010001110111111110;
   symbol[ 49] = 'b000000001101010011100011101000100101101000100100100010100;
   symbol[ 50] = 'b111111101001111111111000101010101111001010101110101010001;
   symbol[ 51] = 'b100000100001111010010110011000100010010101010011100010100;
   symbol[ 52] = 'b101110101101110011001000001111101000111101110000111110101;
   symbol[ 53] = 'b101110100011110011011011011101100010010111011011010000110;
   symbol[ 54] = 'b101110101001000111101110011111101010111101110011011000001;
   symbol[ 55] = 'b100000101110110001100101001101010011001001000101110100100;
   symbol[ 56] = 'b111111100010111001000010001001010001000011101111011000101;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
