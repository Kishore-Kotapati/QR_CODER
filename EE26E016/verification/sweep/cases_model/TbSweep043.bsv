   symbol[136] = 'b0001111100101011001011010000100000011111110000011011010100110010011111001011100000011111001010011111001100111101000010111001000011000010111100000110000011011;
   symbol[137] = 'b0011010111000001111001110010010001100010010100011011110110101100100001101100101110101001111100101000111010100001011110100011010111111110111001010111010110001;
   symbol[138] = 'b1101001000100110110000100100001001001000011101110110111110110110111011101111011010111011101110111011001000110111010101110110000101100100011001001100100100011;
   symbol[139] = 'b0100100011110100111111010000011100011110010110101100001110100010000111001010011111111111101110001111001110010001100001010010001000000000101101110000101000011;
   symbol[140] = 'b0101111010001101111001100000010010101001000110100101100000011000101001111101001001010001011010110000011010001101100001111101001101010100000011110100110110101;
   symbol[141] = 'b0010100101001011101011100100011011111000000110001001100000010110111011101110011011001010101000100011001000110001000011101110111101001100110011001011000011001;
   symbol[142] = 'b1111011100010010010110000100110011111100111001010010011001101000011111001011010011011110001100000111001100110101100100101101011001100000110101100110000001100;
   symbol[143] = 'b1001110101011010001101100110101110100000100000011010111010011000101001111101000111111001111100101000011000000011000100011010001111010110000011010000011011010;
   symbol[144] = 'b1001011100011111101001110100011010110011010100101111110000001110100011101001001100011010001110111011101000011001110110011000100101100110011001100010100111100;
   symbol[145] = 'b1101100011100111001111000100111111011100100010101101000100001010010111001000011001001110101010011110101100010111111000010111100101111000010111110001100001111;
   symbol[146] = 'b0000001010100100100100110010110111001010001111100100101000111100110001111101001000100000111100101000011011100001001111000100010111010110000011001110110111001;
   symbol[147] = 'b0000000111011000011011110101011110110010110010001000101010001110110011101110111011001101001011110010101010110011011101010110101111000100010001011100001101011;
   symbol[148] = 'b0000001100111011001111010000111110010111110000010011111110101010011110001011111111100111001100110111111110011100011111001011111111000010111101010010111111011;
   symbol[149] = 'b0000000011011001111001110011100011001011010010011010100010011100101000111100100011010111011010011000100011000110101001011101100010011100100001011110100010011;
   symbol[150] = 'b1111111010110110110010100001101010111001111111110110101011001110111011001111101011100010001000110010101010010000100011001001101011000000010001000100101011100;
   symbol[151] = 'b1000001011101100111011010001100011110111010000101100100010101010011111001010100010011011001010011111100010110100000111101100100011001100110101100001100011000;
   symbol[152] = 'b1011101010001101111001100110111111100000100000100100111110011100101001111100111110101111111100101001111110001011110100001011111110101100001011110100111110110;
   symbol[153] = 'b1011101011001011101011100000110111111000000110001000111100101110111011101111001110111001101110111010111100110011001100110010101011001100110011001100110011001;
   symbol[154] = 'b1011101000010000010110000101101011111100111001010011000000001010011111001010001010011111001010011110011000110011100001010010101101100000111101100000111100111;
   symbol[155] = 'b1000001001011110001101100111011010100000100000011010010010011100101001111101101001000101011100101000101110000101000111111100011011010110001011010110001010001;
   symbol[156] = 'b1111111010001011101011110101001010110011010100110111011100001110111011101111011001000000101110111010111110001111010011101110001001100110000001100110011001111;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
