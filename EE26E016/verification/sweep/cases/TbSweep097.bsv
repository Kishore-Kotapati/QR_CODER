   symbol[ 61] = 'b0011110101011100101010010011100101101010100111100010011001010011100111110;
   symbol[ 62] = 'b1101011110101001011011111001101011000111011000000001111000110000011011100;
   symbol[ 63] = 'b0001100010111001001011100000010001100010011001000011101111110111000011011;
   symbol[ 64] = 'b1000101111111101111110111111111001011011111011111001010010000110111111010;
   symbol[ 65] = 'b0000000011010010011101001000110010111011010010001010110001100100100010100;
   symbol[ 66] = 'b1111111000011011001001001010111001110101101010101001100100100010101010010;
   symbol[ 67] = 'b1000001001001101101111011000110101001001011010001001010001010011100010011;
   symbol[ 68] = 'b1011101001110011001000011111101111110111001011111001111010110000111110100;
   symbol[ 69] = 'b1011101011111000001111011100000000110110000101000110111101110110010001010;
   symbol[ 70] = 'b1011101000011011101101100110011101001001101100011111001110000110011001001;
   symbol[ 71] = 'b1000001000101011011001100100000011111000010111101001111100100100000111010;
   symbol[ 72] = 'b1111111001011111011010001001111101111111001010111101110111000010111111101;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
