   symbol[ 39] = 'b1101010110001000110001010101001100100001011111001011111111111101010101011;
   symbol[ 40] = 'b1100001110101100110111000111011001111000011110011001001010011111011001010;
   symbol[ 41] = 'b1101100101110011111001001101000001111000010101110010101001111101000101000;
