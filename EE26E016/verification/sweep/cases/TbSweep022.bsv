   symbol[ 66] = 'b1111111011000000010010011010100010101110110010101010111111111001101011001;
   symbol[ 67] = 'b1000001011001101101111011000110101001001011010001001010001010011100010011;
   symbol[ 68] = 'b1011101011000101111110101111111001010001111111111111001100000110111110010;
   symbol[ 69] = 'b1011101000100011010100000111011011101101011110011101100110101101001110001;
   symbol[ 70] = 'b1011101001100100010010011001100010111110010011110000110001111001100100110;
   symbol[ 71] = 'b1000001000011101101111010010110101001110100001011111001010010010110011110;
   symbol[ 72] = 'b1111111001111011111110101101011001011011101110011001010011100110011111011;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
