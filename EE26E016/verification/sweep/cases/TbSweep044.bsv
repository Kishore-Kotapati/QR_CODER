   symbol[167] = 'b000100010011000010100100110111110011011101001011111001100111110010100010000110010010011010110000101001110001000100010011101001000011101001001101111010001111010010001110010111110;
   symbol[168] = 'b010101101100010010001010001011111000110111000000000111011111100111111100100011010001111110100011101001011011101011111001100011111000100011101111111000100111111000100111111111111;
   symbol[169] = 'b000000001100111111001011011110001100110010011111111010001000101000001001110100011010100011010111000011110001000110001001100001011000000001001000100101100111000101100111100011110;
   symbol[170] = 'b111111100011101101011010110010101010001010100100000001101010111101010111111111110011101010011011010001111011101010101111000011110110100011101010101111000101101111000101101011011;
   symbol[171] = 'b100000100100111010100111100010001011011100111011111001011000100010100010000100010011100010000010101100010000011110001101101001011100001001011000100101101111000101101110100011110;
   symbol[172] = 'b101110100100111010010000110111111000110011011110000100111111110111111100001111010000111111010111101110111010010111111111100011101111100011101111101111100111101111100111111111111;
   symbol[173] = 'b101110100000010111011010110110011100110011000001111100111100111000001001011100011011111010100011000100010000111001000101100001000101100001010111011000000111000000000111000001100;
   symbol[174] = 'b101110101110010101000111100000010010001100110000000011100101111101010111111111110010111110010111010110111010011010001001000011101001000011111101110000100101101000100101101001011;
   symbol[175] = 'b100000101011000010110100110111110011011101001111111001110000010010100010000000010010000110110000101001110001000000100011101001000011101001010111011010001111000010001111000011101;
   symbol[176] = 'b111111100100010010010010001110001000110111000000000111011011000111111100100111010001011010100011101001011011101110011001100011111001100011111111111000100111101000100111101001111;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
