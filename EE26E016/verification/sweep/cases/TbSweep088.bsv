   symbol[136] = 'b0010001110001101000100000110111010000101100011100001111101111100101001111101001110101001111100101001110010000011010110000110110111010110000010010010110111010;
   symbol[137] = 'b1100100101111011110101010000110110011001111010101000110110011111001010011110000101001010011111001011011001100000110101100000110100110101100000110100110100100;
   symbol[138] = 'b1001001010011000100101101010111010100010001000111110100011101111010000101110010001010000101111010001000000111110010100111111001100001101011000001101101100010;
   symbol[139] = 'b0011010110110110101001011010100110000110000100001111001000101011110100001011111100000101001111100100101110110000011010110000100010000011010110000010000010011;
   symbol[140] = 'b0110001000111011110010110000001110110011010101010111001011001010011111001011111111100110101100000110100101010011111101000011111001100000110101100000000111111;
   symbol[141] = 'b0010100000010110011000111101011001110100010111000101011011010010100111110011101111011110010100111111010101001001001111010000100001011000001101011111011001011;
   symbol[142] = 'b0000101001000011111110110001100111100001010011100101111111010100001011110101001111010010010010010010111010000011010000011011101111010110000011010000110001010;
   symbol[143] = 'b0110000000000000011111101100010010101000110010111001111100011101000010111101001101000010111101000011111001100000110011111000100100110101100000110010110100110;
   symbol[144] = 'b1001011101010110011111011101100001011110111000111010100110100111110010100110010101110010100111110010101001011000001101011001101100001101011000001001101100001;
   symbol[145] = 'b1010010011001101000011100110000010101111001100011110000000101001111100101000110011111100101001111101101111010110000011010110000010000011010110000010000010010;
   symbol[146] = 'b1101101111110101001000000111010011010111100101010011001110000010111101000011111100111101000010111100101101010011111001010010100001100000110101100000000001111;
   symbol[147] = 'b1111100101101101110010000001111011000101011111010100010011110000101111010000100111011000010100101111110101101011000001101011111001011000001101011001011001000;
   symbol[148] = 'b1010011110001101000100000110111110000101100011100001111111111100101001111101111111010110011010101000111111100100001011110101111111010110000011010110111111001;
   symbol[149] = 'b0000000011111011110101010001100010011001111010101001100010111111001010011110100010110101111001001010100010100101000010111100100010110101100000110101100010110;
   symbol[150] = 'b1111111010011000100101101011101010111010001000111111101010001111010000101111101010001101001001010001101011011001101011000000101010001101011000001101101010001;
   symbol[151] = 'b1000001010110110101001011010100010011110000100001110100010101011110100001011100011110100001011110100100011010111100101001111100010000011010110000010100010000;
   symbol[152] = 'b1011101000111011110010110001111110110011010101010111111111001010011111001011111110011111001010011110111110110101100000110101111111100000110101100000111111100;
   symbol[153] = 'b1011101010010110011000111100000001110100010111000100100111110010100111110011110010100111110010100110101000001101011000001100010101011000001101011000001101001;
   symbol[154] = 'b1011101011000011111110110001000011100001010011100100100000110100001011110101110100001011110100001010101110000101001111100100011011010110000011010110000011010;
   symbol[155] = 'b1000001000000000011111101101110010101000110010111001101000011101000010111100111000110101100101000011001101100110101100000111111000110101100000110101100000100;
   symbol[156] = 'b1111111011010110011111011101111011011110111000111011110000100111110010100110100000001101011111110011010101001111010000101111001000001101011000001101011000011;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
