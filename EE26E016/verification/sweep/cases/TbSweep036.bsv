package TbSweep036;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep036(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101010000100110101001001111011101111000011001111111;
   symbol[  1] = 'b100000101110100110000001000011111001000101001001001000001;
   symbol[  2] = 'b101110101100010011111110100100000100110010111011001011101;
   symbol[  3] = 'b101110101110011110110001101101001110111010010101001011101;
   symbol[  4] = 'b101110101010000000101001111111101100010000111001001011101;
   symbol[  5] = 'b100000100110110010111100001000111100110010010010001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001000011000000100011000111100001000110101000000000;
   symbol[  8] = 'b011010110110010110100100011111111110100010010110101011111;
   symbol[  9] = 'b000110010011111000000011011000100100001000111100101110100;
   symbol[ 10] = 'b110010101010111001100111001010000110101010110110001100001;
   symbol[ 11] = 'b110000011110001010100001010011110010010101010110110110100;
   symbol[ 12] = 'b101111100101100010101111111011100000111101110011111010101;
   symbol[ 13] = 'b000001001011111100110110111000010010010111011111010001010;
   symbol[ 14] = 'b001100101001010100100010010010011010111101110101111001110;
   symbol[ 15] = 'b110100010110010101000101001110111101001000100101001101011;
   symbol[ 16] = 'b010011110010011011100111111011110111000010001110100101110;
   symbol[ 17] = 'b111101010111101101100000111001101101101000100100101110100;
   symbol[ 18] = 'b001100101010110101100010001111011111001010101110001100001;
   symbol[ 19] = 'b010010011110010100100101010100111010010101010010110100100;
   symbol[ 20] = 'b001110100101111000101111111001110000111101110001111100101;
   symbol[ 21] = 'b100001001011101000110001111101101010010111011011010110101;
   symbol[ 22] = 'b111101101001000100100010110011011010111101110011111100010;
   symbol[ 23] = 'b000101010110010011000011101110011011001001000101001000110;
   symbol[ 24] = 'b010011110011111101110101111011011001000011101110100010101;
   symbol[ 25] = 'b001100010110001001110010100000101011101001000100101001100;
   symbol[ 26] = 'b001111111010110101100011101111100011001011101110111110001;
   symbol[ 27] = 'b010010001111100010111110111000111100010000110010100011100;
   symbol[ 28] = 'b001110101101100000100101111010111110111010010001101011001;
   symbol[ 29] = 'b100010001011100000100101101000101100010000111010100010100;
   symbol[ 30] = 'b111111111010100101101100101111110110111010110011111110001;
   symbol[ 31] = 'b000100010001101010010011111000111011001101000101010100100;
   symbol[ 32] = 'b011110110111110100000011100011111001000101101111001010101;
   symbol[ 33] = 'b000000011001101001000100100111001011101111000101100011010;
   symbol[ 34] = 'b000110100010110101101011100011000011001101101110101001110;
   symbol[ 35] = 'b011010001001100010010110101101011100010000110011100011011;
   symbol[ 36] = 'b000010111110100000000101100000011110111010010001101111110;
   symbol[ 37] = 'b101000011001000001000101101100001100010000111010100100100;
   symbol[ 38] = 'b000011100101100101111100101110110110111010110011101110001;
   symbol[ 39] = 'b000000001011101011110011111000111011010101000011100100100;
   symbol[ 40] = 'b000010111001110101101010010011111001011101101001111010101;
   symbol[ 41] = 'b001000011111101001111101011101001011110111000010101011010;
   symbol[ 42] = 'b000010100001010101101011111111000011011101101011011001110;
   symbol[ 43] = 'b000010001110100111100110010001011101001000100111001011011;
   symbol[ 44] = 'b001110101010100001000101011010001111000010001010001111110;
   symbol[ 45] = 'b000000010101000101100100010000011101101000100101000100100;
   symbol[ 46] = 'b101001100001111011111111111000111111001010101010101110001;
   symbol[ 47] = 'b111110011001111000010010010100110010010101010011100100100;
   symbol[ 48] = 'b000000110101101001001011011111110000111101110001111110101;
   symbol[ 49] = 'b000000001011110101011110001000111010010111011011100011010;
   symbol[ 50] = 'b111111101001011011101111111010110010111101110011101011110;
   symbol[ 51] = 'b100000100110111001100010011000110101001000100100100011011;
   symbol[ 52] = 'b101110101010101001000010001111110111000010001111111111110;
   symbol[ 53] = 'b101110100101010011100111011100011101101000100100001001010;
   symbol[ 54] = 'b101110101001110001111011001110110111001010101110100101101;
   symbol[ 55] = 'b100000101001101000010110011110100100010100110010001111000;
   symbol[ 56] = 'b111111100100000011011100001010101110111100010000101101101;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
