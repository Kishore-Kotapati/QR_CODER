package TbSweep006;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep006(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101100001110100111110011000010011110110011001111111;
   symbol[  1] = 'b100000100110100011001101110010001101000011100101001000001;
   symbol[  2] = 'b101110100100001000011101101110001101100001000011001011101;
   symbol[  3] = 'b101110100110011110101011000111110000110100011001001011101;
   symbol[  4] = 'b101110101100001010110011001111110101100001001101001011101;
   symbol[  5] = 'b100000101110110111001000101000101000110100111110001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000011111100010000101000101010100100110011000000000;
   symbol[  8] = 'b011111110011101101000001011111111111010011100111100110001;
   symbol[  9] = 'b101001011100001110000111001011100010000110110010100000100;
   symbol[ 10] = 'b111101100111000010101101011010001101010011100101110101111;
   symbol[ 11] = 'b000010000111101100110100111110011100111001010100111000101;
   symbol[ 12] = 'b011101111100011001101010010110110001001100000100101111111;
   symbol[ 13] = 'b101100000110001110010011001011011100011001010101011101010;
   symbol[ 14] = 'b000000100100110001101100000010001001000100100100000100000;
   symbol[ 15] = 'b100010001111111111010011100101010011100100100011000001010;
   symbol[ 16] = 'b000001101011100000100100010111011110110011111111110100100;
   symbol[ 17] = 'b000000011010001111000111001100110011100110101010100000100;
   symbol[ 18] = 'b110000100111010000101100011100111100110011111101110101111;
   symbol[ 19] = 'b110110000111111110110011111111010100111001010100111000101;
   symbol[ 20] = 'b011111111100000011101101110101011001001100000000101101111;
   symbol[ 21] = 'b111100000110001000010111001000110100011001010101011000100;
   symbol[ 22] = 'b000001100100110011101011100000111001000100100000000101111;
   symbol[ 23] = 'b100000001111101011010101000100001101100101000011000100100;
   symbol[ 24] = 'b000001101011010110111001110111110000110010011111110011100;
   symbol[ 25] = 'b010000011011010001001010001100011101100111001010100110100;
   symbol[ 26] = 'b110011111111101010101010111111111000110010111101111110111;
   symbol[ 27] = 'b110110001110111010110010001000101010111100110100100011001;
   symbol[ 28] = 'b011110101100011011101101101010110111001011100000101011011;
   symbol[ 29] = 'b111110001111111000011101001000111010011110110100100010100;
   symbol[ 30] = 'b000011111001111010100101111111101101000011100000111111111;
   symbol[ 31] = 'b100011000110110010010111011101001101100001000011110010101;
   symbol[ 32] = 'b000000110100001110001011110110010000110100011111111001111;
   symbol[ 33] = 'b011001010111110000011100000101111101100001001010001101010;
   symbol[ 34] = 'b110001100001101010100010110000111000110100111101011000000;
   symbol[ 35] = 'b111001010110111010010010001001001010111100110100100101010;
   symbol[ 36] = 'b011100101101111010000101101101110111001011100000011100100;
   symbol[ 37] = 'b111101011110011000001101011110111010011110110100101010100;
   symbol[ 38] = 'b001000101001011011000101100101001101000011100000011111111;
   symbol[ 39] = 'b100011010001010010010111000100101101111001000100100010101;
   symbol[ 40] = 'b111100101010101011001010010000010000101100011000011001111;
   symbol[ 41] = 'b101101011000110101110101100011111101111001001100101101010;
   symbol[ 42] = 'b001001101111101011110011010000111000100100111000110000000;
   symbol[ 43] = 'b100001010000011011100010100011001011100100100010010101010;
   symbol[ 44] = 'b111000111011111101000101011101100110110011111111111100100;
   symbol[ 45] = 'b100101011010011010101100001000101011100110101011001010100;
   symbol[ 46] = 'b101001110111010001100110110101011100110011111101011111111;
   symbol[ 47] = 'b111110001111001010010111100110110100111001010100100010101;
   symbol[ 48] = 'b000000100100111101001111001111100001001100000000111111111;
   symbol[ 49] = 'b000000001100100010010010011000110100011001010101100011010;
   symbol[ 50] = 'b111111101111110001110110101010100001000100100000101010000;
   symbol[ 51] = 'b100000101000001011100111101000110011100100100010100011010;
   symbol[ 52] = 'b101110101011111101000110001111100110110011111110111110100;
   symbol[ 53] = 'b101110101010000010101010101100010011100110101010100111000;
   symbol[ 54] = 'b101110101111010001100110010001100100110011111101010100000;
   symbol[ 55] = 'b100000101111010000010010111100100010111000110100000001010;
   symbol[ 56] = 'b111111100101001111011110000111011111001101100001010100100;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
