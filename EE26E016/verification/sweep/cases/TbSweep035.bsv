package TbSweep035;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep035(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110010100011110011011000110001001100010001111111;
   symbol[  1] = 'b10000010100101111111111111010000100011100011001000001;
   symbol[  2] = 'b10111010110100011111000000010101000011010001001011101;
   symbol[  3] = 'b10111010111001011110111011001000101110111110101011101;
   symbol[  4] = 'b10111010011010010010010111111011100100010110001011101;
   symbol[  5] = 'b10000010011101011101011010001101011111101110001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000110011010100101010001011111001011000000000000;
   symbol[  8] = 'b10000010110001100011100111111010001010100100111001110;
   symbol[  9] = 'b11101001001001000011110100000110011110111110101101010;
   symbol[ 10] = 'b00101011111101011010100010110000101100110011111100110;
   symbol[ 11] = 'b10100100001000010100111110001100011001100101111101010;
   symbol[ 12] = 'b10101110111001101110111100000100100011101000001010101;
   symbol[ 13] = 'b10110001001111001101111100101111010101011110010100111;
   symbol[ 14] = 'b10000010110110001000100010000000011001111100111111110;
   symbol[ 15] = 'b01111000001101011100001111101011000000011100110101111;
   symbol[ 16] = 'b00001011101111000000000000100011001011010010100011010;
   symbol[ 17] = 'b10110101010010101101001101101111010111010110000111011;
   symbol[ 18] = 'b10000111111111110000111000101001001011001101111100101;
   symbol[ 19] = 'b01001001011111111100001111011011111100001011110001001;
   symbol[ 20] = 'b01101111111010110110100111011100010111100111111110110;
   symbol[ 21] = 'b10101001111111011011111100111111011101101111111011010;
   symbol[ 22] = 'b10100110001101101110100001100100001010011010010001110;
   symbol[ 23] = 'b01010100001001000111101011000101101000101100110010010;
   symbol[ 24] = 'b00101111101011001001101111111110111110001000111110001;
   symbol[ 25] = 'b01111000110100100101100110001111000100011010100010001;
   symbol[ 26] = 'b10101010110100011001011010101001101010100110101010010;
   symbol[ 27] = 'b11111000100001111111011110001100010001000100100011111;
   symbol[ 28] = 'b00001111110001100001010011111010011010010000111111010;
   symbol[ 29] = 'b10000000001111111001101000111111110001011110111111011;
   symbol[ 30] = 'b11000011000000111111110100110100000011010111101000101;
   symbol[ 31] = 'b00100100000001110100100110100011000100100100110101000;
   symbol[ 32] = 'b10110010010011011111000010000011000110000000100011000;
   symbol[ 33] = 'b10101000101010000000011100000110011101100110111011011;
   symbol[ 34] = 'b10001010100111010100101001100100011110101010000101000;
   symbol[ 35] = 'b01110101100100001111111111110000101011111000110011000;
   symbol[ 36] = 'b01000011100000110000101111110010111011111001101101010;
   symbol[ 37] = 'b00111000110110010101000000110011110111000111101010111;
   symbol[ 38] = 'b10101110111110110101100010110100111110010011010110100;
   symbol[ 39] = 'b00001001011111100100001110011001011000011011010001101;
   symbol[ 40] = 'b01101110000100101001010001010101000011110010101100010;
   symbol[ 41] = 'b10011101111001101010110101001010010101000010101111000;
   symbol[ 42] = 'b11011110011100111000010101000001100000101001101100101;
   symbol[ 43] = 'b01100001101111000000100001100011100111010110111000001;
   symbol[ 44] = 'b00010011111101101100100111111011000110000010111111011;
   symbol[ 45] = 'b00000000111110001010100110001110011101111110100011110;
   symbol[ 46] = 'b11111110000101000001011110101101100000110111101011110;
   symbol[ 47] = 'b10000010011000101100010110001001101001101011100011011;
   symbol[ 48] = 'b10111010000001111010111111111111111011011001111110011;
   symbol[ 49] = 'b10111010010010101101000101010011110000011010011111111;
   symbol[ 50] = 'b10111010010111101111010001110000101110111001000111111;
   symbol[ 51] = 'b10000010001011011100010100000111011101111101001111101;
   symbol[ 52] = 'b11111110100100011010100110110111001111100011000011100;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
