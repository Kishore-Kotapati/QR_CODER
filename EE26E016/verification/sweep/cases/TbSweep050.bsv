package TbSweep050;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep050(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110100010100111111000011100110001001110001111111;
   symbol[  1] = 'b10000010010110101110110011010100100000101011001000001;
   symbol[  2] = 'b10111010001111000101010010001101111101100001001011101;
   symbol[  3] = 'b10111010100110110110011000001111000111011010101011101;
   symbol[  4] = 'b10111010101110100110100111111000111000001010001011101;
   symbol[  5] = 'b10000010111110011010110110001011011111100010001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000110001000010101010001101100001100101000000000;
   symbol[  8] = 'b10001011101110111011010011111111001000001111011111001;
   symbol[  9] = 'b11100001010111100101101011010110110010110111100100110;
   symbol[ 10] = 'b11100110000100001111101010010110101101111001110010100;
   symbol[ 11] = 'b11100000111010001011010011111111111000111111001110000;
   symbol[ 12] = 'b10000110010010110000000100110101010110000111001000001;
   symbol[ 13] = 'b00111101010110110001011101000010111110110111101010011;
   symbol[ 14] = 'b01000011010011100001100100011010111101011100001001111;
   symbol[ 15] = 'b01011101011001111101111001100110101101110111011101101;
   symbol[ 16] = 'b01100011100110110001100000111000001000000100100001110;
   symbol[ 17] = 'b10100001111100011001001000111010000101011110010010100;
   symbol[ 18] = 'b01111110011001111001110011011001010111111001010100010;
   symbol[ 19] = 'b01011101001000101001000100101000010000101100011100110;
   symbol[ 20] = 'b00110011000110111010111110011100011001110111011000010;
   symbol[ 21] = 'b00111101101111001101111111111011011000110110100001010;
   symbol[ 22] = 'b01111111100000010110101001111010000110001100001101001;
   symbol[ 23] = 'b01001101100111000000000100000100010110011101010111000;
   symbol[ 24] = 'b00111111110001101100110111111010011011101000111110000;
   symbol[ 25] = 'b01011000110110100111000010001010110001110011100011001;
   symbol[ 26] = 'b11001010111110100010101010101110101100011101101011100;
   symbol[ 27] = 'b00111000110100011101010010001001111011001011100011110;
   symbol[ 28] = 'b10011111101000101110000111111110000011100000111111111;
   symbol[ 29] = 'b10011101000111110000011010011101011110011001011011011;
   symbol[ 30] = 'b00000011111110100010000011111000011011010101001011001;
   symbol[ 31] = 'b00011000011001000011011111101001101101111110001110000;
   symbol[ 32] = 'b01110111111101001001010010110000011010110111111110100;
   symbol[ 33] = 'b01011100110100111001011011100000010101000011000100001;
   symbol[ 34] = 'b11100110001000101101000001011011011011001111111100001;
   symbol[ 35] = 'b10101101000110110101100011100111010010010000001010111;
   symbol[ 36] = 'b11001110111011011001110011011010101010101100000001100;
   symbol[ 37] = 'b11110100111111010110111011011101111100101111100010100;
   symbol[ 38] = 'b11000011001010111100010101010101100010000111100000101;
   symbol[ 39] = 'b01111001000000010100101001011101101100101001000000101;
   symbol[ 40] = 'b00001010110001110000010000011110011000010101010001101;
   symbol[ 41] = 'b00011101001110000010001011000111001001011101100110010;
   symbol[ 42] = 'b11011110100010111100101100011010111000011000001001011;
   symbol[ 43] = 'b01100000011101111110001000011010011110000011011111111;
   symbol[ 44] = 'b00010010111011111100101011111101100110010011111110100;
   symbol[ 45] = 'b00000000101011110101101010001101100011111000100010011;
   symbol[ 46] = 'b11111110110011001110000110101001110011001001101011101;
   symbol[ 47] = 'b10000010000111101011011010001100111110101010100010111;
   symbol[ 48] = 'b10111010100101001000011011111001111110011111111111101;
   symbol[ 49] = 'b10111010010101001001000101001000101011111101101111100;
   symbol[ 50] = 'b10111010010001001011000100000111011110110101001011110;
   symbol[ 51] = 'b10000010001110111011110011011111000000001110000000110;
   symbol[ 52] = 'b11111110111110011101001100100010010000101001011010100;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
