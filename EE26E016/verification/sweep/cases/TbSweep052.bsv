   symbol[ 34] = 'b1101001111001111101000010011111111001000111101000011100011101010100001101;
   symbol[ 35] = 'b1101100011100111101100010001010001010101000001100101011000011000011100111;
   symbol[ 36] = 'b1011101000100011110001011000011111101001111100001111110010100000101001001;
   symbol[ 37] = 'b1010110001010110010111011011001110111001011000101101011000000010010100111;
   symbol[ 38] = 'b1110111111001011111101010111110011001000111111100011100011110001000001101;
   symbol[ 39] = 'b1100010011100001101000110100110111010101000001000001011000010010110100111;
   symbol[ 40] = 'b1010111000100000010001111001100010101001111010001001110010100011101001001;
   symbol[ 41] = 'b0101000001010111100011111100100100111001010110101011011000000010110100111;
   symbol[ 42] = 'b0111101111001010101000110101111111001000110111100001100011101110000001101;
