   symbol[ 50] = 'b0111011001000010101010110011010111001000010000101001100001101010010101101;
   symbol[ 51] = 'b1001100101111000110101000111111010110100100101100111011100000100100000111;
   symbol[ 52] = 'b1111001000100001110100000100100000101001011111000111110000111110110101001;
   symbol[ 53] = 'b0001100101000111110101010001110011111000110000000101011110010101001000111;
   symbol[ 54] = 'b1011001101011010111011010100011111101000010110101011100011110011110101101;
   symbol[ 55] = 'b1001100001110000111100100101001011010001100011100001001100001101000000111;
   symbol[ 56] = 'b1011001100000000001101100000011000101110111101010001101000100111010101001;
   symbol[ 57] = 'b0101100111100111100101110001001010111010010110010011000110001101101001011;
   symbol[ 58] = 'b0111001011011010110010110010011111001110110000110001101001101010010100001;
   symbol[ 59] = 'b1001100100100000111100100111001011011110000101111111010010000100100001011;
   symbol[ 60] = 'b1111001100111001101101000110011000001100111111011111110100111110010110001;
   symbol[ 61] = 'b1001100101011111000101010111001011101101010000010101011110010101101000101;
   symbol[ 62] = 'b1101011011111010010010010000011110010110010110101011100111111010010001101;
   symbol[ 63] = 'b0001100101110000111100100101001010011001100011101001001000000100100110101;
   symbol[ 64] = 'b1000101010000001101100001111111001111110111111111001101010111110111111001;
   symbol[ 65] = 'b0000000011100111000100111000101010001010010010001011000000010101100011011;
   symbol[ 66] = 'b1111111001011010010011011010111111011110110110101001101001111011101010011;
   symbol[ 67] = 'b1000001000100000111101111000101011011110000110001110110010000100100011001;
   symbol[ 68] = 'b1011101010111001101101011111111000010100111011111111010100111110111110011;
   symbol[ 69] = 'b1011101011011111000101101110001010010101010011001101011110010101110100101;
   symbol[ 70] = 'b1011101011111010010010000001011111010110010110010011000111111010101101101;
   symbol[ 71] = 'b1000001001110100111101101000001010110001110100101000111001000101010100101;
   symbol[ 72] = 'b1111111000000011101100010101011001100110111001100001111011011110100101011;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
