module mkTbSweep052(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b1111111011101001110010101011000111101011101010001100111111101010101111111;
   symbol[  1] = 'b1000001011011101101010000011111000100100011100010010000111000010001000001;
