package TbSweep095;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep095(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110000011001111100111111111011101110110001111111;
   symbol[  1] = 'b10000010101011100000001011100011011100101111001000001;
   symbol[  2] = 'b10111010010010001010000111110000001100101001001011101;
   symbol[  3] = 'b10111010001111110011000010100110010101000010101011101;
   symbol[  4] = 'b10111010110011010000000111111110111101110010001011101;
   symbol[  5] = 'b10000010001101010111011110001110001111111110001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000010101111011001110001011000100000000100000000;
   symbol[  8] = 'b10101010001011100100111011111000110110011101000010010;
   symbol[  9] = 'b00000100010101011101011000111000100011000001000111101;
   symbol[ 10] = 'b01100111111000101001101010011001100011011100100101011;
   symbol[ 11] = 'b11010100110111000001110000011100100011101001100010011;
   symbol[ 12] = 'b11110110111111010100111100111111100111101100010111111;
   symbol[ 13] = 'b10100000111110001110110000101000100101010101000010110;
   symbol[ 14] = 'b10101111100101001111100101101111000000001001000100111;
   symbol[ 15] = 'b10101000001101100000101101011111101011110001010001010;
   symbol[ 16] = 'b00011111111110110101111111111111111111111000001110000;
   symbol[ 17] = 'b11100101101001110110101011101001010100000100000010101;
   symbol[ 18] = 'b01001111100111100011101010101001100010101100010100011;
   symbol[ 19] = 'b11101000011010111011101000010001001011010100110000000;
   symbol[ 20] = 'b00001010010111010011011010010010101111101101110010001;
   symbol[ 21] = 'b10101100101111100100000100101000100110001000000000110;
   symbol[ 22] = 'b11100110101100001100111100111110100010011101000000101;
   symbol[ 23] = 'b11101100100111000111011000011001110111110000101110001;
   symbol[ 24] = 'b11101111101110001011101011111000111110011100111110010;
   symbol[ 25] = 'b00001000100110110110001110001001010100000101100010111;
   symbol[ 26] = 'b01001010110110001110000010101000100110101101101011111;
   symbol[ 27] = 'b01001000101111111110001110001000010110101111100010000;
   symbol[ 28] = 'b11011111100010111001101111111011110110111010111111110;
   symbol[ 29] = 'b01000101011010111100111111110100010000000000111001101;
   symbol[ 30] = 'b11010010110011100100000011000101010101111111011011001;
   symbol[ 31] = 'b01110101000101100001111001100110111100101000100010010;
   symbol[ 32] = 'b11000010000010011111001001111110110010111010010101011;
   symbol[ 33] = 'b01010100110101111100001001101000010110001001000100101;
   symbol[ 34] = 'b11100110011010011101000001100110100000111100011010011;
   symbol[ 35] = 'b01111001011000110110010101010011110011001100111001000;
   symbol[ 36] = 'b01101111110110111011001101110110111110011110100001010;
   symbol[ 37] = 'b00101000111010011110011000101101010010001100111000111;
   symbol[ 38] = 'b00110010011100010110110011110100000010010110011011001;
   symbol[ 39] = 'b10110000111000010011100110110101100111111100101000010;
   symbol[ 40] = 'b01001111111000111101011110111110100110111100111001110;
   symbol[ 41] = 'b00111000101011001101111110001000110101001001001000010;
   symbol[ 42] = 'b11011111001101110101001010100001111000101011011001111;
   symbol[ 43] = 'b01100000101010011110111010010100010010000110110010001;
   symbol[ 44] = 'b00010011000001010110001111111100101111101100111111011;
   symbol[ 45] = 'b00000000101001101001010010001001000101011000100010001;
   symbol[ 46] = 'b11111110010010010100011110101101011010101000101010111;
   symbol[ 47] = 'b10000010001000010010000110001011011100110111100011001;
   symbol[ 48] = 'b10111010100100101010001011111110100110111000111110010;
   symbol[ 49] = 'b10111010000110000011110110001000000011011000000010001;
   symbol[ 50] = 'b10111010110010111000101100011011010111000001100010100;
   symbol[ 51] = 'b10000010001100000010001011110100101111101001100100010;
   symbol[ 52] = 'b11111110101010010010100110111111111110001111101110011;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
