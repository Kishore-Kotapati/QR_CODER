   symbol[169] = 'b000000001001101010011110001010001001100111001010101111011000111101011100100001001111100010000010010110100100010010001100110100001101010100011000110000110010010000110010100010101;
   symbol[170] = 'b111111101110111000001111100110101111011111110001010100111010101000000010101010100110101011001110000100101110111110101010010110100011110110111010111010010000111010010000101010011;
   symbol[171] = 'b100000100001101111110010110110001110001001101110101100001000110111110111010001000110100011010111111001000101001010001000111100001001011100001000110000111010010000111011100010110;
   symbol[172] = 'b101110101001101111000101100011111101100110001011010001101111100010101001011010000101111110000010111011101111000011111010110110111010110110111111111010110010111010110010111110111;
   symbol[173] = 'b101110100101000010001111100011001001100110010100101001101001101101011100001001001110101111110110010001000101101100010000110100010000110100000010001101010010010101010010010100110;
   symbol[174] = 'b101110101011000000010010110101000111011001100101010110110000101000000010101010100111101011000010000011101111001111011100010110111100010110101000100101110000111101110000111100001;
   symbol[175] = 'b100000101110010111100001100010100110001000011010101100100101000111110111010101000111010011100101111100100100010101110110111100010110111100000010001111011010010111011010010110110;
   symbol[176] = 'b111111100001000111000111011011011101100010010101010010001110010010101001110010000100001111110110111100001110111011001100110110101100110110101010101101110010111101110010111100111;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
