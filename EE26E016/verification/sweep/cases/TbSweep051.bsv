package TbSweep051;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep051(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101010000100110101000011111011101111000011001111111;
   symbol[  1] = 'b100000100100110100010011001111101011010111011001001000001;
   symbol[  2] = 'b101110101101011010110111101101001101111011111011001011101;
   symbol[  3] = 'b101110101110011110110001101101001110111010011101001011101;
   symbol[  4] = 'b101110100000010010111011101111111110000010111001001011101;
   symbol[  5] = 'b100000101111111011110101001000110101111011001010001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001000001010010110001000101110011010100111000000000;
   symbol[  8] = 'b010101111111011011101101011111110111101011011111111101101;
   symbol[  9] = 'b000110010001111100100011011000100100001000111100101110100;
   symbol[ 10] = 'b100000111000101001110100011000010100111000100100011110011;
   symbol[ 11] = 'b111001010111000111101001011010101011011100011001111101101;
   symbol[ 12] = 'b101111100101100010101111111011111000101101110011111010101;
   symbol[ 13] = 'b010011011001101110100100101010001000000101001111000001000;
   symbol[ 14] = 'b000101100000011101101011011011001011100100111110110100111;
   symbol[ 15] = 'b100100010110010101000101001110111101001000100101001101011;
   symbol[ 16] = 'b010001100000001001110101101001100101010000011100110111100;
   symbol[ 17] = 'b100100011110100100101001110000100100100001101101100111101;
   symbol[ 18] = 'b001100101010110101100010001111011111001010101110001100001;
   symbol[ 19] = 'b000011001100000110110111000110101000000101000000100110110;
   symbol[ 20] = 'b000100101100110001100110110000111001110010111000110101100;
   symbol[ 21] = 'b100010001011101000110001111101101010010101011011010110100;
   symbol[ 22] = 'b101101111011011110110110100001001000101011100001101110001;
   symbol[ 23] = 'b001100011111011010001110100111010010000000001100000001110;
   symbol[ 24] = 'b010011110011010101101001111011011001000011101110100010101;
   symbol[ 25] = 'b011110000101110011101000110010011001111011010110111010110;
   symbol[ 26] = 'b000111111011111100110010101111101010000010100111111111000;
   symbol[ 27] = 'b010010001110100010111110111000111100010000110010100011100;
   symbol[ 28] = 'b011110101111110010110111101010101100101000100011101011111;
   symbol[ 29] = 'b101010001010101001101100101000100101011001110011100011101;
   symbol[ 30] = 'b111111111010100101101100101111110110111011010011111110001;
   symbol[ 31] = 'b010110000011111000000001101010001001011111010111100110110;
   symbol[ 32] = 'b010011110110111101001010101010110000001100100110100011100;
   symbol[ 33] = 'b001100011001101001000100100111001011101111000101000011010;
   symbol[ 34] = 'b010100110000100111111001110001010001011111111101111011100;
   symbol[ 35] = 'b010011000000101011011111100100010101011001111010101010010;
   symbol[ 36] = 'b000010111110100000000101110000011110111010000001101111110;
   symbol[ 37] = 'b111010001011010011010111101110011110000010110000110110110;
   symbol[ 38] = 'b001010101010101101110101101111111111110011110010100111000;
   symbol[ 39] = 'b000000001101101010010011111000111011010101000011100100100;
   symbol[ 40] = 'b010000101001100110011000100101101011001111111011100000111;
   symbol[ 41] = 'b000001010110100001010100010110000010111110001011111010011;
   symbol[ 42] = 'b000010100001010001101011111011000011011101101011011001110;
   symbol[ 43] = 'b010000011100110001110100000011000111011010110001001001001;
   symbol[ 44] = 'b000111100011101000001100010011011110001011000011000110111;
   symbol[ 45] = 'b000000010101000101100100010000000101101000100111000100100;
   symbol[ 46] = 'b101001110011101001101101101010111101011000111100111100011;
   symbol[ 47] = 'b111110010000110001011011011101111011011100011010101101101;
   symbol[ 48] = 'b000000110101101001001011011111110000111101110001111110101;
   symbol[ 49] = 'b000000001001100111001100011000101000000101001001100011000;
   symbol[ 50] = 'b111111101000010010100110111010111011110100111010101010111;
   symbol[ 51] = 'b100000101110111001100010011000110101001100100100100011011;
   symbol[ 52] = 'b101110100000111011010000011111100101010000011101111111100;
   symbol[ 53] = 'b101110101100011010101110010101010100100111101101000000011;
   symbol[ 54] = 'b101110100001111001111011001110110111001010101110100101101;
   symbol[ 55] = 'b100000101011101010000000001100110110000110100000011111001;
   symbol[ 56] = 'b111111100100101010001011000011100111110101011001100110100;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
