package TbSweep079;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep079(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101100011000111110100101101000101111111;
   symbol[  1] = 'b100000100000111011001100111111111001001000001;
   symbol[  2] = 'b101110100110000000010111101010110001001011101;
   symbol[  3] = 'b101110100111001011011110100011110101101011101;
   symbol[  4] = 'b101110100001111011101111110001100111101011101;
   symbol[  5] = 'b100000100010100000001000100010111000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001110001110001000111101011001000000000;
   symbol[  8] = 'b110110100000110011011111100110001010101000001;
   symbol[  9] = 'b010000010011011010101100101111000011001110110;
   symbol[ 10] = 'b100011110111010001101110011101110001011100110;
   symbol[ 11] = 'b000010000100101010111101000010010010000011100;
   symbol[ 12] = 'b101001101111000011110110001001011010101000100;
   symbol[ 13] = 'b110001000001011001100110111011001000111010011;
   symbol[ 14] = 'b010100111000101010110101000000110011100001001;
   symbol[ 15] = 'b001010000001100011110100010010111100110011000;
   symbol[ 16] = 'b011011101100110101100100000010101110100011010;
   symbol[ 17] = 'b101100001111100100111010111001110101111000011;
   symbol[ 18] = 'b011111111001011100001011111000111110111001011;
   symbol[ 19] = 'b111010010101101110011001100100111110100101010;
   symbol[ 20] = 'b101011111111110111001111111111101100111110111;
   symbol[ 21] = 'b011010001101111100101000110110100100100011111;
   symbol[ 22] = 'b000110101110001110001010101100110100101011101;
   symbol[ 23] = 'b000110001100010101001000100110000010100011110;
   symbol[ 24] = 'b010111111011111010001111101111000011111111011;
   symbol[ 25] = 'b001110001001001000111100111101010001010000111;
   symbol[ 26] = 'b010110110010001010111111100110101011101011101;
   symbol[ 27] = 'b110111000111000011101110101011011010001010100;
   symbol[ 28] = 'b100000101101110001101100111011001000101100110;
   symbol[ 29] = 'b100101000110000010101111100000010010010011100;
   symbol[ 30] = 'b100110111111000011101001101001111010011110100;
   symbol[ 31] = 'b000110011011010001100011000000101110101011110;
   symbol[ 32] = 'b110101100111101110100000011001110100010110101;
   symbol[ 33] = 'b100111011110101101100011010000111100111101001;
   symbol[ 34] = 'b000010110000101110011011101010101101001111001;
   symbol[ 35] = 'b011110000001110101011000011111100101110100010;
   symbol[ 36] = 'b100110111100111110001111110110100101111111101;
   symbol[ 37] = 'b000000001100101110101000100100110111100011101;
   symbol[ 38] = 'b111111100011110101011010110111101110101010110;
   symbol[ 39] = 'b100000100110111100001000101111001010100011111;
   symbol[ 40] = 'b101110101011101000001111111101010001111110001;
   symbol[ 41] = 'b101110101110010011110101000110001011111111100;
   symbol[ 42] = 'b101110100101000011111110001111100010010110111;
   symbol[ 43] = 'b100000101111010001101001111001001000000100101;
   symbol[ 44] = 'b111111101010101010110010100000010011010111110;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
