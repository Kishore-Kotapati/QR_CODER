   symbol[125] = 'b10110100110100111111111001001100001000010111111110101100001101000110100110001110001111101110001010001101010111111110001100001000101110001;
   symbol[126] = 'b10100110100101011111101100101110111100010111011011110111011010001110111101110000101001000010001110100010001100110101010111010010100010100;
   symbol[127] = 'b01011100010110100011011101101001110101011110010010000001101100111000001011000001100000001011000111101100001111010010100001110000001011101;
   symbol[128] = 'b11111010110101111111011111111000011110111010011110111111111101101010111001011111101101000110101010000011111100000100110010100110111110000;
   symbol[129] = 'b00000000110000111011010110001100111010110110111011100010100011100100100011001000101111001101101111001110001101011101001001011100100011011;
   symbol[130] = 'b11111110001101010110111110101101110011011001110010101010010101000000010101011010100110001100100110001010101111111010111111111010101010010;
   symbol[131] = 'b10000010011010001110100010001010011110110100011111100010000111010010000111011000101011100001001011100110001100111100101100111101100011111;
   symbol[132] = 'b10111010110000111010011111111100111110011000111010111111011111001101011101001111101111100111101111100111111110100011110111100010111111111;
   symbol[133] = 'b10111010111001010011111100111001110101111011110011101011101000101111101011101100100010000100100111100101110010010101000001110101011011100;
   symbol[134] = 'b10111010000001111011100110011110011000110100011111011001111110101101111001000011001101100001001010000001100000010111010011110110111100011;
   symbol[135] = 'b10000010111101101010010111111010111100010000111011100010100101110110100010011011101001000101101110100100111110011000001000111000110000111;
   symbol[136] = 'b11111110111110010011010010111001110111010001110010110100010010000100010100110010100000101110100111101110111001101010111110001011011001110;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
