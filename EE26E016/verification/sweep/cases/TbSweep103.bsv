   symbol[144] = 'b1111101011100000101001101011010111101000001110001100010000010001000100010000100011000100010001000100011111101110111011101111011010111011101110111111011010111;
   symbol[145] = 'b1000000001011111010001110100010000111101011110001100010010111011101110111010100001101110111011101111111101000100010001000100010000010001000100010000010000000;
   symbol[146] = 'b1101101100101110010011011100001000001100111110001000010101011001100110011000100111100110011001100111110110001000100010001001111010111011101110111011011010100;
   symbol[147] = 'b1111100100100100111011001000110010001100010110011101011010111001100110011001101110010001011101100110111100100010001000100010110000010001000100010000010000001;
   symbol[148] = 'b1010011011100000101001101011111111101000001110001100111110010001000100010000111110111011110111000101111110001001100110011000111110111011101110111011111110100;
   symbol[149] = 'b0000000011011111010001110101100010111101011110001101100010011011101110111010100010010001011101101110100010000001100110011000100010010001000100010001100010010;
   symbol[150] = 'b1111111010101110010011011101101010001100111110001001101010111001100110011001101010111011111111100111101011101111011101110110101010111011101110111011101010111;
   symbol[151] = 'b1000001000100100111011001000100010001100010110011100100010111001100110011001100011100110011001100110100011000101110111011101100010010001000100010000100010010;
   symbol[152] = 'b1011101001100000101001101010111111101000001110001100111110010001000100010000111111000100010001000101111111101110111011101110111110111011101110111011111110111;
   symbol[153] = 'b1011101001011111010001110101001000111101011110001101101110111011101110111010111011101110111011101111100001000100010001000101011100010001000100010001000100000;
   symbol[154] = 'b1011101010101110010011011100101110001100111110001001001101011001100110011000011001100110011001100111000011101000100010001001110110111011101110111011101110111;
   symbol[155] = 'b1000001000100100111011001001010110001100010110011101001100111001100110011000011100010001000001100111101001000010001000100011011100010001000100010001000100010;
   symbol[156] = 'b1111111011100000101001101011001101101000001110001101000110010001000100010000010110111011101001000101100011111001100110011001111110111011101110111011101110111;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
