package TbSweep064;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep064(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100001001101101011110000111100101111111;
   symbol[  1] = 'b100000100101010110100001010010010101001000001;
   symbol[  2] = 'b101110101000011100001011110110101101001011101;
   symbol[  3] = 'b101110100110110100100001011100001001101011101;
   symbol[  4] = 'b101110100111011100101111110110100011101011101;
   symbol[  5] = 'b100000100101010110111000110100001100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001010100011101000110000110100100000000;
   symbol[  8] = 'b111011111100101111001111111010010110111000100;
   symbol[  9] = 'b101100011100100101010011010000111100100011000;
   symbol[ 10] = 'b010101101000010110101001011010110110011111111;
   symbol[ 11] = 'b100100010000011100001011110100100100110101010;
   symbol[ 12] = 'b011000111100010110100011011100001111111101111;
   symbol[ 13] = 'b011000001000110100001011010110100101010111010;
   symbol[ 14] = 'b001000100101010110101001011100101111111100110;
   symbol[ 15] = 'b111001001111111100001011101101000011010110011;
   symbol[ 16] = 'b011100100011110010100011000101101001111010010;
   symbol[ 17] = 'b011001000001010010001100001111000011010000101;
   symbol[ 18] = 'b101010101010001001011110101101101011100100001;
   symbol[ 19] = 'b000111011100000011110100001001010011001000100;
   symbol[ 20] = 'b101111111101101011011111100011110000111110100;
   symbol[ 21] = 'b101110001101100011011000101001011011100010000;
   symbol[ 22] = 'b001010101000001001001010101011110011101011001;
   symbol[ 23] = 'b110110001011000011111000110000110100100010000;
   symbol[ 24] = 'b000011111110101111011111111010010110111111101;
   symbol[ 25] = 'b100011000100100101010001010000111100111101010;
   symbol[ 26] = 'b001010101010010110100011111010110111110111111;
   symbol[ 27] = 'b111000011010111100010001010100100101110101000;
   symbol[ 28] = 'b011111110100110110101011111100001111110111101;
   symbol[ 29] = 'b011101000110110100011001010110100100111000010;
   symbol[ 30] = 'b110110100010010110111100111100101111011011010;
   symbol[ 31] = 'b101000010110111100001110101101000011001000011;
   symbol[ 32] = 'b101001111011110010111100000101101000001011010;
   symbol[ 33] = 'b011000000001010010011100101111000011000010111;
   symbol[ 34] = 'b000010110001101001011100101101101010101000001;
   symbol[ 35] = 'b011110010011000011101110101001010011000010111;
   symbol[ 36] = 'b100110111011101011011111100011110000111110110;
   symbol[ 37] = 'b000000001111000011001000101001011011100010100;
   symbol[ 38] = 'b111111101111101001001010101011110010101011101;
   symbol[ 39] = 'b100000101001000011111000110000110101100010000;
   symbol[ 40] = 'b101110101100101111001111111010010110111110001;
   symbol[ 41] = 'b101110100000100101000011110000111101011111010;
   symbol[ 42] = 'b101110101100010110101011011010110111000111101;
   symbol[ 43] = 'b100000101100111100000100010100100101110011010;
   symbol[ 44] = 'b111111101110110110101110111100001111001111111;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
