   symbol[170] = 'b111111101000110110010001101010101001010001111111011010111010100110001100100100101000101011000000001010100000110010101100011000101101111000111010110100011110110100011110101010000;
   symbol[171] = 'b100000100110010000010101001010001001110110010001010011111000101000001000101110111001100010101000000110111010110110001111000011110110100011111000101111000101101111000100100011011;
   symbol[172] = 'b101110100111100001001011101111111011101000000101011111101111101100100111010100001011111110001100110101100001001111111100111000110100111000111111110100111100110100111100111110100;
   symbol[173] = 'b101110100000110111111010010110111100010011100001011100011100011000101001111100111011011010000011100100110000011001100101000001100101000001110111111000100111100000100111100001000;
   symbol[174] = 'b101110100110010101000111100000010010001100110000000011100101111101010111111111110010111110010111010110111010011010001001000011101001000011111101110000100101101000100101101001011;
   symbol[175] = 'b100000101011100010010100010111010011111101101111011001010000110010000010100000110010100110010000001001010001100000000011001001100011001001110111111010101111100010101111100011001;
   symbol[176] = 'b111111100111001001001001010101010011101100011011011100000000011100100111111100001010000001111000110010000000110101000010111000100010111000100100100011111100110011111100110010100;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
