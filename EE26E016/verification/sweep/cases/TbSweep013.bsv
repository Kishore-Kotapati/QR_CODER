   symbol[139] = 'b0100010001110001101110011101100001011001000011001000001111101100110011001100111011000010001000100011101001110111011101110111100101000100010001000101000101011;
   symbol[140] = 'b1000001110110101111100111110000100110101011011011001000101000100010001000101110001101000100010001000101011011101110011001101110111101110111011101110001001110;
   symbol[141] = 'b1110110100001010000100100001000011101000001011011001000111001110111011101111110011000010001000100011001001010101010011001100111101000100010001000011000101000;
   symbol[142] = 'b1000011001111011000110001001011001011001101011011101000111101100110011001101110111101010101010101010000010111011101000100011010111101110111011101000001001101;
   symbol[143] = 'b0111110001110001101110011101100101011001000011001000001101101100110011001100111100110011001100110010001000010001000010001001010101000100010001000011000111000;
   symbol[144] = 'b1010111110110101111100111110000010111101011011011001000101000100010001000101110110010001000100010001001010111011101110111010001111101110111011101010001111101;
   symbol[145] = 'b1101010100001010000100100001000101101000001011011001000111101110111011101111110100111011101110111010101000010001000100010001000101000100010001000101000101010;
   symbol[146] = 'b1101101001111011000110001001011101011001101011011101000000001100110011001101110010110011001100110010100011011101110111011100101111101110111011101110001111110;
   symbol[147] = 'b1111100001110001101110011101100111011001000011001000001111101100110011001100111011000100001000110011101001110111011101110111100101000100010001000101000101011;
   symbol[148] = 'b1010011110110101111100111110111110111101011011011001111111000100010001000101111111101110100010010000111111011100110011001101111111101110111011101110111111110;
   symbol[149] = 'b0000000010001010000100100000100011101000001011011000100011001110111011101111100011000100001000111011100011010100110011001101100011000100010001000100100011000;
   symbol[150] = 'b1111111001111011000110001000101011011001101011011100101011101100110011001100101011101110101010110010101010111010001000100011101011101110111011101110101011101;
   symbol[151] = 'b1000001001110001101110011101100011011001000011001001100011101100110011001100100010110011001100110011100010010000100010001000100011000100010001000101100011000;
   symbol[152] = 'b1011101010110101111100111111111110111101011011011001111111000100010001000101111110010001000100010000111110111011101110111011111111101110111011101110111111101;
   symbol[153] = 'b1011101000001010000100100000011101101000001011011000111011101110111011101111101110111011101110111010110100010001000100010000001001000100010001000100010001010;
   symbol[154] = 'b1011101011111011000110001001111011011001101011011100011000001100110011001101001100110011001100110010010110111101110111011100100011101110111011101110111011101;
   symbol[155] = 'b1000001001110001101110011100000011011001000011001000011001101100110011001101001001000100010100110010111100010111011101110110001001000100010001000100010001000;
   symbol[156] = 'b1111111010110101111100111110011000111101011011011000010011000100010001000101000011101110111100010000110110101100110011001100101011101110111011101110111011101;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
