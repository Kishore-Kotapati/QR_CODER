package TbSweep096;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep096(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100000010010111011100111011110000010101111001111111;
   symbol[  1] = 'b100000100010111111010001110100010001011111111001001000001;
   symbol[  2] = 'b101110101111101011111110001101101110000010100011001011101;
   symbol[  3] = 'b101110100101111101001000100100010011010111111001001011101;
   symbol[  4] = 'b101110101000010110101111011111101001111101010001001011101;
   symbol[  5] = 'b100000101000101011010100111000110100101000100010001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000100011111110011001000101001000111010000100000000;
   symbol[  8] = 'b010010101011110000011100101111100011001111111011110110100;
   symbol[  9] = 'b110101000100010111111010110111111110011010101110111100111;
   symbol[ 10] = 'b011110100100100001001110011001101110110000000110010110011;
   symbol[ 11] = 'b100001000100001011010111111101111111011010110111011111001;
   symbol[ 12] = 'b000001100000000101110110001010100101010000011000110111100;
   symbol[ 13] = 'b110000011010010010001111010111000000000101001001000101001;
   symbol[ 14] = 'b010011100111010010001111100001110010100111000111100111100;
   symbol[ 15] = 'b000001001100011100110000000110110000000111000000100010110;
   symbol[ 16] = 'b011101110111111100111000001011000010101111100011101000111;
   symbol[ 17] = 'b111100000110010011011011010000101111111010110110111100111;
   symbol[ 18] = 'b010011100100110011001111111111011111010000011110010110011;
   symbol[ 19] = 'b010110000100011101010000011100110111011010110111011011001;
   symbol[ 20] = 'b000011100000011111110001101001000101010000011100110001100;
   symbol[ 21] = 'b100010011010010100001011010100101000000101001001000100100;
   symbol[ 22] = 'b100011100111010000001000000011011010100111000011100110001;
   symbol[ 23] = 'b000011001100001000110110100110001110000110100000100111000;
   symbol[ 24] = 'b011101110110110010110101101011001100101110000011101111111;
   symbol[ 25] = 'b001100000111100101011000010001100001111011010110111010011;
   symbol[ 26] = 'b010011111101101001011001011111111011010001011110111110111;
   symbol[ 27] = 'b010110001100111001000001101000101001011111010111100010001;
   symbol[ 28] = 'b000010101000000111110001111010101011010111111100101010100;
   symbol[ 29] = 'b100010001011100100000001011000100110000010101000100010111;
   symbol[ 30] = 'b100011111010011001000110011111101110100000000011111110011;
   symbol[ 31] = 'b000000000101010001110100111110101110000010100001010001001;
   symbol[ 32] = 'b011100110000010010010111101010001100101000000011100101100;
   symbol[ 33] = 'b001001010011101100000000011001100001111101010110110001001;
   symbol[ 34] = 'b011010100010001001000001010011011011010111011111111011100;
   symbol[ 35] = 'b010010010101011001110001101010101001011111010111000110110;
   symbol[ 36] = 'b000000110001100110011001110001101011010111111100000000111;
   symbol[ 37] = 'b100001000010000100010001011010100110000010101000110110111;
   symbol[ 38] = 'b101011101000111001100110011110101110100000000011111100011;
   symbol[ 39] = 'b000000010110110000110100100111001110011010100111000001001;
   symbol[ 40] = 'b100000110010110100110111001000001100110000000100000101100;
   symbol[ 41] = 'b110001000110101000101000111111100001100101010000111001001;
   symbol[ 42] = 'b101010101100001110010000010001011011000111011011000011100;
   symbol[ 43] = 'b000010010011111100000001100000101000000111000001111110110;
   symbol[ 44] = 'b100100100111100001011001000001110010101111100011100000111;
   symbol[ 45] = 'b111001000110000110110000010100110111111010110111010110111;
   symbol[ 46] = 'b101001110100110010000101010110110111010000011110111100011;
   symbol[ 47] = 'b111110001100101001110100000101010111011010110111000001001;
   symbol[ 48] = 'b000000111000100001010011011111111101010000011100111111100;
   symbol[ 49] = 'b000000001000111110001110001000101000000101001001100011001;
   symbol[ 50] = 'b111111100100010010010101001010100010100111000011101011100;
   symbol[ 51] = 'b100000100011101000000100001000110000000111000001100010110;
   symbol[ 52] = 'b101110101111100001011010011111111010101111100010111110111;
   symbol[ 53] = 'b101110100110011110110110110000001111111010110110111001011;
   symbol[ 54] = 'b101110100100111010000011110010000111010000011110110101100;
   symbol[ 55] = 'b100000101100101011110111011111000001011011010111100010110;
   symbol[ 56] = 'b111111100000011011001000011011000011010001111101001010111;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
