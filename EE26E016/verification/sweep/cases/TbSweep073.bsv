   symbol[138] = 'b0011001110111000111100101110011011010110010011111000110100100000110101100001010100110101100000110101000111111001010011111000001011001010011111001010101011010;
   symbol[139] = 'b1011010100010011000100101111100101110001101001010011110001010101100000110101100000010001110001110000110000101100000110101101110110011111001010011111010110000;
   symbol[140] = 'b0110011001101110011010000101110001010010100101000110000001111111001010011110101010110011111001010011111000001110001010011110101110010111101000010111010100001;
   symbol[141] = 'b0110000001101111001111000100111001011100100010101101000100101010011111001010011111100110101100000111101101010011111111001010011001101000010111101111100001101;
   symbol[142] = 'b0001111110111000111100101110011101010110010011111000110011000000110101100001010001101100000110101101100110011111001100000111110011001010011111001100101101001;
   symbol[143] = 'b1000110100010011000100101111100101101001101001010011110011010101100000110101100111100000110101100001010001001010011001010011000110011111001010011001010000011;
   symbol[144] = 'b0100101001101110011010000101110011000010100101000110000001111111001010011110101101001010011111001010011001101000010111101001010110010111101000010011010110010;
   symbol[145] = 'b0101100001101111001111000100111111011100100010101101000100001010011111001010011000011111001010011110001100010111101000010111100001101000010111101001100001111;
   symbol[146] = 'b1101101110111000111100101110011011010110010011111000110100100000110101100001010100110101100000110101000111111001010011111000001011001010011111001010101011010;
   symbol[147] = 'b1111100100010011000100101111100101101001101001010011110001010101100000110101100000010111110001100000110000101100000110101101110110011111001010011111010110000;
   symbol[148] = 'b1010011001101110011010000101111111000010100101000110111111111111001010011110111110110101111001001011111110001111001010011110111110010111101000010111111110001;
   symbol[149] = 'b0000000011101111001111000101100011011100100010101100100010101010011111001011100011100000101100011111100011010010011111001011100011101000010111101000100011101;
   symbol[150] = 'b1111111010111000111100101111101011010110010011111000101011000000110101100001101011101000000110110100101010011110101100000111101011001010011111001010101011001;
   symbol[151] = 'b1000001000010011000100101110100011101001101001010011100011010101100000110101100011100000110101100000100011001011111001010011100010011111001010011110100010011;
   symbol[152] = 'b1011101011101110011010000101111111000010100101000111111111111111001010011110111111001010011111001010111111101000010111101000111110010111101000010111111110010;
   symbol[153] = 'b1011101001101111001111000101010011011100100010101100000000001010011111001011001010011111001010011110011000010111101000010110001111101000010111101000010111101;
   symbol[154] = 'b1011101000111000111100101111000001010110010011111001111010100000110101100001100000110101100000110100110010011001010011111000000111001010011111001010011111010;
   symbol[155] = 'b1000001000010011000100101110111011101001101001010011010011010101100000110100110000010111101101100001100111001100000110101101010010011111001010011111001010000;
   symbol[156] = 'b1111111011101110011010000101111011000010100101000110101101111111001010011110011000110101100111001011001111111111001010011111111000010111101000010111101000001;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
