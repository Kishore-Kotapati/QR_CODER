   symbol[ 65] = 'b0000000010100110000101011000101010011011010010001010000001010100100010011;
   symbol[ 66] = 'b1111111001101100100100101010101001011000000010101111011111001101101010111;
   symbol[ 67] = 'b1000001011100001111100111000101011110111000110001110010011000101100010011;
   symbol[ 68] = 'b1011101000111001101100011111111001110100111011111111110100111110111110001;
   symbol[ 69] = 'b1011101000111100100111111101101000110110110000110110111101110110010111001;
   symbol[ 70] = 'b1011101001111010010010011111011111100110010110010011000111111010101101101;
   symbol[ 71] = 'b1000001000110101111100110101001011110000110101101000001000000100010101111;
   symbol[ 72] = 'b1111111000110101011010100011101111010000001111010111101101101000010001111;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
