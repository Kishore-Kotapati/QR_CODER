   symbol[137] = 'b0011010111011001111001110010001001101010010100011011110010111100101001111100101110101001111100101000111010100001011110100001010111011110100001011111010111001;
   symbol[138] = 'b1101001000110110110010100000010101001000011101110110111010101110111011101111011010111011101110111011001001110111011101110110000101000100010001000100100101011;
   symbol[139] = 'b0100100011101100111011010000011010001110010110101100001110101010011111001010011111101110001110001111001111010011111001010010001001100000110101100000101001111;
   symbol[140] = 'b0101111010001101111001100110010000101001000110100101100010011100101001111101001001010000011010110000011011101101101001111101001101110100001011110100110111101;
   symbol[141] = 'b0010100101001011101011100000011001111000000110001001100000001110111011101110111011000010001000100011001001110111011011101110111101001100110011001011000011001;
   symbol[142] = 'b1011011100010010010110000100110101111100111001010010011001101010011111001011111011000110101100000111001100110101100110101101011001100000110101100110000011100;
   symbol[143] = 'b0001110101011010001101100110101110100000100000011010111010011100101001111100101110101001111100101000011000000011010000011010001111010110000011010000011001010;
   symbol[144] = 'b0101011000011111101011110100000010110011010100110111110000001110111011101111011100111011101110111011101000011001100110011000100111100110011001100010100111100;
   symbol[145] = 'b0101100001101111001111000100111111011100100010101101000100001010011111001010011000011111001010011110001100010111101000010111100001101000010111101001100001111;
   symbol[146] = 'b1101101010100100100000110010000111001010001111100100101000111100101001111101001000101001111100101001011011100101001111100100010111010110000011010110110111001;
   symbol[147] = 'b1111100111001000011111110100111110110010110010001000101010001110111011101110111011001100101010111011101011110111011101110110101101000100010001000100001101011;
   symbol[148] = 'b1010011100111011001111010000111110010111110000010011111110101010011111001011111111100000101100011110111111011010011111001011111111000010111101000010111111011;
   symbol[149] = 'b0000000011011001111001110011100011101010010100011010100010011100101001111101100011010110011010101001100011100100101001111101100011011110100001011110100011011;
   symbol[150] = 'b1111111010110110110010100001101011011000011101110110101011001110111011101111101011100110001000111010101010010000100010001001101011000100010001000100101011000;
   symbol[151] = 'b1000001011101100111011010001100010010110010110101100100010101010011111001010100010011111001010011111100010110100000110101100100011100000110101100001100011100;
   symbol[152] = 'b1011101010001101111001100110111110100001000110100100111110011100101001111101111110101001111100101001111110001011110100001011111111110100001011110100111111110;
   symbol[153] = 'b1011101011001011101011100001110111111000000110001000100100101110111011101111101110111011101110111010111100110011001100110010101011001100110011001100110011001;
   symbol[154] = 'b1011101000010010010110000101101011111100111001010011010000001010011111001011001010011111001010011110011000110011111001010010101101100000110101100000110101111;
   symbol[155] = 'b1000001001011010001101100111110010100000100000011010011010011100101001111101111001011110100100101000101110000101001111100100011011010110000011010110000011001;
   symbol[156] = 'b1111111010011111101011110100001010110011010100110111011100001110111011101111101001000100010110111010111110001110111011101110001001100110011001100110011001111;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
