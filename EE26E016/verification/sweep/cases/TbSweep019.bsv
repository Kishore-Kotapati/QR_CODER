package TbSweep019;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep019(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101111000011100101111110110000101111111;
   symbol[  1] = 'b100000100001001010111101001110001001001000001;
   symbol[  2] = 'b101110101010100100110011001110010101001011101;
   symbol[  3] = 'b101110101101000101010000101101111001101011101;
   symbol[  4] = 'b101110101101011111001111110101000011101011101;
   symbol[  5] = 'b100000100011010001111000110011001000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000111111111111000101100101000100000000;
   symbol[  8] = 'b111100101100010111111111100010101110010011101;
   symbol[  9] = 'b011111000101010100100010100001001101000000100;
   symbol[ 10] = 'b010101100001110101001010111001010101111000001;
   symbol[ 11] = 'b010011010111011011001100110011100011110010010;
   symbol[ 12] = 'b000010110110011000101101010010000001110011100;
   symbol[ 13] = 'b010000010000001000010111001010111001001010101;
   symbol[ 14] = 'b111100111101001110010001100100010111000100101;
   symbol[ 15] = 'b001010011111001101111010011100110010111101001;
   symbol[ 16] = 'b111101101000010001000000100110001010000111010;
   symbol[ 17] = 'b011101000110010101001011001000000100001001110;
   symbol[ 18] = 'b010101100100000111010000100011100101100010000;
   symbol[ 19] = 'b111011000010011111101000010101001111010100101;
   symbol[ 20] = 'b010011111111010011101111111011001000111110011;
   symbol[ 21] = 'b111110001010010010101000111000101010100010110;
   symbol[ 22] = 'b100010101010001010101010101000010000101010001;
   symbol[ 23] = 'b111010001100000100111000110111110011100010000;
   symbol[ 24] = 'b001111111000100001011111110100011000111111100;
   symbol[ 25] = 'b111111011000111001001101001100100000100001010;
   symbol[ 26] = 'b010010110010101110011011000010001111001111001;
   symbol[ 27] = 'b001001001001001101100000100101010100000100101;
   symbol[ 28] = 'b000100111011010101001000011111101100001100010;
   symbol[ 29] = 'b111101000111110011011110010001100011100011110;
   symbol[ 30] = 'b110101100100011000110010110010100001000000011;
   symbol[ 31] = 'b110101000010100000010010110001011111011000100;
   symbol[ 32] = 'b010001100011001010000100111101010000110010001;
   symbol[ 33] = 'b101001010000100011101101011110110010110011010;
   symbol[ 34] = 'b000010110100001010111111001110001001101011101;
   symbol[ 35] = 'b011110010000000100101001101110010100000101100;
   symbol[ 36] = 'b100110110101100101011111101101111110111110100;
   symbol[ 37] = 'b000000001101011111011000110101000110100011011;
   symbol[ 38] = 'b111111100111010001111010110011001010101011010;
   symbol[ 39] = 'b100000100000110010001000100001000100100010110;
   symbol[ 40] = 'b101110100111001100101111111001110101111110001;
   symbol[ 41] = 'b101110101111100010000100110111111010001010010;
   symbol[ 42] = 'b101110101100011000100101010100111001001011100;
   symbol[ 43] = 'b100000101110100000011000001000111001110011011;
   symbol[ 44] = 'b111111101100001110010110000100110111110101010;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
