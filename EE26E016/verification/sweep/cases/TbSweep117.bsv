   symbol[128] = 'b11111011110001001110110011111000001010000100001010111111011010011000011110101111110011010010010100010111111010110010000100010000111110010;
   symbol[129] = 'b00000000110010011101010010001001001101101011001100100010011000001010011000111000110010111010110010111010001010100010110110100011100010101;
   symbol[130] = 'b11111110101010101001001010101010101000000010101001101011001110011011001110011010111101010111111101010010101000110000100000110000101011001;
   symbol[131] = 'b10000010111001001101111010001001101101000111101100100011110100100001110100101000111000010010111000010010001110001011001110001010100010001;
   symbol[132] = 'b10111010011101000010011111111101100011101111100111111110110001110110110011111111111000111010011000111011111001011100001000011101111110100;
   symbol[133] = 'b10111010011010010100011001101101100011000111100101010000110010100000110001110010011110010010011011110010101100001011011111101011000111100;
   symbol[134] = 'b10111010001011101001111001010000101110000010101001101111001000011011001111110111111011010111111100110111010010110000100001010000000010110;
   symbol[135] = 'b10000010110000100101000110000011000011101111000100011101011010001001011101101100010110111010010001011011000000100011100110000011101111000;
   symbol[136] = 'b11111110110001001111110100111000001110000010001011111111011000011011011110101001110011010111110100010111110010110001100101010000000010010;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
