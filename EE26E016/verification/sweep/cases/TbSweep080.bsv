package TbSweep080;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep080(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110011000111110110100110010011000010010001111111;
   symbol[  1] = 'b10000010001110011100101111011010011101111011001000001;
   symbol[  2] = 'b10111010111011000010000101101111101001100101001011101;
   symbol[  3] = 'b10111010100111000100001001000110100110101010101011101;
   symbol[  4] = 'b10111010101011111101000011111010111100010010001011101;
   symbol[  5] = 'b10000010100010110001101110001111001100101110001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000100011011010010110001111110101100000000000000;
   symbol[  8] = 'b10111110000010011111001111111111101110011000101111100;
   symbol[  9] = 'b10001001110100100011101001101100101101010001010011111;
   symbol[ 10] = 'b10111111011110011101111110101000000101011110110010111;
   symbol[ 11] = 'b10100000001000100101110000011010100111011110100011011;
   symbol[ 12] = 'b11000111111001111010010001101000111001001101110110010;
   symbol[ 13] = 'b11000001010111100010101011000010010100100100101111001;
   symbol[ 14] = 'b11100111011100011000010100011000111101010011010110111;
   symbol[ 15] = 'b10101001110110100100010000001110110111100000001100111;
   symbol[ 16] = 'b01110110001100001111011000110011110011010001001001111;
   symbol[ 17] = 'b11011101101011111101001001001111110110100100110101110;
   symbol[ 18] = 'b01100010010010100010010000100111011011110100000110111;
   symbol[ 19] = 'b01010101100111101101101100101000010101101001001100101;
   symbol[ 20] = 'b11001111011001000001110101010100111000100101100001101;
   symbol[ 21] = 'b00101000111010001000001000001010110111010011111110110;
   symbol[ 22] = 'b11111011111000001110001011011000011111010011101011101;
   symbol[ 23] = 'b11110000101110000100001111010101000110100010001101110;
   symbol[ 24] = 'b00111111110010001101101111111100110100000010111111000;
   symbol[ 25] = 'b10001000110101111111000110001001000110101010100010011;
   symbol[ 26] = 'b00111010110110000110000010101110011100111111101010001;
   symbol[ 27] = 'b11101000100110001001000110001111001010000101100010010;
   symbol[ 28] = 'b00001111110010001101101011111100011001110001111111001;
   symbol[ 29] = 'b00011000010111110011010111010100111101010110001001010;
   symbol[ 30] = 'b10110010010000111111101011011101101101000010111110100;
   symbol[ 31] = 'b01011001010011101000000000100101111011011001101000101;
   symbol[ 32] = 'b11010011100101010110111111110100011110011000001101110;
   symbol[ 33] = 'b00100000101000000101010110011001001000111101100010001;
   symbol[ 34] = 'b11011011101110100110000101010100001110011011010011101;
   symbol[ 35] = 'b01101100111011010001100111000100100000110100111101101;
   symbol[ 36] = 'b11101110000010010100111101111110011010010001101010001;
   symbol[ 37] = 'b10101101011001000100100011010011001000101110111111111;
   symbol[ 38] = 'b11011110110111110011011100010100101101110000010101011;
   symbol[ 39] = 'b11110101010001011000000011110101111010000101111000110;
   symbol[ 40] = 'b01010111011000101111011101000111111100111100001110001;
   symbol[ 41] = 'b01100100010010111100101011011100110100011110010101000;
   symbol[ 42] = 'b11011110100010000010110101011101011001101101010010000;
   symbol[ 43] = 'b01100000100010101011100000101111100100001000101000110;
   symbol[ 44] = 'b00010010111001111001010011111110110011110110111111111;
   symbol[ 45] = 'b00000000110110001100010110001001111100010110100011110;
   symbol[ 46] = 'b11111110010101000000101010101010010001000001101011000;
   symbol[ 47] = 'b10000010101100011011111110001010001101011010100010110;
   symbol[ 48] = 'b10111010110110111010010111111011100111100011111110011;
   symbol[ 49] = 'b10111010100101001111010011001111010000010000101111010;
   symbol[ 50] = 'b10111010111100011011000110010100111001010100001110011;
   symbol[ 51] = 'b10000010011101110100011000111100111100010101111010011;
   symbol[ 52] = 'b11111110100111111110111000110011111010001000100100010;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
