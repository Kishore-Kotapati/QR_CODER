package TbSweep034;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep034(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100111000011100101111110110000101111111;
   symbol[  1] = 'b100000101000100111010000100011100101001000001;
   symbol[  2] = 'b101110100010010010000101111000100001001011101;
   symbol[  3] = 'b101110101010000101010000101101111001101011101;
   symbol[  4] = 'b101110100111010010101111111000101111101011101;
   symbol[  5] = 'b100000101100100111001000100101111100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000011110010011000100001000011000000000;
   symbol[  8] = 'b111110111010100001001111110100011101010101010;
   symbol[  9] = 'b011111000101010100100010100001001101110000110;
   symbol[ 10] = 'b101000111100011000100111010100111011101111100;
   symbol[ 11] = 'b010101000101101101111010000101010101000100100;
   symbol[ 12] = 'b101110110100011000101101010010000001110011110;
   symbol[ 13] = 'b011001011001100101111010100111010100100110100;
   symbol[ 14] = 'b000110101011011000100111010010100001110010011;
   symbol[ 15] = 'b001000010111001101111010011100110100101011101;
   symbol[ 16] = 'b010011111101111100101101001011100010101001111;
   symbol[ 17] = 'b101001000000100011111101111110110101100011010;
   symbol[ 18] = 'b000111110010000111010000100011100111100000010;
   symbol[ 19] = 'b000110001101110010000101111000100010011001011;
   symbol[ 20] = 'b011111111000000101011111101101111110111110101;
   symbol[ 21] = 'b111010001000110010101000111000101010100010010;
   symbol[ 22] = 'b000010101111100111001010100101111101101011000;
   symbol[ 23] = 'b000110001011010010001000100001000101100010110;
   symbol[ 24] = 'b001111111000100001011111110100011000111110000;
   symbol[ 25] = 'b010010010101010100100000100001001001001100111;
   symbol[ 26] = 'b000100100000011000101101110100111101011001110;
   symbol[ 27] = 'b011001001111001101100000100101010100000100110;
   symbol[ 28] = 'b111010101100111000100101110010000000111001110;
   symbol[ 29] = 'b010000000111000101101000100111010100100000000;
   symbol[ 30] = 'b110011111100011000110010110010100000000110111;
   symbol[ 31] = 'b011101001111001101111111011100110010111101101;
   symbol[ 32] = 'b100111110101111100110010001011100110000101011;
   symbol[ 33] = 'b101001010000100011101101011110110100110011011;
   symbol[ 34] = 'b000010111011100111010010100011100100100110000;
   symbol[ 35] = 'b011110000010110010011111011000100011010011001;
   symbol[ 36] = 'b100110101001100101011111101101111110111110110;
   symbol[ 37] = 'b000000001000110010111000111000101010100011110;
   symbol[ 38] = 'b111111101001100111001010100101111101101011100;
   symbol[ 39] = 'b100000100000110010001000100001000100100011110;
   symbol[ 40] = 'b101110101010100001001111110100011101111111100;
   symbol[ 41] = 'b101110101001010100110010000001001100100010110;
   symbol[ 42] = 'b101110101110011000100101010100111101011101100;
   symbol[ 43] = 'b100000101101001101110101100101010100010110100;
   symbol[ 44] = 'b111111101100111000100000110010000001011001110;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
