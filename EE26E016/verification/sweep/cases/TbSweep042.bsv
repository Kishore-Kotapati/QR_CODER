   symbol[127] = 'b01011101011110101011101000001001001101100110101010101001010100000000110011111001011000110011111111010100100110101110001000000100110011010;
   symbol[128] = 'b11111010101010010101101111111011010001011111010001111110000001000011000101111111101000001001001111001111111001101001011111001011111111001;
   symbol[129] = 'b00000000101010100101101010001001110101010011110100100010100000110010100000001000101010000010001010000010001010011010001110011011100010010;
   symbol[130] = 'b11111110011100011111111110101100011110110100011111101011111000101101111000101010101011100001001011100110101110000110010110000110101011111;
   symbol[131] = 'b10000010010010000110110010001010100110001100100111100010111111101010111111101000110011011001110011011010001101000000000101000001100011000;
   symbol[132] = 'b10111010010000101111110011111000001110000010001010111111011100011011011110011111110101010111110101010111111100110001100101110000111111001;
   symbol[133] = 'b10111010111100110010111101001011000101100001000011110110010100000110010111010100111000110100111101010100001010101101111001001101100001000;
   symbol[134] = 'b10111010110000110010100010001011110101011001110010110100010011000000010100101100100000001100100111101100001001101011111010001011011001101;
   symbol[135] = 'b10000010101000011101111110111011111011010111111100100101100010110001100101010100101110000010101001100011111000011011011110111011010111100;
   symbol[136] = 'b11111110100111111001000010001110111000110100111101001001101110101101101000011111000101100001000010100001000100000111010011100110110100100;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
