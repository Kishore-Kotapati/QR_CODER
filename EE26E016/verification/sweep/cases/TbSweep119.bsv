   symbol[171] = 'b100000101111100011001000010010001101111001101010011101001000110101101100100011110110100010010100111101000011100110001110110010000111010010001000111110110100011110110101100010101;
   symbol[172] = 'b101110100010100110100100111111111000000001110110001001101111110001101000010100101100111110010100110111110011011011111110001000101110001000101111101110001100101110001100111110010;
   symbol[173] = 'b101110101110101101100001001001110010100000001100000000000011111000010011100111000010011111000101101001111101010100001010000100001010000100010010010111100010001111100010001110010;
   symbol[174] = 'b101110101000110011010001101010100001010001111111001010100001100000100110100001101000100111000001000010111100110110101101100111001101100111011001010100000001001100000001001101100;
   symbol[175] = 'b100000101101110110101110101000111000010101110011110000000111001000000001001100011011011111001011010101001111010110010101011111110101011111100001101100111001110100111001110101001;
   symbol[176] = 'b111111100001010101111101011100110011011110110011010001000101111010110011100111110111101000111011101011001001111110000011010011100011010011101111100010010111110010010111110011000;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
