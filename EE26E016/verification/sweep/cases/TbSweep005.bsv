package TbSweep005;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep005(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110001011001011101110110110101010101110001111111;
   symbol[  1] = 'b10000010010101010000101111111100100101100011001000001;
   symbol[  2] = 'b10111010001001011100101000000001011000110101001011101;
   symbol[  3] = 'b10111010010001111111000100100000011100010010101011101;
   symbol[  4] = 'b10111010011011011111010111111111010001100110001011101;
   symbol[  5] = 'b10000010100110011101110010001110100100001110001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000000110010011100010001010110110100011100000000;
   symbol[  8] = 'b10010110111001110010101011111011011110111000110100000;
   symbol[  9] = 'b01110100100110001100001000000001000110000001000100100;
   symbol[ 10] = 'b01110011010011001111010001010001101100011111010011110;
   symbol[ 11] = 'b00111101100011011110111001101110110111011011001010111;
   symbol[ 12] = 'b00000110111110001110111110011011100110011100010010000;
   symbol[ 13] = 'b01101100001101010001001011011001101001000000001001101;
   symbol[ 14] = 'b11000111010101111001010011111100011100111101110110111;
   symbol[ 15] = 'b01011001001011101001111000011000001100101110101011001;
   symbol[ 16] = 'b00110011010001111111100100000110100111100100010111010;
   symbol[ 17] = 'b00011000110010110111111100101100100001100100100110011;
   symbol[ 18] = 'b11101110010111100101111011101100100010010000011101001;
   symbol[ 19] = 'b11111100100110110110010000000111001111000110010111000;
   symbol[ 20] = 'b11111110100101001000101111100101011111011011111111110;
   symbol[ 21] = 'b01000001110011011000111100001001110000011001000100011;
   symbol[ 22] = 'b00110010011010010100100000010100001000101000000010010;
   symbol[ 23] = 'b11010100111101010111011100111110101110011011110010110;
   symbol[ 24] = 'b01001111101111101000001111111111100011101000111110111;
   symbol[ 25] = 'b01101000101111111101100110001100111001010001100011100;
   symbol[ 26] = 'b11011010101110111000000110101001010010000100101010001;
   symbol[ 27] = 'b10001000101000010011101010001000101111001011100010010;
   symbol[ 28] = 'b11011111111001111001110011111000110010110111111111001;
   symbol[ 29] = 'b10000000000101110100100010100000000110100100010001101;
   symbol[ 30] = 'b00101111000011101011101001100101001001001100001010111;
   symbol[ 31] = 'b01110100000010100000000110011101110000100010110101011;
   symbol[ 32] = 'b01111011110000111110101111000011011010011010100111011;
   symbol[ 33] = 'b11110101011011100111101011100000000100011001111000010;
   symbol[ 34] = 'b01100010110001101110111001001000111000100010110111110;
   symbol[ 35] = 'b10000100011000000111000110000001000010011000100010111;
   symbol[ 36] = 'b01101110001101010010111001100110110111111000010111110;
   symbol[ 37] = 'b10100000001010110001001000111001101111000001011001000;
   symbol[ 38] = 'b11001111001000100110111100010100101000101100101001001;
   symbol[ 39] = 'b01010101101100010110000111010111001011000101111010011;
   symbol[ 40] = 'b01000111011001100011010010101100110110110001101110001;
   symbol[ 41] = 'b10110100111100101000101111010000000110111100100100110;
   symbol[ 42] = 'b11011111101011011101111011100001001101111111011010111;
   symbol[ 43] = 'b01100000110010111101000001001000011001110001011000010;
   symbol[ 44] = 'b00010010111010100111111011111111011010001100111111101;
   symbol[ 45] = 'b00000000101110010110101110001000000110000000100011111;
   symbol[ 46] = 'b11111110001011111110110010101001101101010100101010010;
   symbol[ 47] = 'b10000010111001111111000110001001000111011011100010111;
   symbol[ 48] = 'b10111010001101111001001011111111101011011100111110111;
   symbol[ 49] = 'b10111010111110010111011011010101111111001001101101100;
   symbol[ 50] = 'b10111010000000001001000011010101010010101100000011000;
   symbol[ 51] = 'b10000010000110010100011110011010111011101011100000010;
   symbol[ 52] = 'b11111110111011101000001110010111110010100000110101110;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
