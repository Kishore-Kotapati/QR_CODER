package TbSweep110;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep110(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110011010111101011001001001010000011110001111111;
   symbol[  1] = 'b10000010010110111001110000111000001101001111001000001;
   symbol[  2] = 'b10111010011001110111000001111111010001100101001011101;
   symbol[  3] = 'b10111010000001110101110010000101100111100010101011101;
   symbol[  4] = 'b10111010000011011101100011111111011000010010001011101;
   symbol[  5] = 'b10000010100111011111111010001101111100010110001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000011101110110001110001000110110000000100000000;
   symbol[  8] = 'b10010110101111011001100111111101000001101001010100000;
   symbol[  9] = 'b00111100000110011010001100110110011011011101111101101;
   symbol[ 10] = 'b10101010111001100011101001101001100001001011111111100;
   symbol[ 11] = 'b01011000110011011011111111100111101111100000101011010;
   symbol[ 12] = 'b01000011000101000111110001001101100110000111010111110;
   symbol[ 13] = 'b01000000101110101001101101010101011000100100101011110;
   symbol[ 14] = 'b10011011010100110101011000101000101011010000011011010;
   symbol[ 15] = 'b01010001101111100111101010100010001011010100100100010;
   symbol[ 16] = 'b01010010111101100100110011001111110011101110000101010;
   symbol[ 17] = 'b11101100110010110001111110001101100000100101101110000;
   symbol[ 18] = 'b11111111100110110100010111110100010110011010100100010;
   symbol[ 19] = 'b10100001010011001101000001101101100001111000010111001;
   symbol[ 20] = 'b10111011001110010001111101111100110010100101010101101;
   symbol[ 21] = 'b10111000010100111110000000111011100111101110010011110;
   symbol[ 22] = 'b10110010000001101100101100111000100001101011110101001;
   symbol[ 23] = 'b10010000010101011010111101011001111111011000100110101;
   symbol[ 24] = 'b01111111100000011000000111111111110111111110111111101;
   symbol[ 25] = 'b10101000100101011000000010001001110110101000100010001;
   symbol[ 26] = 'b01101010111000000011001010101101110000101110101011001;
   symbol[ 27] = 'b11101000111010001110000110001010011011110010100010100;
   symbol[ 28] = 'b10101111100101011111110111111100011111110010111110111;
   symbol[ 29] = 'b01111001100000010010101001001110100000000000011000011;
   symbol[ 30] = 'b10111011011011110000010111000010111000110111011101011;
   symbol[ 31] = 'b00000001111110000101010010001111101001101000001101000;
   symbol[ 32] = 'b01010111010001000010011100001100101001111011001000101;
   symbol[ 33] = 'b01110100111101100101011110000011010010110001110011101;
   symbol[ 34] = 'b11010011111110101001010010100111111000101100100010110;
   symbol[ 35] = 'b10010100110101000011100101110111010110101010111110010;
   symbol[ 36] = 'b00111011110011101010001000010000111001000101000110000;
   symbol[ 37] = 'b10110100110110010111100011011110001000000101101000010;
   symbol[ 38] = 'b00100011001111101010111011101011111111000111110101100;
   symbol[ 39] = 'b01000001100011110011100100001000110000011111011010010;
   symbol[ 40] = 'b10110010101010111000101001101101101100101000011001110;
   symbol[ 41] = 'b00001000111001011100001110111100011100100100011110011;
   symbol[ 42] = 'b11011110100010101110001101010101010111100110111101010;
   symbol[ 43] = 'b01100000010000011110111101100001001101110111001111101;
   symbol[ 44] = 'b00010011011011010001001111111001101000111111111111100;
   symbol[ 45] = 'b00000000100000110011000010001111000000110000100011010;
   symbol[ 46] = 'b11111110011101000010100010101000100001011101101011111;
   symbol[ 47] = 'b10000010101111111110011110001010110001110011100010011;
   symbol[ 48] = 'b10111010011011000101101111111110100011100100111111011;
   symbol[ 49] = 'b10111010110110110001011000110110000100000100110011111;
   symbol[ 50] = 'b10111010011100100010100110011001100001100101100010000;
   symbol[ 51] = 'b10000010011011010100000001011100100100001000111101011;
   symbol[ 52] = 'b11111110101010011010101010011000010010000000110010000;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
