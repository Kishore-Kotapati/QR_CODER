   symbol[127] = 'b01011101101000011101011110111111111011010000011100011111100010110110000101001111101110000101001001100010010000011000111110110010000101100;
   symbol[128] = 'b11111011110001001110110011111000001010000100001010111111011010011000011110101111110011010010010100010111111010110010000100011000111110010;
   symbol[129] = 'b00000000101010100101101010001001110101010011110100100010100000110010100000001000101010000010001010000010001010011010001110011011100010010;
   symbol[130] = 'b11111110101010101001001110101010101000000010101001101011001110011011001110011010111101010111111101010010101000110000100000110000101011001;
   symbol[131] = 'b10000010001001011101101110001001111101010111111100100011100100110001100100111000101000000010101000000010001110011011011110011010100010011;
   symbol[132] = 'b10111010110000101111110111111000001110000010001010111111011100011011011110011111110101010111110101010111111100110001100101110000111111001;
   symbol[133] = 'b10111010101010000100001001111101110011010111110101000000100010110000100001100010001110000010001011100010111100011011001111111011010111110;
   symbol[134] = 'b10111010101011101001111001010000101110000010101001101111001000011011001111110111111011010111111100110111010010110000100001010000000010110;
   symbol[135] = 'b10000010101000011101111110111011111011010111111100100101100010110001100101010100101110000010101001100011111000011011011110111011010111111;
   symbol[136] = 'b11111110110001001111110100111000001110000010001011111111011000011011011110101001110011010111110100010111110010110001100101010000000010010;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
