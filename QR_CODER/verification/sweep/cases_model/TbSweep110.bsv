package TbSweep110;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep110(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110011111010010100010101000110111001100001111111;
   symbol[  1] = 'b10000010001101100111010001110111000101100000001000001;
   symbol[  2] = 'b10111010000110000010010000001001011001000100001011101;
   symbol[  3] = 'b10111010000010111110110010001000000110111000001011101;
   symbol[  4] = 'b10111010001100001101100011111111111101010100001011101;
   symbol[  5] = 'b10000010110111010011001010001110010100110000001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000000111010011011010001110101010111110000000000;
   symbol[  8] = 'b10010110111100101100101011111111011000101000110100000;
   symbol[  9] = 'b10001100011100010111000001010101000101011110011110100;
   symbol[ 10] = 'b10010011010100011110100110011011110100110000100001000;
   symbol[ 11] = 'b01011100111111001010000010101001101000101010000010101;
   symbol[ 12] = 'b01000111001011000111000101001001001111001010101001111;
   symbol[ 13] = 'b00110101001100110111011101101111010010001001110110001;
   symbol[ 14] = 'b01101111111011010110101101100100000011100000110000001;
   symbol[ 15] = 'b01011101000111111010101001110000011000011010111101011;
   symbol[ 16] = 'b00010011101011000001010100100100101000001101111111110;
   symbol[ 17] = 'b00100000000001010010001110110110000110110001011010011;
   symbol[ 18] = 'b01110111001001101100101110111101100100001101100101011;
   symbol[ 19] = 'b10110000101101110100001111011010001011010110100100011;
   symbol[ 20] = 'b11101111100100100111100110100010011010101010011110111;
   symbol[ 21] = 'b01100000010011111111101110110000001010111000101111011;
   symbol[ 22] = 'b00001111010010010011110110110101100001000001001101011;
   symbol[ 23] = 'b10101000010111101111101111101011101111011101111100100;
   symbol[ 24] = 'b11001111100111111000000011111101100011001111111110101;
   symbol[ 25] = 'b11001000101000111101101010001110011110001101100011110;
   symbol[ 26] = 'b01101010101110011001101110101110011101110101101011010;
   symbol[ 27] = 'b01011000110000011000111110001100011011001110100010111;
   symbol[ 28] = 'b10111111111011010001010011111100011000101101111111101;
   symbol[ 29] = 'b11111101101100011011110000000110100101000101010110111;
   symbol[ 30] = 'b01010011110100010001001110100011110011011000000001000;
   symbol[ 31] = 'b11100000111010101010110001000000100100011111010110110;
   symbol[ 32] = 'b00011011010110001110000101111110010011001101111010001;
   symbol[ 33] = 'b01001101000000100010010010100111001100100110010001101;
   symbol[ 34] = 'b10010011110000101011011010101010000100000101011000010;
   symbol[ 35] = 'b01101100100100111100110101101011000011100101010100001;
   symbol[ 36] = 'b11101110001100011000001000100110001111001001110010101;
   symbol[ 37] = 'b10010101010111110100110111010000110111110110111011101;
   symbol[ 38] = 'b11100010010101101111001011101100111011011010100111000;
   symbol[ 39] = 'b11100100111001011000011100101111001110100111111100010;
   symbol[ 40] = 'b10000010101000100101000010000110100011000011111101100;
   symbol[ 41] = 'b10001000001100110010011111010010000100000000001011110;
   symbol[ 42] = 'b00000011000111110001110011110101001010000101111001010;
   symbol[ 43] = 'b00000000110001010000000111100001100111110110110100001;
   symbol[ 44] = 'b00000011000110100001000011111100000011010001111110011;
   symbol[ 45] = 'b00000000101011011010111010001101110100000001100011010;
   symbol[ 46] = 'b11111110010101110000101110101100000010110001101011110;
   symbol[ 47] = 'b10000010111000100000110010001010010010011100100011101;
   symbol[ 48] = 'b10111010000110101111101111111101111011111110111110110;
   symbol[ 49] = 'b10111010100101010110111100101001001111011100110011011;
   symbol[ 50] = 'b10111010001000110011001101000000001100001010000001000;
   symbol[ 51] = 'b10000010011100000111110001110000101000111101001010111;
   symbol[ 52] = 'b11111110110000100101011111010100010111000101101010100;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
