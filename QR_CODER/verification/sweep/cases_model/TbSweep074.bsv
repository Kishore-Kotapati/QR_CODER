   symbol[170] = 'b111111101111110001001110101110101110010110111000011101111010100001001011100011101111101010000111001101100111110110101011011111101010111111111010110011011001110011011001101011000;
   symbol[171] = 'b100000101001101111110010110110001110001001101110101100001000110111110111010001000110100011010111111001000101001010001000111100001001011100001000110000111010010000111011100010100;
   symbol[172] = 'b101110100011111101010111110011111111110100011001000011111111110000111011001000010111111110010000101001111101010011111000100100101000100100101111101000100000101000100000111110111;
   symbol[173] = 'b101110101100001011000110101010000000101111011101100000100000100100010101000000000111100110111111011000001100100101011001111101011001111101001011000100011011011100011011011101111;
   symbol[174] = 'b101110100011000000010010110101000111011001100101010110110000101000000010101010100111101011000010000011101111001111011100010110111100010110101000100101110000111101110000111100001;
   symbol[175] = 'b100000101100000101110011110000110100011010001000111110110111010101100101000111010101000001110111101110110110000111100100101110000100101110010000011101001000000101001000000100101;
   symbol[176] = 'b111111100000001110001110010010010100101011011100011011000111011011100000111011001101000110111111110101000111110010000101111111100101111111100011100100111011110100111011110101100;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
