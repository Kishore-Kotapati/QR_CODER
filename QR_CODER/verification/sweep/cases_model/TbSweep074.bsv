   symbol[167] = 'b000000001111011110111000101011101111000001010111100101111011101110111110011010001110000110101100110101101101011000001111110101011111110101010001100110010011010110010010001011101;
   symbol[168] = 'b000000111001000111001111011111111101100010010101010010001111110010101001110110000100111111110110111100001110111111111100110110101101110110111111101101110010110101110010111110101;
