package TbSweep081;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep081(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101111010001100000001100101110110100010100001111111;
   symbol[  1] = 'b100000101101010010110100100010001100110110111000001000001;
   symbol[  2] = 'b101110100010011100010000101011001010111100100000001011101;
   symbol[  3] = 'b101110100001100001101110001011110001000101100000001011101;
   symbol[  4] = 'b101110100000001110000111101111100010011110101000001011101;
   symbol[  5] = 'b100000100101000110001001111000101001000111100100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000111101101010001101000101001111101100001100000000;
   symbol[  8] = 'b010000111000011110101011111111110000101100011000110000011;
   symbol[  9] = 'b111001001010000000111101100110011011110111100011010000111;
   symbol[ 10] = 'b111100100100110111101001000101101000100100111000000011000;
   symbol[ 11] = 'b000101001011111001010100100010011111111000100001000011110;
   symbol[ 12] = 'b110110100000110111111010101010100101100000100110101011011;
   symbol[ 13] = 'b111000011110001001000011001001100111100010101000100101000;
   symbol[ 14] = 'b101110100111010010101010011010000100110011111111110110011;
   symbol[ 15] = 'b101011001001111010111010110001000010110111011010110011000;
   symbol[ 16] = 'b001101111100110101101101110101111001001100000000101010111;
   symbol[ 17] = 'b111000000010011000010011001100011110011101010001011011001;
   symbol[ 18] = 'b011001111110001001110011011010001000011111111011011001011;
   symbol[ 19] = 'b110111001011111001110100100001001011100000100111011001001;
   symbol[ 20] = 'b100001101011111111111001110111111000110011111011011010101;
   symbol[ 21] = 'b111100010100010111110110000010010011101000100111100001001;
   symbol[ 22] = 'b110011100111000010110000111101010000110011111010000010000;
   symbol[ 23] = 'b110000000011100110100000000100001101011100110000011101010;
   symbol[ 24] = 'b001110100111001000100100100111101101110000111011010111111;
   symbol[ 25] = 'b110101000011100100000011010011011110011010110000111101010;
   symbol[ 26] = 'b011011111101111011101101101111101100100001100000111111100;
   symbol[ 27] = 'b000110001001011101011001001000101101101111001101100011011;
   symbol[ 28] = 'b100010101011101110100011111010101100110100111111101011100;
   symbol[ 29] = 'b010110001110010101011000011000110011100100101111100011010;
   symbol[ 30] = 'b011011111111110000111001111111101011101111100110111111011;
   symbol[ 31] = 'b000001000100011110100110001101101110101000100000100001010;
   symbol[ 32] = 'b100111100000011110001101101101110001010111111000000100100;
   symbol[ 33] = 'b100011010111010001011011011000110100001010111011111100001;
   symbol[ 34] = 'b000111110101111101100011101101001001000001101001100110011;
   symbol[ 35] = 'b101100010100010111100111011000101000100101001110010110001;
   symbol[ 36] = 'b010001101011110101010000111101001011101111010100111010100;
   symbol[ 37] = 'b011001001100110100110110000101111001000101000111010000010;
   symbol[ 38] = 'b000000101101101010100010111100111000010100111101100001100;
   symbol[ 39] = 'b111100010100010100111000000001011100100010111100011010111;
   symbol[ 40] = 'b001111101101011010100000111001111111000011100001110101100;
   symbol[ 41] = 'b111101010100111110101111101110110110000010110111001110111;
   symbol[ 42] = 'b010110100001110010111111101110011110000000111010011100111;
   symbol[ 43] = 'b110111000100010000010010000010111110111101010001100110111;
   symbol[ 44] = 'b001110100101111111001011010100001111011100000100000001110;
   symbol[ 45] = 'b111011001000100010011011101111110010010111011011111010000;
   symbol[ 46] = 'b000000101111010101010001110110110011011100100110100001011;
   symbol[ 47] = 'b000000001101101101000011100001000111100110100110010001110;
   symbol[ 48] = 'b000000110000011110011100001111100101101100100100111111000;
   symbol[ 49] = 'b000000001110100101001011111000101111100000101110100010100;
   symbol[ 50] = 'b111111101110001101100011111010111100110111111101101011111;
   symbol[ 51] = 'b100000100000101110011011101000101010010011001011100010100;
   symbol[ 52] = 'b101110100101010111001110001111111110001100001011111111111;
   symbol[ 53] = 'b101110100000000110010110101011101001011001010000110100100;
   symbol[ 54] = 'b101110100010111100101010011101100000111111101110101010111;
   symbol[ 55] = 'b100000101000011101100101101101010001111001000110010110101;
   symbol[ 56] = 'b111111100100010101010000000010100001000010011110110011100;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
