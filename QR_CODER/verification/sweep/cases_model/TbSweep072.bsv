   symbol[125] = 'b00100100011000010111101001000111110001000100000111011100111000100110010011101101111100010111011001110000100110001111111101111000010111110;
   symbol[126] = 'b00000010000110000100110101010101000011101000100101001000100101110001000010001111010110111101110001011101110111011011101100111101011101011;
   symbol[127] = 'b00000001111010001111001100101101101001000010001110001101110000100100010111011101111100010111011011110000000010001010101100101000010111110;
   symbol[128] = 'b00000010011100100011011011111101100111101001100111111110110111110101110011001111111110111111111001111011111111011111101001111101111111111;
   symbol[129] = 'b00000000111000110111111110001011100111000001100110100010110010100000110010011000111000010000011000010010001000001000011100001001100010000;
   symbol[130] = 'b11111110000111000100100010101111000101101111000100101010100011110110100011111010110000111010010000111110101101011101001101011101101010100;
   symbol[131] = 'b10000010111011001111111010001011101111000101101110100011110110100011110110101000111010010000111010010010001100001001001100001000100010001;
   symbol[132] = 'b10111010011101000010011111111101100011101111100111111110110001110110110011111111111000111010011000111011111001011100001000011101111110100;
   symbol[133] = 'b10111010011000010110011101101111100001000101100111010010110000100010110011110000011100010000011001110000101110001001011101101001000101100;
   symbol[134] = 'b10111010100110000100010100111101000011101111000100000010100101110110100010011010010110111010010001011010111111011101001100111101101111011;
   symbol[135] = 'b10000010111010001111101100101001101001000101101110110111110000100011110111000110111100010000111011110001101010001001001100101001000101110;
   symbol[136] = 'b11111110111100100010011001010101100011101111100110010010110101110110110011000100011110111010011001111010011111011100001000111101101111111;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
