   symbol[125] = 'b11011001011000010010010100100001100101111100010011000001100000001011001011100011100011100011100111100000111010010011100001100101000011100;
   symbol[126] = 'b00000011000110011100001111001011011111110100111000010100111001101101011110010011001011000001101101000001110111010110110100110001000001000;
   symbol[127] = 'b00000001101001011100111010010110001010100001101101111110010011000111110100111010011111110100111000010011101000101101011110001111110100010;
   symbol[128] = 'b00000010001101000111101111111110100110000010100110111111000101010010000001101111110101111110010010111011111100111100001010011010111110111;
   symbol[129] = 'b00000000111001110010000110001001110011111111110010100011101010101101101010001000100111101100100110100110001100010100000010010111100010010;
   symbol[130] = 'b11111110000111111100010010101111011001110011011000101010111111101010111111111010101101001110001100100010101101010000010101010100101010111;
   symbol[131] = 'b10000010101000011100110010001000001100100110001101100010010101000000010101001000111001000011011001110110001110101110011010101011100011101;
   symbol[132] = 'b10111010101100100110000111111000100010000100100010111111000011011001000001011111110010100011110011111011111010111110101111111000111111100;
   symbol[133] = 'b10111010011001010011111100111001110101111011110111101011101000110111101011101001000011000100100111101101110010010100000100110111011011101;
   symbol[134] = 'b10111010000110111100100001011001011111110011011000111110111001111010111110000101001000000110001101011110100111000000010101010011111011011;
   symbol[135] = 'b10000010101011011100100001001100001010100110001100010100010011001000010100101101011100110011011000000010001000110110111110101110000110001;
   symbol[136] = 'b11111110101011000110000111101100100010000100100111100001000111010001000001100111010010011011110010100011101100101011101011011110001100101;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
