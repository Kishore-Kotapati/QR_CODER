   symbol[ 64] = 'b0000001110000000101101001111111001100110111011111001101010111110111111001;
   symbol[ 65] = 'b0000000010101111011100101000101010000011010010001010000001010100100010001;
   symbol[ 66] = 'b1111111001101001001100001010101001111000000110101111011111000101101010100;
   symbol[ 67] = 'b1000001011110000111100101000101001101111000010001110010001001101100010010;
   symbol[ 68] = 'b1011101000111111101101111111111101111100111011111101110000100100111110000;
   symbol[ 69] = 'b1011101000111110100110011000001000111110110000001000111011111100010111001;
   symbol[ 70] = 'b1011101000111000010011011101111111100110010110000101100111101100101111101;
   symbol[ 71] = 'b1000001000010101111101010001001011110000110101101010001000000101001101111;
   symbol[ 72] = 'b1111111000010101011100000101101111010000001111010111000101101001010101111;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
