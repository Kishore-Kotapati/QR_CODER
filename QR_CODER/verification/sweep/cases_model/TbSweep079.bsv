package TbSweep079;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep079(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101101101111100001111010010100001111111;
   symbol[  1] = 'b100000100111000100110011001000100100001000001;
   symbol[  2] = 'b101110100010111111101000010111000100001011101;
   symbol[  3] = 'b101110100100110110101011011100001000001011101;
   symbol[  4] = 'b101110100010001100111111101110011100001011101;
   symbol[  5] = 'b100000100101011111111000110101100100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001011110001111000100000101110100000000;
   symbol[  8] = 'b110110100101001110101111111001110100101000001;
   symbol[  9] = 'b011011010001101101110011110000111100100111011;
   symbol[ 10] = 'b111110100011001110011001101010101101101101001;
   symbol[ 11] = 'b110110000000110101000010111111100101111110011;
   symbol[ 12] = 'b000011111111111110001011110110100100010111111;
   symbol[ 13] = 'b001000000010001110111001100100110111100101001;
   symbol[ 14] = 'b000001100100110101000010110111101110010110110;
   symbol[ 15] = 'b010101001001111100001011101101001010110010111;
   symbol[ 16] = 'b111110110101101000011001111101010001110101001;
   symbol[ 17] = 'b110001001110010011100101100000001010111111100;
   symbol[ 18] = 'b000001111001000011111100001001100011011110110;
   symbol[ 19] = 'b010101001110110001100110011001001001011000100;
   symbol[ 20] = 'b010111111000101010111111100000010011111111101;
   symbol[ 21] = 'b010010001110001011111000101000011010100010101;
   symbol[ 22] = 'b000110101111110011111010111010101001101011110;
   symbol[ 23] = 'b101010001100101110111000111111110101100011101;
   symbol[ 24] = 'b100011111100100111111111110010111100111110000;
   symbol[ 25] = 'b100100001100111111110001000010101110101111010;
   symbol[ 26] = 'b000000101111110101000110110111110110010100001;
   symbol[ 27] = 'b101111010010100100010011010111101100011101010;
   symbol[ 28] = 'b001100100000101100010101000100110111110001100;
   symbol[ 29] = 'b101010011011100101110000011111101101111000110;
   symbol[ 30] = 'b110101110110111100001110111110100110001011011;
   symbol[ 31] = 'b001100010000101110001100111101001001011011001;
   symbol[ 32] = 'b000011111100110011011111100110000010101011010;
   symbol[ 33] = 'b101011010101011010101110101111001010000010100;
   symbol[ 34] = 'b000000100111010001100100111101111001110000111;
   symbol[ 35] = 'b000000010100001010100111100011110011000011101;
   symbol[ 36] = 'b000000110011100011111111101000011011111110111;
   symbol[ 37] = 'b000000001011011001111000111010101001100010111;
   symbol[ 38] = 'b111111100100001010111010100000110010101010001;
   symbol[ 39] = 'b100000100001000011111000110010111100100010000;
   symbol[ 40] = 'b101110101010110101111111100010101110111110110;
   symbol[ 41] = 'b101110101101100100101010111001110100101110000;
   symbol[ 42] = 'b101110100110111100100011111000111111100101011;
   symbol[ 43] = 'b100000101110101111011110100100111111111011001;
   symbol[ 44] = 'b111111101001110011001101011111101100100010110;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
