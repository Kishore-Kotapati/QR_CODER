   symbol[140] = 'b0010111101001010111110100001010001100110000001100010100101011011101110111010001110010111011101110111011100101010101110111010001010110011001100110011110000101;
   symbol[141] = 'b1101010010110100010100011111100010000111111001110110011111110001000100010001000100111101110111011100110110001000100100010001000010110011001100110100111110110;
   symbol[142] = 'b1010101101100011100111110101000000001101001000100011101000011011101110111010001010110111011101110110111101000100010111011100101000010001000100010111110110010;
   symbol[143] = 'b1100010000110111100000001011000011001101001101110111010111110001000100010001000011000100010001000101110101101110111101110111100010111011101110111101110100111;
   symbol[144] = 'b0000001101001010111110100001010111100110000001100010100101011011101110111010001001101110111011101110111101001100110011001101110010110011001100110111110010110;
   symbol[145] = 'b1110110010110100010100011111100100000111111001110110011111010001000100010001000011000100010001000101010111001100110011001100111010110011001100110010111010100;
   symbol[146] = 'b0000001101100011100111110101000000001101001000100011101111111011101110111010001111101110111011101110011100100010001000100011010000010001000100010001110000001;
   symbol[147] = 'b0000000000110111100000001011000001001101001101110111010101110001000100010001000100110011010101000100010100001000100010001001010010111011101110111011110010100;
   symbol[148] = 'b0000001101001010111110100001111111100110000001100010111111011011101110111010111110010001011101101111111110101011101110111010111110110011001100110011111110101;
   symbol[149] = 'b0000000010110100010100011110100010000111111001110111100011110001000100010000100010111011110111000100100010001001000100010000100010110011001100110011100010110;
   symbol[150] = 'b1111111001100011100111110100101010001101001000100011101010011011101110111010101010110011011101101111101011000101110111011100101010010001000100010001101010010;
   symbol[151] = 'b1000001000110111100000001010100011001101001101110111100011110001000100010001100011000100010001000100100011101111011101110111100010111011101110111010100010111;
   symbol[152] = 'b1011101011001010111110100001111111100110000001100011111111011011101110111010111111101110111011101110111111001100110011001100111110110011001100110011111110110;
   symbol[153] = 'b1011101000110100010100011110001000000111111001110111011011010001000100010000010001000100010001000101000011001100110011001101010100110011001100110011001100110;
   symbol[154] = 'b1011101011100011100111110100011010001101001000100010100001111011101110111010111011101110111011101111101001000010001000100011011100010001000100010001000100001;
   symbol[155] = 'b1000001000110111100000001010011111001101001101110111110111110001000100010000010100110011001001000101000011101000100010001001110110111011101110111011101110100;
   symbol[156] = 'b1111111011001010111110100001011111100110000001100010001001011011101110111010111100010001000011101111101011011011101110111011011100110011001100110011001100101;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
