package TbSweep063;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 41 N;
(* synthesize *)
module mkTbSweep063(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110000011100011111010000011001111111;
   symbol[  1] = 'b10000010110000111110110000101010101000001;
   symbol[  2] = 'b10111010010010011001100110111111101011101;
   symbol[  3] = 'b10111010001010101101100010111101101011101;
   symbol[  4] = 'b10111010001111000101111100001000101011101;
   symbol[  5] = 'b10000010111001110010111101010011101000001;
   symbol[  6] = 'b11111110101010101010101010101010101111111;
   symbol[  7] = 'b00000000110000111001011000000110000000000;
   symbol[  8] = 'b00001111001000110101101110111011101100010;
   symbol[  9] = 'b01000101011001011000001011100101000101110;
   symbol[ 10] = 'b10001111011000100101000101010011010111111;
   symbol[ 11] = 'b11100000001111100001000100011001100010101;
   symbol[ 12] = 'b11011011001010001010010011101000111111100;
   symbol[ 13] = 'b10100000001110110101100100000011000010000;
   symbol[ 14] = 'b00101011010111101100011110010111010000100;
   symbol[ 15] = 'b10111100000111011001110000011111100101110;
   symbol[ 16] = 'b00011011100100110001110110100110011011111;
   symbol[ 17] = 'b00011100110101011011001001001101101101111;
   symbol[ 18] = 'b10101011111100101100000111001010100111001;
   symbol[ 19] = 'b10101001101001110001100000000110010010000;
   symbol[ 20] = 'b11100010101010011010010010010001111010111;
   symbol[ 21] = 'b11100001011110100101110101011111000100010;
   symbol[ 22] = 'b11111010011110111110011110010011011110111;
   symbol[ 23] = 'b11110101000110111011111001000001101011110;
   symbol[ 24] = 'b10100111010110101101101101010000000111100;
   symbol[ 25] = 'b01111101111010101001011010001011110010000;
   symbol[ 26] = 'b10000010100101011010001011001100101001100;
   symbol[ 27] = 'b10010101110001000000100000100110010101110;
   symbol[ 28] = 'b11111111101001001100100011010011010000011;
   symbol[ 29] = 'b11001100100001011111000100101101101010010;
   symbol[ 30] = 'b00100110000110000000011111001010110111011;
   symbol[ 31] = 'b00111001000001111011001011100000000100110;
   symbol[ 32] = 'b11100110000100101100100010110001111110100;
   symbol[ 33] = 'b00000000111010011000011110011011100010000;
   symbol[ 34] = 'b11111110111101000010010001011100101010100;
   symbol[ 35] = 'b10000010111101010000001010111110100011110;
   symbol[ 36] = 'b10111010111001010100000001010011111111111;
   symbol[ 37] = 'b10111010001000001010010010101000010010000;
   symbol[ 38] = 'b10111010010111100000000110001100010101011;
   symbol[ 39] = 'b10000010011001000111010101100111111110010;
   symbol[ 40] = 'b11111110001101110001010101011010010100000;
   Integer n = 41;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
