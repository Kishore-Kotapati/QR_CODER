   symbol[136] = 'b0100111001101111011010000101010001010010100111000010000001111111001010011110101101000010011111001010011111101000000111100000010110011111101001010011010110010;
   symbol[137] = 'b1100010000110111000111101101010110010101101011100100001011000011010110000011010001001110000011010111100111011110100001000111101000100001011110100000101000111;
   symbol[138] = 'b0100101101110010000111110100000000010101001000100011101001111011101110111010001111110110111011101111111000100010001000101101010000010000000100010111110000011;
   symbol[139] = 'b0111000100010010100100101111100101111001101001010011110101010101100000110101100000010001110001110001110100101100000110111111110110011111101010011101010110011;
   symbol[140] = 'b0100101011011000101100110011000111100100010011110000110001001001111100101000011100000101000011000100101010111000111100101100011110100000011110100101100010100;
   symbol[141] = 'b0101010000110100010100011111100010000111111001110110011111110001000100010001000100111101100001111100110100001000100100010001000000110011001100110100111000110;
   symbol[142] = 'b1110001001000111000011010001100000101001101100000111001100111111001010011110101110010011110110110010011111100000110011111000001000110101100000110011010110110;
   symbol[143] = 'b1110000100100101110010011001010001011111011111100101000101100011010110000011010001010110000010010111100111111100101111100101110110101001100100101111100100101;
   symbol[144] = 'b0011011101001010111110100001010111100110000001100010100101011011101111011010001001101110111010001110111101000100110011001101110010110011000100110111110010110;
   symbol[145] = 'b1010010110010000110000111011000000100011001110010010111011110101100000110101000111100000110100000001000011110000010111101000011110010111101000110110011110000;
   symbol[146] = 'b0000001111110001110101100111010010011111011000110001111101101001111100101000011101111100101000011100110110100000011010110001000010000011010110100011100010011;
   symbol[147] = 'b0000000000110111100000001011000001001101001101110111110101110001000100010001000100110010011101000100010010010000100010001000010010111011101110011011110010100;
   symbol[148] = 'b0000001001101110011011000101111111000010110110000111111110111111010010011110111110110100100001001010111110001111001010011111111110010111101000010111111110001;
   symbol[149] = 'b0000000010100110000110101100100010010101100011100100100010100011001110000010100010101000101101010110100010011011010110000010100010100001011110100001100010100;
   symbol[150] = 'b1111111001100011100111110100101010001100111000100010101010011011110110111010101010111010011101101111101011000101110111011100101010010001000101010001101010010;
   symbol[151] = 'b1000001010010011000100101110100011101001101001010011100011010101101000110101100011100000110001100000100011001011111001010011100010011111001011011110100010011;
   symbol[152] = 'b1011101001001000101100110011111111110100000011110001111111001001111100001000111111111100101001111100111111011110100001011110111110100001011111100001111110100;
   symbol[153] = 'b1011101010111100010100011110001001010001111001110110111011010001000100010000010001000100010101000101001101001100110011001101010100100011001100100011001100110;
   symbol[154] = 'b1011101001001111000011010000111111010101101100000110000101011111001011111110011111001010011001001011001010100000101101100111111000110001100001101101100110101;
   symbol[155] = 'b1000001000100101110010011000001100011001011111100101100101100011010111000010000110100001011011011101010111111110110001111011100100100011111101110001111110100;
   symbol[156] = 'b1111111011001010111110100001011110111100000001100010001001011011101110111010111100010001000011100101101001110101101000011011011100111101001100100011001000111;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
