   symbol[170] = 'b111111100101101101110010110010101010101010011010000001111010111101010011111111110011101011100011010101100001001010101111000011110010100100001010101111001100001111001100101011011;
   symbol[171] = 'b100000100000111010110111100010001010011100010101111001001000100010100100000100010011100010000010101101010000011110001101101001011011100101111000100101110111100100010111100011110;
   symbol[172] = 'b101110100011111010110000110111111001010011011010000100101111100110111100001111010000111111010111101110111010010111111111100011101101011011001111101111100111001110111111111111111;
   symbol[173] = 'b101110100101110111011010110100011100110011000000011100100010101000001001011100011011111010100011000100110000111001000101100001000101110001101111011000000111100000100111000001100;
   symbol[174] = 'b101110101111110101000111100000010010001100110101000011100011111100011111111111110010111110010111010111111010011010101101000011101001111011100011110000100101101001100101101001011;
   symbol[175] = 'b100000101011000010110100110001110011011101001100011001110010001010001010000000000010000110110000101001110001000001000011101001000010110001000001011010001111100010001111000011101;
   symbol[176] = 'b111111100100010010010010001010001000110111000010100111011011000111111110100111001001011010100011101001011011101111110001100011111000001011110001111000100110001000000111101001111;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
