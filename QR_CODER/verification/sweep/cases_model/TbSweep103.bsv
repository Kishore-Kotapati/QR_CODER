   symbol[141] = 'b1011100001111111011011110100010100111101000110001100101010011011101110111010100111010111011101110010011100000100000110011001101010010001010100010111110000010;
   symbol[142] = 'b1101111100101110010100111100001110001100100110001000100010111001100110011000111010111110111111111001010111101110110101110110000110111011101110111101011000111;
   symbol[143] = 'b0010110100100100111100101000110110001100001110011100011000111001100110011001110000111111111111100111011101000100011111011100000100010001011100010110010110010;
   symbol[144] = 'b1111101011100000101000001011010111101000010110001100010000010001000100010000010011011101010011000100011111101110100011101111000010111011100110111111011010111;
   symbol[145] = 'b1000000001011111010001010100010001111111011110001100010010111011101110111010010001111111011011101111111101000101011001000100001000010001000100010000010000000;
   symbol[146] = 'b0000001100101010010011011000001000111110111110001000010101011001100110011000100110101111011101100111110110001001100010001001100010111011101110111011011010100;
   symbol[147] = 'b0000000100100000111011001100110010101100010110011101011010111001100110011001101110010001011101100110111100100011001000100010111000010001000100010000010000001;
   symbol[148] = 'b0000001011100010101001101001111111010110001110001100111110010001000100010001111111111011110111000101111110001001100100011000111110111011101110111011111110100;
   symbol[149] = 'b0000000011011101010001110001100010100101011110001101100010011011101110111010100010110001011101101110100010000001100010011000100010010001001100010001100011010;
   symbol[150] = 'b1111111010101110010010111101101010000100111110001001101010111001100110011001101011111011111111100111101011101111011111010110101010111011100110111011101011111;
   symbol[151] = 'b1000001000100100111010001010100010011100010110011100100010111001100110011001100011100010100001100100100011000101110100111101100010010001001100010000100010010;
   symbol[152] = 'b1011101001100000101000101000111111111000001110001100111110010001000101110000111111000100110000000111111111101111111010101110111110111011101110111011111110011;
   symbol[153] = 'b1011101001011110110001010111001000111101011110001101101110111011101111111010111011101101010010101011100000000101010000000101000100001001000100001001000010000;
   symbol[154] = 'b1011101010101110010011011100101110001100111110001001001101000001100111011000011001100101001000000001000010101111100010101001101110100011100110111011101010111;
   symbol[155] = 'b1000001000100101011011001001010110001100010110011101001100110001100110011000011100011011000001100111101001000111101000000011000100010001011100000001000010010;
   symbol[156] = 'b1111111011100000101001101011001101101000001110001101000110011011000100010000010110100101101001000101100101111001100010011001110110101011101110101011101110111;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
