   symbol[124] = 'b11011011111001001110010111001001001011110100010110011010111010100000010000101101010010001011100010010110100011001010011010010111001110010;
   symbol[125] = 'b10101000101100100011110101010000010100001011100010110000010001011010111010010010010011110010010110010001001011000010010000010100110010010;
   symbol[126] = 'b00000011001000111010011001000011110001111010110110011010110111100011010000011101000100101111100011001111100000011000111010100111001111001;
   symbol[127] = 'b00000001100111010010100110011000100100101111100011110000001101001001111010110000010001111010110110011101111110100011010000001001111010011;
   symbol[128] = 'b00000011111100110110010011111001010111110011010101111110101100100011110000011111100100001111100011001011111101001101111011110111111111001;
   symbol[129] = 'b00000000101000000011101010001100000010001110000111100010011011011100011011111000110111110101010111110110001101101101110001110100100011000;
   symbol[130] = 'b11111110101001110010011110101001010111111001010110101010110001100100110001111010100010101000000010101110101011010110011011011110101010010;
   symbol[131] = 'b10000010000110010010111010001110000010101000000001100010011011001110011011001000110111111101010111111010001000111000110000100001100010100;
   symbol[132] = 'b10111010111101010111110111111001010011111111110111111110110010101000110000101111100010001010000010001011111011011110011010001111111111010;
   symbol[133] = 'b10111010101000100010001001001000000100001101100010011010011001010110011011011101010011110101010110010100000011100100010000000100101010000;
   symbol[134] = 'b10111010101000110010101111010111010000110101100110010000110111111100110000101010000100101000000011001000101000011111100010111111110100011;
   symbol[135] = 'b10000010100101010010101111000010000101000001110011011010011101010110011011100011010001111101010110011100000110100000110000000000001001101;
   symbol[136] = 'b11111110111010110111110110011101010110110100100110010000110110110000110011010110000100001010000011001010011101001110001010101111111101011;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
