package TbSweep065;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep065(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110101010100001001000011110110100010100001111111;
   symbol[  1] = 'b10000010101110111000000011010100010111000100001000001;
   symbol[  2] = 'b10111010001110101001011001000011101010110000001011101;
   symbol[  3] = 'b10111010111110101011110011110001001011100100001011101;
   symbol[  4] = 'b10111010001110110010111011111101010011011100001011101;
   symbol[  5] = 'b10000010010110110100011010001010001011111000001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000111001110001110010001100011110001000100000000;
   symbol[  8] = 'b10110111011001010000010111111011000000011110101001011;
   symbol[  9] = 'b11110001111010100010010110101011000110110110010010101;
   symbol[ 10] = 'b11010011111110001011100111100010001001000000011110000;
   symbol[ 11] = 'b10010001111001000001011000001110001001010100011001001;
   symbol[ 12] = 'b01111110000011011111011101000110110110110001000110110;
   symbol[ 13] = 'b10100000001101100011101100010101000001100001111010011;
   symbol[ 14] = 'b10000011011101001011011001011110000010000011101100101;
   symbol[ 15] = 'b01111101010001100011010110010001010000101000010000001;
   symbol[ 16] = 'b10011011100011010101010101011101101001010011100000000;
   symbol[ 17] = 'b10110000000100100000100110001001001101101100111100111;
   symbol[ 18] = 'b10001111111010111001000001000001001100111001101011100;
   symbol[ 19] = 'b01000100011010101111001000111011110011001100111110100;
   symbol[ 20] = 'b11111111101001000001011111100110001000011110110100101;
   symbol[ 21] = 'b00010001000001000010010100101010010000010110000010101;
   symbol[ 22] = 'b00000011010010101000100000000011011010010101011011111;
   symbol[ 23] = 'b01000001101100000110001111110011100001010101100000010;
   symbol[ 24] = 'b10101111100011111101000011111110011011000010111110011;
   symbol[ 25] = 'b01001000110011001011110010001001110000111101100010001;
   symbol[ 26] = 'b00011010110001110010101110101101010100110111101010101;
   symbol[ 27] = 'b11101000100111000000011010001001000101111101100010000;
   symbol[ 28] = 'b11011111101110111100010111111001010101100100111111101;
   symbol[ 29] = 'b10110001110001111001011111111000111000000111010100100;
   symbol[ 30] = 'b11010111001101010000000001100000110000000100010011110;
   symbol[ 31] = 'b01100100110011101001111110110110110110000101101000100;
   symbol[ 32] = 'b00001010001000110000011001010110000001011101011011111;
   symbol[ 33] = 'b11011101110101100100000000111110010001000110111011001;
   symbol[ 34] = 'b11011111011001110011101100000011011101001110010011110;
   symbol[ 35] = 'b01001101000100010011110000011000110111001010011110110;
   symbol[ 36] = 'b11011111000101011101000001001100000010100010111101110;
   symbol[ 37] = 'b00101101110100111100000010100101000010111000011011001;
   symbol[ 38] = 'b10100110000111100101110010001011110101111101011111011;
   symbol[ 39] = 'b01010100011100111010011001010011110100001001010100011;
   symbol[ 40] = 'b00010111110101101001000001111111101101010000001100011;
   symbol[ 41] = 'b01101001011011001010010011111100011100000100000100010;
   symbol[ 42] = 'b00000010100011110100101001010001111001000011000011110;
   symbol[ 43] = 'b00000000101110010100000110000100101010101011010011110;
   symbol[ 44] = 'b00000010000011101101011011111100011101011111111110101;
   symbol[ 45] = 'b00000000110100111000100110001111110111010101100010111;
   symbol[ 46] = 'b11111110101010011000101110101101111101111011101011110;
   symbol[ 47] = 'b10000010110011100111010110001011110110010000100010001;
   symbol[ 48] = 'b10111010011111101100110111111100001110110111111110101;
   symbol[ 49] = 'b10111010101101001010000110100000010101101100001111011;
   symbol[ 50] = 'b10111010111000110001111010111100100010111111001001100;
   symbol[ 51] = 'b10000010011101001010111011101101010101010011001001010;
   symbol[ 52] = 'b11111110101010101001011010110001110100110010000100110;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
