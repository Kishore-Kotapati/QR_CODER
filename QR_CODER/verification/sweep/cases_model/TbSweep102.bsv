   symbol[125] = 'b10101000010110011001110111001001011101001010001001010010110110101001011101110011110010011001010111011110101001000001110011110110011001111;
   symbol[126] = 'b00000010000110000100111101010101100011101000100101001000100101110101100010001111010110111101110000011101110111111011101100100101011101011;
   symbol[127] = 'b00000000011001101100101111001110101000100001101101101110010011000000110100110110011111110100111000110011100001001001001111010011110100010;
   symbol[128] = 'b00000010111000000111111011111000000011001101000011111110010011010000010111101111111010011011011100011111111011111011001101001101111111011;
   symbol[129] = 'b00000000110010011101010010001000101101101011001100100010011000001000011000111000110010111010110010111010001010100010010110111001100010111;
   symbol[130] = 'b11111110001110001101101110101111111100100010001101101011101010111111101010111010101001110011011001110110101100010101100100011010101011100;
   symbol[131] = 'b10000010010101000001110110001100001001001001100000100011111000101101111000101000110100011110110100011110001010000110100010010110100010000;
   symbol[132] = 'b10111010111101000010011111111101100011101111100111111110110001110110110011111111110000111010011000111011111001011101101000001101111110110;
   symbol[133] = 'b10111010111011110101111010001100011010100100000100110001010011000001010000010011111111110011111010010011001110101010111110111010100110000;
   symbol[134] = 'b10111010000010100000110000011001100111001011100000100110000001010010000110111110110010011110110101111111111010111001101001111001001011111;
   symbol[135] = 'b10000010110000100101000010000011000011101111000100011101011010001001011101101100010110111010010001011010100011000011100110000011101111011;
   symbol[136] = 'b11111110110101101011010000111100101010100110101111011011111100111111111010001101010111110011010000110011010110010101000001110100100110110;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
