package TbSweep034;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep034(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100110110100001010110111001100001111111;
   symbol[  1] = 'b100000101101011000110111001000111000001000001;
   symbol[  2] = 'b101110100010101101110010000100110100001011101;
   symbol[  3] = 'b101110101101111000100101010011100100001011101;
   symbol[  4] = 'b101110100100100101111111100111110100001011101;
   symbol[  5] = 'b100000101010111000111000110011000000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000111001101101000111100111010100000000;
   symbol[  8] = 'b111110111111011100111111101011100101110101010;
   symbol[  9] = 'b010100001111100011111101111110100010111110010;
   symbol[ 10] = 'b110111101100000111010000100011101001100010110;
   symbol[ 11] = 'b110001000111110010000101111000111010100001100;
   symbol[ 12] = 'b110000100011100101010000101101100110111101101;
   symbol[ 13] = 'b111000011010010010100101111000100011000000010;
   symbol[ 14] = 'b010011111111000111010000100101110100001100100;
   symbol[ 15] = 'b011100011110001010000100100001000101000000110;
   symbol[ 16] = 'b110111110100111001010000110100011000110100100;
   symbol[ 17] = 'b110110011001000100100011100001001101000000100;
   symbol[ 18] = 'b011000101100011000100110010100111000010101100;
   symbol[ 19] = 'b011010001000101101111011000101010101000100100;
   symbol[ 20] = 'b010111111101011000101111110010000001111111100;
   symbol[ 21] = 'b101010001110000101111000100111010100100011000;
   symbol[ 22] = 'b000110101010011000111010110010100000101010011;
   symbol[ 23] = 'b100110001010101101111000111100110010100011001;
   symbol[ 24] = 'b111011111111111100101111101011100111111110111;
   symbol[ 25] = 'b111001000110100011101100011110110010110011001;
   symbol[ 26] = 'b100011110111100111010011100011100100000110000;
   symbol[ 27] = 'b110010010110110010011111111000100010110011001;
   symbol[ 28] = 'b101011110101100101011011101101111110011100111;
   symbol[ 29] = 'b011100010110110010100101111000101010101010110;
   symbol[ 30] = 'b100010110101100111001101100101111100111111100;
   symbol[ 31] = 'b011001001100110010000000100001000100000010110;
   symbol[ 32] = 'b010001101110100001001101110100011111110001100;
   symbol[ 33] = 'b100101011011010100100000100001001011000100111;
   symbol[ 34] = 'b000000101100011000101101110100111001101001110;
   symbol[ 35] = 'b000000010011001101100000100101010100011100110;
   symbol[ 36] = 'b000000101100111000101111110010000001111111100;
   symbol[ 37] = 'b000000001101000101101000100111010100100011000;
   symbol[ 38] = 'b111111101110011000101010101010100001101010011;
   symbol[ 39] = 'b100000100111001101111000101100110011100011001;
   symbol[ 40] = 'b101110101011111100111111110011100111111110111;
   symbol[ 41] = 'b101110101010100011101101100110110011100101000;
   symbol[ 42] = 'b101110101001100111011000100011100100110110000;
   symbol[ 43] = 'b100000101110110010000010111000100011100001000;
   symbol[ 44] = 'b111111101111100101011111001101111110110000110;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
