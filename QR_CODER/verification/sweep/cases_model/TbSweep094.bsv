package TbSweep094;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep094(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100101101110111111111010010100001111111;
   symbol[  1] = 'b100000100111011100111111010000111100001000001;
   symbol[  2] = 'b101110100110101101101110000101010100001011101;
   symbol[  3] = 'b101110101111010110101011011100001000001011101;
   symbol[  4] = 'b101110101101000101111111100111010100001011101;
   symbol[  5] = 'b100000100111111100111000110110100100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000011001001101000111100110110100000000;
   symbol[  8] = 'b110001110111011100111111101011100111100011000;
   symbol[  9] = 'b011011000001101101110011110100111100101011010;
   symbol[ 10] = 'b110101111000000111010000100011100101111010010;
   symbol[ 11] = 'b000101001001110110000001111100101110111111011;
   symbol[ 12] = 'b000011111101011110001011110110110101110111100;
   symbol[ 13] = 'b111000011001110110100001111100100111011001110;
   symbol[ 14] = 'b010011111111000111010000100101101100000000111;
   symbol[ 15] = 'b011010001000111100001011101111001111001111111;
   symbol[ 16] = 'b111110101100100001010000110100011000111101110;
   symbol[ 17] = 'b110001000101010000100110100101001111001000111;
   symbol[ 18] = 'b001101110001000001111100001111100101010110111;
   symbol[ 19] = 'b010010001110101011111110000001010001000000100;
   symbol[ 20] = 'b110111111010011000101111110010000001111111101;
   symbol[ 21] = 'b111110001111001011111000101001011010100011001;
   symbol[ 22] = 'b001010101110111000111010110010100000101011111;
   symbol[ 23] = 'b101010001111001001111000111001010110100010101;
   symbol[ 24] = 'b100011111100100111111111110001111000111111000;
   symbol[ 25] = 'b111101000100100111101001011011110110110111001;
   symbol[ 26] = 'b110011110001100111010000100010000010000110010;
   symbol[ 27] = 'b011100011000111100010101010110101100111101000;
   symbol[ 28] = 'b111100100011100101011110001101111110001000100;
   symbol[ 29] = 'b111000011100110110100101011100101110110001110;
   symbol[ 30] = 'b011100111110111100010110111110100111100110011;
   symbol[ 31] = 'b101101000000110110000100100101000000010001110;
   symbol[ 32] = 'b110001101110000001001101110100011001111001100;
   symbol[ 33] = 'b111011010100011010101110101111000011000010110;
   symbol[ 34] = 'b000000101001111000101101110100111001111001110;
   symbol[ 35] = 'b000000010100001001100100100001010000000000110;
   symbol[ 36] = 'b000000110111100011111111101001011010111110110;
   symbol[ 37] = 'b000000001001000001101000100011010000100011000;
   symbol[ 38] = 'b111111101110011000101010110010100001101010011;
   symbol[ 39] = 'b100000101001000011011000110010111101100011100;
   symbol[ 40] = 'b101110100011111100011111101011100111111110111;
   symbol[ 41] = 'b101110100110100111001001111010110111110011000;
   symbol[ 42] = 'b101110100110111100000011111000111111111011011;
   symbol[ 43] = 'b100000101010110110000110111100100111100001000;
   symbol[ 44] = 'b111111101011100101011111001101111110100110110;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
