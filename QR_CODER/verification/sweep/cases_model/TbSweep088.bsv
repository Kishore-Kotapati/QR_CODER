   symbol[136] = 'b0010001110010101010101000110111010000101101011101001111101111100101001111101010110001001111000101001110010000011010111100010110111010110000010010010110111010;
   symbol[137] = 'b1100000101111011110100010000110110000001011010101000110110011111001010011110000100001010011111001011011001100000110101110000110100110101100000110100110100100;
   symbol[138] = 'b1001011010101000100101101010011010101010001000111010100011101111010000101110010001110000101011010000000000111110010100110001001100001001011000001101101100010;
   symbol[139] = 'b0111010110001110101001011011000110011110100100001001011000101011110100001011111100000010101111100101001110110010001010101100100010000101010110000010000010011;
   symbol[140] = 'b0110001001011011110010110001101110111010110101010110101011001000001111001011111111100011001100000110000101010001110101000001111001100000110101100000000011111;
   symbol[141] = 'b0110100001110110011000111101011011110100010111000100100011010000101111110011101111011011010100111110010101001111011111010000100001011000101101111111011111011;
   symbol[142] = 'b0000101001000011111110110001100101100001010011100001011111010010001011110101001111010101110010010010100010000111010000011011101111010110000011010000110011010;
   symbol[143] = 'b0110000000000000011111101100010100101000110010111111111100011001011010111101001101000100111101000011101001100000110011111001000100110001100001010010110110110;
   symbol[144] = 'b0101011101010110011111011101100001011110111000111100100110100111110010100100010101110010100111110010101001011110001101011000101100001110111000101001101010001;
   symbol[145] = 'b0110010001001101000011100110000110101001001000011111100000101001111100101110110011111010101001111101101111010110000011010111000010000011010110001010000100010;
   symbol[146] = 'b0000001111110101001000000111010011010001100011010011001110001011111001011111111100111011000010111100101101010011111001010010100001100110110101111000100001101;
   symbol[147] = 'b0000000011101101101010000001111011100111011001010100010011101000001101001000100111011001110010101111110101101011000001101011111001011000001101001000011111001;
   symbol[148] = 'b0000001110001101000100000110111110100001100001100001111111111100001110011101111111010111111110101000111111100100001011110101111111010010000011001111111111000;
   symbol[149] = 'b0000000011111011100101010001100010011001111010011001100010111111001101001110100010110100011011001010100010100101000010111100100011110101100000110001100010110;
   symbol[150] = 'b1111111010011000110101101011101010111010001000000111101010000111010001001110101010001101101111010001101011111001101011000000101010011101011000001000101010001;
   symbol[151] = 'b1000001010110110101001011010100010011110000100100110100010100010110100101010100011110100001011101100100010010111100101001111100011010011010110000100100010000;
   symbol[152] = 'b1011101000111011110010101001111110110011010100011111111111010010000111101010111110011111001010110110111110010101000000110101111111000000110101100100111110000;
   symbol[153] = 'b1011101010010110011000110100000000010100010111000000100111110110110111110011010010100111110010001110101001001101111000001100010011011000001100111011101101001;
   symbol[154] = 'b1011101011000011111110100001000011000001010011100000100000110100010011110100010100001011110101011010111110000100101111100100011011010110011010110111000011110;
   symbol[155] = 'b1000001000000000011111110101110011101000110010111111101000000001000010111100111000101100110101000011010101100110101100000111111100110101100000010100100001000;
   symbol[156] = 'b1111111011010110011111011101100011011110111000111101110000101111110010100110100000010011000111110010010101001111010000101111001100001101000001101100111001011;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
