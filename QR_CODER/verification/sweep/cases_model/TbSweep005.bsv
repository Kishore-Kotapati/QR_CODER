package TbSweep005;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep005(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110011010110000001110101110100111111100001111111;
   symbol[  1] = 'b10000010001011011100100011111111010010110000001000001;
   symbol[  2] = 'b10111010010000101111001110101001110000111100001011101;
   symbol[  3] = 'b10111010000111111001110110110001010000011000001011101;
   symbol[  4] = 'b10111010000001111101001011111110100100101100001011101;
   symbol[  5] = 'b10000010100101110111111010001111111101101100001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000000001000110101110001110101110111001000000000;
   symbol[  8] = 'b10010110110110101001111111111100011110011111010100000;
   symbol[  9] = 'b00110000110011100100101101100111100100010100000000011;
   symbol[ 10] = 'b00101011001100010011101110010100010011101100100010010;
   symbol[ 11] = 'b00000001100000111101101100111101010111000001010101001;
   symbol[ 12] = 'b10101010101010001011111110111110101111011100000111101;
   symbol[ 13] = 'b01000000110101011010111110001001011000010000001010001;
   symbol[ 14] = 'b11101110100111011010100000010111000011100010010011111;
   symbol[ 15] = 'b01101001000101001100000000000110010110001111100011000;
   symbol[ 16] = 'b01100010001100100111000100001000101011010011110011011;
   symbol[ 17] = 'b00010001111110111111101100111011110000110000110001111;
   symbol[ 18] = 'b00011011100010111100101001001101000100011101010100011;
   symbol[ 19] = 'b00110100001000110100001001001001010010000101000110011;
   symbol[ 20] = 'b01110011111001000011011000110101011010100011111011110;
   symbol[ 21] = 'b10101001101100100110100100101000100100010100000110011;
   symbol[ 22] = 'b00111011111011001111101101101010101110010101011100010;
   symbol[ 23] = 'b11000101111110000000111001101111101110001110111000110;
   symbol[ 24] = 'b01101111111001111111011011111101101011011010111110011;
   symbol[ 25] = 'b01011000110001010110010010001011111010010001100011011;
   symbol[ 26] = 'b11101010100000100100001110101101001111110100101010011;
   symbol[ 27] = 'b01111000111110111011110010001011110101101000100010011;
   symbol[ 28] = 'b10011111110101001100100111111111100111000000111110100;
   symbol[ 29] = 'b10011100101010010110101010001101000110110100100101000;
   symbol[ 30] = 'b00010010011110011101110001110100110110010110101011011;
   symbol[ 31] = 'b11011001110011001100001100101100111101001001100011011;
   symbol[ 32] = 'b01100010001111010110111010010010001010011010011000111;
   symbol[ 33] = 'b00000101111001001010110000110000111001010000011001010;
   symbol[ 34] = 'b00011010100001110101100000110011101110011000010110110;
   symbol[ 35] = 'b01000101001100101011110110100011111010011111010010110;
   symbol[ 36] = 'b00111011010100011011101101101001100111001000111001110;
   symbol[ 37] = 'b01011001001000110110100011101000101101001000010110100;
   symbol[ 38] = 'b11100111101111111010010110110100101010100010011110101;
   symbol[ 39] = 'b00011101101100010000001110110010000010101111101000011;
   symbol[ 40] = 'b01111010010111101011010010100000110110100111010000101;
   symbol[ 41] = 'b11011001101011011111001101011101000000111001000101011;
   symbol[ 42] = 'b00000010100000001011000001110001001110011010110001101;
   symbol[ 43] = 'b00000000010100100100000000111000110010110101111101000;
   symbol[ 44] = 'b00000011100100100101011111111110010110100010111110001;
   symbol[ 45] = 'b00000000101111111010100110001101111101011000100010000;
   symbol[ 46] = 'b11111110010110010010001110101000111101011001101011110;
   symbol[ 47] = 'b10000010100000110101010010001101110101100110100010110;
   symbol[ 48] = 'b10111010001110000101101011111111111111111001111110110;
   symbol[ 49] = 'b10111010101101000001011000101001001111000101101111000;
   symbol[ 50] = 'b10111010000111111111101001101000111100000101000111000;
   symbol[ 51] = 'b10000010000010000110101001001111111010100011100101010;
   symbol[ 52] = 'b11111110101011000010010111110001100011110010101101010;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
