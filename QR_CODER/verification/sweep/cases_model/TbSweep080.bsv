package TbSweep080;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep080(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110011000101000011001101011111000101000001111111;
   symbol[  1] = 'b10000010001000001010000110000011011101001000001000001;
   symbol[  2] = 'b10111010100110011011011100110100111111000100001011101;
   symbol[  3] = 'b10111010110000101000001001101110000101111100001011101;
   symbol[  4] = 'b10111010101111010000001111111010010010101100001011101;
   symbol[  5] = 'b10000010110010010100101010001010010110101100001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000111100111101000010001000111000110011100000000;
   symbol[  8] = 'b10111110001010000110101011111011001111011101101111100;
   symbol[  9] = 'b01111000100011001101110101001001010000101101100001110;
   symbol[ 10] = 'b00100111111010000101110111001111010010010110011011111;
   symbol[ 11] = 'b01000100111011001000100000101010111100010101000000001;
   symbol[ 12] = 'b10110110100100000011111100000110111110000011101010110;
   symbol[ 13] = 'b11010000001100101101010110010010101000101110010110001;
   symbol[ 14] = 'b10010011110000011110010110010011000101100101100101111;
   symbol[ 15] = 'b01010000100101100111010010100001101000011011111001110;
   symbol[ 16] = 'b10011110101000110101010111001101010100110010110011000;
   symbol[ 17] = 'b10011000000001010001101000001010110001010100111000010;
   symbol[ 18] = 'b00110010011000010110100100110011001110010010011010111;
   symbol[ 19] = 'b01001100110000000010101010111101011000011110110110101;
   symbol[ 20] = 'b11101111101111010011101100111111110101111100011111010;
   symbol[ 21] = 'b00101001000101110001011111001101110100110100000100110;
   symbol[ 22] = 'b00110010110100110000000111111100000001000010010110010;
   symbol[ 23] = 'b00100001010111110111011100010011110001101110001110111;
   symbol[ 24] = 'b00111111101001110110001111111101101001101101111111010;
   symbol[ 25] = 'b10101000100111101011000010001001111101101011100010010;
   symbol[ 26] = 'b11011010100000010111000010101011000101111101101011001;
   symbol[ 27] = 'b00101000110110011110011110001011111100000010100011001;
   symbol[ 28] = 'b01001111111011110011111111111111111111000010111111110;
   symbol[ 29] = 'b10110101101111000101011010001000010100110000111011111;
   symbol[ 30] = 'b10000011101111100000011000011001111111010101010001100;
   symbol[ 31] = 'b11110001000001010110000001111100100100011110000110110;
   symbol[ 32] = 'b01000111111011000011000010000111001010001000010000100;
   symbol[ 33] = 'b01011101101111110001010101111010101011110000110010110;
   symbol[ 34] = 'b10001111101000100000100001110100110010000000011111000;
   symbol[ 35] = 'b11101100110100011110001001110001011001110111001011010;
   symbol[ 36] = 'b01011010101010100011110110110001001000111110011101001;
   symbol[ 37] = 'b10111000011100111100100010011000010100111110000011000;
   symbol[ 38] = 'b10000111111110011000000011001110001000011111000001011;
   symbol[ 39] = 'b11100000001111000101011011010000101000101010011101100;
   symbol[ 40] = 'b11000010100100100101010101001111010011000101011110111;
   symbol[ 41] = 'b10001101000001000010100101100011101000101001001010001;
   symbol[ 42] = 'b00000011011110111101110100100000100101001010101010011;
   symbol[ 43] = 'b00000001110011000111010000001111110010000000100101100;
   symbol[ 44] = 'b00000011011111000011010011111110001101110111111110011;
   symbol[ 45] = 'b00000000101100110011010110001001001111001011100010100;
   symbol[ 46] = 'b11111110000000001011001110101010001010111001101011010;
   symbol[ 47] = 'b10000010110000101001011110001001101000100000100010010;
   symbol[ 48] = 'b10111010101110000101010011111011111010101000111111001;
   symbol[ 49] = 'b10111010111100000100110000010101011110010001110010010;
   symbol[ 50] = 'b10111010110111100110011111010011000011101101110100010;
   symbol[ 51] = 'b10000010000011111010111100011001010100010000111101111;
   symbol[ 52] = 'b11111110110001110101111101011010101110111000000101010;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
