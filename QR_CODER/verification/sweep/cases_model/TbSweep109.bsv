package TbSweep109;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep109(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101010101000100110111101010000001111111;
   symbol[  1] = 'b100000101111000100110011001000100100001000001;
   symbol[  2] = 'b101110101111001110011001100110110100001011101;
   symbol[  3] = 'b101110101110011011000110110001100100001011101;
   symbol[  4] = 'b101110100100011001101111111011001000001011101;
   symbol[  5] = 'b100000101111000100101000101110111100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000101101110001000111111010001000000000;
   symbol[  8] = 'b110011100011000000101111110111111011100101111;
   symbol[  9] = 'b001011000011111111100001100010101110100011011;
   symbol[ 10] = 'b000110110101100100110011000000000110000001110;
   symbol[ 11] = 'b110010001010010001100110011011000001011010101;
   symbol[ 12] = 'b100000111110111001001100110001100010110000111;
   symbol[ 13] = 'b011100000010001110111001100100110111000100101;
   symbol[ 14] = 'b110000111100000100110011000110011111100111000;
   symbol[ 15] = 'b110011000101110001100110000010100110100011010;
   symbol[ 16] = 'b101001110000111101001100101000000100101000111;
   symbol[ 17] = 'b101011010101001000111110111101010001011100101;
   symbol[ 18] = 'b011010100111111011000100110111011011110110010;
   symbol[ 19] = 'b101001001011001110011001100110110110100111011;
   symbol[ 20] = 'b011011111000000100111111101110011101111111100;
   symbol[ 21] = 'b101110001101111001101000111011001000100011011;
   symbol[ 22] = 'b101110101101011011011010110001000011101011111;
   symbol[ 23] = 'b001010001000101110011000111111010001100010101;
   symbol[ 24] = 'b100111111011100000111111110111111011111110100;
   symbol[ 25] = 'b100101011100111111110001000010101110101111000;
   symbol[ 26] = 'b010000110110000100110001000000000111100101101;
   symbol[ 27] = 'b100001010111010001111100111011000001010000101;
   symbol[ 28] = 'b110100101011111001000110010001100010000000110;
   symbol[ 29] = 'b001110010110101110111001000100110110110110101;
   symbol[ 30] = 'b001010100110000100101110000110011111011100000;
   symbol[ 31] = 'b110011011111010001100011000010100111100001010;
   symbol[ 32] = 'b001101110010111101010001101000000101100101111;
   symbol[ 33] = 'b111001000111001000111100111101010001010000111;
   symbol[ 34] = 'b000000101101111011001110010111011010011010011;
   symbol[ 35] = 'b000000010100101110000011000110110111100111010;
   symbol[ 36] = 'b000000110000100100111111101110011101111111111;
   symbol[ 37] = 'b000000001101011001111000111011001000100011011;
   symbol[ 38] = 'b111111100101111011001010110001000010101011111;
   symbol[ 39] = 'b100000101100101110011000111111010000100010101;
   symbol[ 40] = 'b101110101111100000101111110111111011111110100;
   symbol[ 41] = 'b101110100110111111110001100010101111111101011;
   symbol[ 42] = 'b101110100110000100111011000000000111010111100;
   symbol[ 43] = 'b100000101101010001100001011011000000000010110;
   symbol[ 44] = 'b111111101011111001000011010001100010101000111;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
