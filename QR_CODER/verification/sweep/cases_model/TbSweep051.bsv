package TbSweep051;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep051(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101010000000011001001101001100110001111100001111111;
   symbol[  1] = 'b100000100101000000110010001011101010100001001100001000001;
   symbol[  2] = 'b101110101011001111011100101001001011100110000100001011101;
   symbol[  3] = 'b101110101111101111001000110110000000000101101000001011101;
   symbol[  4] = 'b101110100000010110100001011111101001011101010000001011101;
   symbol[  5] = 'b100000101100001111010110011000110001001100000100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001010011110000011001000101001000101001000100000000;
   symbol[  8] = 'b010101111010101010100010111111111000010100110000111101101;
   symbol[  9] = 'b110000001001111000110010111000010011110001011011010001010;
   symbol[ 10] = 'b110001111011011100110101100100010001001101110001101001100;
   symbol[ 11] = 'b001011011111011110001000100110100100000001101000000100010;
   symbol[ 12] = 'b111011110010001111100110011000101111000010001100100101110;
   symbol[ 13] = 'b111000000101110101110010101000111111111010110100111100101;
   symbol[ 14] = 'b111110100011110110101011000101010110000011100111000101011;
   symbol[ 15] = 'b111011000110001110100010010010100010011101001110111000111;
   symbol[ 16] = 'b111101110111111100101000001000100000110111001101100000110;
   symbol[ 17] = 'b111000010010110111110111110110001111010110110011000000011;
   symbol[ 18] = 'b111110111001011110111010010111010100101100100001010011110;
   symbol[ 19] = 'b010111000100011101001000011100110111011011110110111101001;
   symbol[ 20] = 'b011000111011000101001010110010011111101101000111101010111;
   symbol[ 21] = 'b001110010111111000010110111001000101001010100100101011001;
   symbol[ 22] = 'b101111111000101111101011111100100101011101111100011001111;
   symbol[ 23] = 'b011011010111011011100101111100110101001101111011111110011;
   symbol[ 24] = 'b111110100101010100100011111001011110100100010001111101101;
   symbol[ 25] = 'b000000011001000100100011101110011110001100101001000010001;
   symbol[ 26] = 'b110111111000000111100101111111111111111101111010111110100;
   symbol[ 27] = 'b000110001110101011001011111000111010101100100001100011101;
   symbol[ 28] = 'b000010101000001111110001111010101011110111111110101010101;
   symbol[ 29] = 'b000110001111001000100101111000100010000111101110100010011;
   symbol[ 30] = 'b011111111111110100101011111111100010101101001100111111110;
   symbol[ 31] = 'b100010000101010001110100111110001101000010110001110101001;
   symbol[ 32] = 'b011011110011110001001101110001010000110011000000110110111;
   symbol[ 33] = 'b100100011110110001101100110100001101110000100010101100100;
   symbol[ 34] = 'b110101101101010110111110001100100111001000100001000100011;
   symbol[ 35] = 'b100101001111100010101010000001110000101011001100010101101;
   symbol[ 36] = 'b100010100011110100001011110011111001001111001110010000101;
   symbol[ 37] = 'b111110000101111011101110110101011110010100110111010011000;
   symbol[ 38] = 'b001111110100011100100010101010001010000100100111000000111;
   symbol[ 39] = 'b010010010010100010000110111101011010001001000100011001011;
   symbol[ 40] = 'b100000110110110010111110101000001100110001000101100101100;
   symbol[ 41] = 'b010111000000001001010100111001000011000000101100100101101;
   symbol[ 42] = 'b100101100111110111111101011010110000101011101110101110001;
   symbol[ 43] = 'b010011010011111100011001100110111110000111000011100110110;
   symbol[ 44] = 'b001111111011000010000010011110110101110100111010111001100;
   symbol[ 45] = 'b110100001000010011011101111111001000010111011010111110001;
   symbol[ 46] = 'b000000101111101101111010101101000010101111100001100010101;
   symbol[ 47] = 'b000000010011110010101111011100011100000001101101111001010;
   symbol[ 48] = 'b000000101100110011000001011111111111000010001111111111101;
   symbol[ 49] = 'b000000001111000001110001111000100111111010110111100010110;
   symbol[ 50] = 'b111111101000110110110111111010111110000011100111101011000;
   symbol[ 51] = 'b100000101001111010010010011000100010111101010010100010100;
   symbol[ 52] = 'b101110100111100001011000011111111010000110100011111110111;
   symbol[ 53] = 'b101110101010111010010010011000101011011110010010011101101;
   symbol[ 54] = 'b101110100001001111101100000111101010100101110011011010011;
   symbol[ 55] = 'b100000101100100011110001011011000001011011010111100110110;
   symbol[ 56] = 'b111111100011001000000010111010011000001111000110010011111;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
