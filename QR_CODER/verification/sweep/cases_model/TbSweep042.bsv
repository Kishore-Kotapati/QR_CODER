   symbol[126] = 'b00000011101011101001010000111000001110000101001000100101001000011100101111100010111001010000011100110000011010110110000001000000110000110;
   symbol[127] = 'b00000001011110101011101000001000101101100110101010101001010101000000110011111001011100110011111111010100100110101110001000011100110011010;
   symbol[128] = 'b00000011001010010101101011111011010001011111010001111110000000100011000101111111101110001001001111001111111000101001011110001011111111001;
   symbol[129] = 'b00000000101010100101101110001001110101010011110100100010100000110010100000001000101010000010001010000010001011011010001111011011100010010;
   symbol[130] = 'b11111110011100011111111010101100011110110100011111101011011000101101111000101010101011100001001011100110101110000110010110000110101011111;
   symbol[131] = 'b10000010010010100110110010001010100110001110100111100010111111101010111111101000110011011001110011011010001101100000000101100001100011000;
   symbol[132] = 'b10111010010001000111110111111001001110000100001010111111011100011011011110011111110101010111110101010111111100010001100101110000111111001;
   symbol[133] = 'b10111010111100110010111101001011000101100001000011110110110100000110010111010101111000110100111101010100001010101101111001001101100001000;
   symbol[134] = 'b10111010110000111010100010001011110101011001110010110101010011000100010100101101100000001100100111101100001001101011111010001011011001101;
   symbol[135] = 'b10000010100000011101111110111011111011010111111100100100100010110101100101010100001110000010101001100011111000011011011110111011010111100;
   symbol[136] = 'b11111110100111111001000010001110111000110100111101001000101110100101101000011110100101100001000010100001000100000111010011100110110100100;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
