   symbol[137] = 'b0000000001010111011001111100011010110101010000011100011010110011111110110110101001100000110011100110110111001100011000101100011100011001001100011000011001101;
   symbol[138] = 'b1111111100101110010010000100001100000100111110010000010101011001110110011110100110100110011001100111110000001000100010001001111000111011101110111011011011100;
   symbol[139] = 'b1001000101001100110011011000111100000100011110001101110010110001111110010101100110011111010101111110110100101010000000101010111100011001001100011000011000100;
   symbol[140] = 'b1010101100010110011110011101100111011110111000100011100110100111110010100100010010001011000001101011001000111110000000101110010100001101011000001101101011110;
   symbol[141] = 'b0001000010010101111011011110111100010111110100100111111010110111000100010111001100111101110111011100101110101010111100110011000010111011101000111110111110111;
   symbol[142] = 'b1010111010011000100101101010111000111010001000111110000100010101010000101101010010001001001001001001100001011000001010100000110100001101011100001001101100001;
   symbol[143] = 'b1001100100101100110011000000111010000100011110010101010100111011101110010100100101101111010001101111010101001100011110110100001000011001001110011010011100011;
   symbol[144] = 'b1111101011101000101001101011010111101000001110001100010110110001000100010000000001000101110001000100001111101110111011001111010010111011101100111011011010111;
   symbol[145] = 'b0000000001011111011001111100011001010101010110001110011011001011111110110010101001100110110011100111100101001100011001101101111000011001001100011000011000001;
   symbol[146] = 'b0000001010011000100101101010111110011010001000111110100011001110010000101110110001010001101111010001001000111110010100111001001100001101011000001101101100010;
   symbol[147] = 'b0000000110001110010001000010011001000110111100110101110000110011110100110010100100110011110111001100000110001000100010001010010010111011101110111010111010100;
   symbol[148] = 'b0000001101010110011111011101111110011110111000111010111110100111110011100111111110000100000001110011111110111111010000101000111110001101011000001101111110010;
   symbol[149] = 'b0000000011010111011000111101100010100100110110000101100010010010000110110010100010000001010100000110100010001001101110010010100010011001001100011001100011011;
   symbol[150] = 'b1111111000101110010011111101101010011100011100001001101010111001100010111001101010111011011111000111101011101111001101110110101010111011111110111011101010011;
   symbol[151] = 'b1000001000101100110011100000100010000101011100010100100010110001101010000001100011100110010001101110100011001101110111010101100010011001001100011000100011111;
   symbol[152] = 'b1011101001010110011111111100111111001110011110111010111110100111110000100110111111110011000111110011111111011001111101011000111110001101001000001101111111101;
   symbol[153] = 'b1011101001110101111011111111100010010111110100100111000100010001000000001000010001000100010001000101000011101110111011101111110110111101101111111011101110101;
   symbol[154] = 'b1011101000011000100101101010011000111010001000111111111011101111010000101110101111011001101111010001110101011001110100111111000000001101011000001101011000001;
   symbol[155] = 'b1000001000101100110011000001011110000100011110010101000100110001101110010000010100011001001001110011100001001001100000101011010100011001001101011001001100001;
   symbol[156] = 'b1111111011100000101001101011001101101000001110001101000110010001000100010000010110111011101001011011100011100011100110011001111110111101101111111011101110101;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
