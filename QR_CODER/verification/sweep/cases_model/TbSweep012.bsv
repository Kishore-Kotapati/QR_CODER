   symbol[125] = 'b10111000111000110011101101000000000100011011110010100000000001001010101010000010000011100010000110000001011011110010000000000100100010000;
   symbol[126] = 'b00000010100101011111100100101110111100010111011011110111011010001110111101110000101001000010001110100010001100110101010111010010100010100;
   symbol[127] = 'b00000001110111000010111100001000010100111111110011100000001101011001101010100000000001101010100110001101101110110011000000010001101010001;
   symbol[128] = 'b00000011111100110110010111111001010111110011010111111110110100100011110000011111100100001111100011001011111101001101111011101111111111001;
   symbol[129] = 'b00000000110000111011010110001100111010110110111011100010100011100100100011001000101111001101101111001110001101011101001001011100100011011;
   symbol[130] = 'b11111110101001110010011010101001010111111101010110101010110001100100110001111010100010101000000010101110101011011110011011011110101010110;
   symbol[131] = 'b10000010110110000010101110001110010010111000010011100010001011011110001011011000100111101101000111101010001000110000100000110001100011110;
   symbol[132] = 'b10111010010000111010011111111100111110011000111010111111011111001101011101001111101111100111101111100111111110100011110111100010111111111;
   symbol[133] = 'b10111010011000110010011001011000010100011010010010001010001001001110001010001101000011100101000110000100010011110100100000010100111010000;
   symbol[134] = 'b10111010001000110010101111010111010001111101010110010000110111100100110000001010000100101000000011001000101001011110011010111111110101010;
   symbol[135] = 'b10000010111101101010010111111010111100010000111011100010100101110110100010011011101001000101101110100100111110011000001000111000110000111;
   symbol[136] = 'b11111110111010110111110110011101010011110101010110010000110110100000110000010110000100001010000011001010011101001110011010101111111101010;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
