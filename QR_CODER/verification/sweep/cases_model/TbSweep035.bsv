package TbSweep035;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep035(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110000111001101100011101100100110011100001111111;
   symbol[  1] = 'b10000010110011011010100111001110101101111100001000001;
   symbol[  2] = 'b10111010110111111101010001111011000100001000001011101;
   symbol[  3] = 'b10111010101011100101010100100111011011110100001011101;
   symbol[  4] = 'b10111010010111110111000111111100010110101100001011101;
   symbol[  5] = 'b10000010000100011101100110001000011110101000001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000101001010101001110001011000000010011100000000;
   symbol[  8] = 'b10000010111101000100000011111110011000001111011001110;
   symbol[  9] = 'b01011100110111011110110110100010111010000111001111110;
   symbol[ 10] = 'b11100110110100000101111110111111001110101100011000010;
   symbol[ 11] = 'b00100000111110010100100010101111101100101110011011000;
   symbol[ 12] = 'b10110111110010110011110111000110110100011101101101110;
   symbol[ 13] = 'b00010000010010000100011011101001100010111010101111010;
   symbol[ 14] = 'b10110111100110000001101101101101011110100100001010110;
   symbol[ 15] = 'b00101000111100110111001001100010000110110010110100001;
   symbol[ 16] = 'b11101010101011010100001001110111011001010000001100001;
   symbol[ 17] = 'b10101100101001001110111011010011010010010100101001100;
   symbol[ 18] = 'b01110111000010001011111000010010101100101101001001010;
   symbol[ 19] = 'b10011100010101100010101010010101101111011101100011111;
   symbol[ 20] = 'b01110111011111001011110010110010101100011110101101111;
   symbol[ 21] = 'b01010101100001101010110000011000101001101111100000110;
   symbol[ 22] = 'b00011111100010110101001110110000100100101101110001100;
   symbol[ 23] = 'b00110100111000111001011000010101011100010110000111110;
   symbol[ 24] = 'b10111111111110111100111111111010010001011100111111010;
   symbol[ 25] = 'b10001000100010100100000010001001010111010101100011111;
   symbol[ 26] = 'b10011010111100010100011110101000110100100111101010100;
   symbol[ 27] = 'b01101000110111111100111010001111010110001000100011010;
   symbol[ 28] = 'b11101111110001100110000011111001110000100011111110011;
   symbol[ 29] = 'b01011000101100100101010010111100000101000010110010110;
   symbol[ 30] = 'b11101110011000010010000101000000010101110001111001001;
   symbol[ 31] = 'b01111001001010001001110100111001101110110100111111011;
   symbol[ 32] = 'b00001110001100111000101101101100000110110011000001011;
   symbol[ 33] = 'b11000000011101100111100010010001010010010010100010010;
   symbol[ 34] = 'b10011010001100100100111000110110001101000101000010111;
   symbol[ 35] = 'b11111001110001110011000011010011111001100101010111101;
   symbol[ 36] = 'b11001111100011001000100001000110011110101011000011010;
   symbol[ 37] = 'b11101001111000110000101111010011011010001101001111010;
   symbol[ 38] = 'b01110010100101001010101001010010111000100100010000010;
   symbol[ 39] = 'b01110101010110111101111010000110001001111010011110001;
   symbol[ 40] = 'b01010011010000110100000000000011011111010111100000011;
   symbol[ 41] = 'b10111000110011100001010100101011111000010000011101100;
   symbol[ 42] = 'b00000011000111011111110110111001010100011011100011110;
   symbol[ 43] = 'b00000000000111001110001110101010000000000111011110011;
   symbol[ 44] = 'b00000011111100011000111111111100001001000010111111111;
   symbol[ 45] = 'b00000000110011011001011010001111011101110110100010111;
   symbol[ 46] = 'b11111110011110001001111110101000000000001100101011001;
   symbol[ 47] = 'b10000010000111110000001110001001100110110100100010001;
   symbol[ 48] = 'b10111010001000010100011111111010110000100011111110011;
   symbol[ 49] = 'b10111010000111001101000111011011100111000011111111100;
   symbol[ 50] = 'b10111010010110001100011111011100011001011111010111010;
   symbol[ 51] = 'b10000010000011011111000010000111101100001101101100101;
   symbol[ 52] = 'b11111110101100101100111111111010111111001011110110000;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
