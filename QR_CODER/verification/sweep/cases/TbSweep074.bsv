   symbol[170] = 'b111111101010001100011011111010101110010000101100001111101010100111100001100010101111101010001010000010111010000010101100100000010101000000001010101100100110001100100110101010111;
   symbol[171] = 'b100000101110010010110001100010001100001000011011101100111000100100011101010010000111100011100101001100110010010110001111000011110110100011111000101111000101101111000100100011011;
   symbol[172] = 'b101110100011010111010101001111111001110000000111111000011111100000011001100101011101111111100101000110000010101011111111111001011111111001011111111111111101011111111101111111100;
   symbol[173] = 'b101110101000100011101111000111111100101110000010001110001101110110011101101001001100010001001011100111110011011010000100001010000100001010011100011001101100000001101100000000011;
   symbol[174] = 'b101110100110111101011111100100101111011111110001000100101111101110101000101111100110101001001111001100110010111000100011101001000011101001010111011010001111000010001111000011101;
   symbol[175] = 'b100000101011111000100000100110110110011011111101111110001001000110001111000010010101010001000101011011000001011000011011010001111011010001101111100010110111111010110111111011001;
   symbol[176] = 'b111111100000100100001100101101000010101111000010100000110100001011000010010110000110011001001010011010111000001111110010100010010010100010011110010011100110000011100110000010100;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
