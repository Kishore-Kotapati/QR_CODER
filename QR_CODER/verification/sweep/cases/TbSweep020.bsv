package TbSweep020;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep020(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110101110100100111110000101001100000110001111111;
   symbol[  1] = 'b10000010100111111010101001111100011100100111001000001;
   symbol[  2] = 'b10111010110100111100000100101001111010100101001011101;
   symbol[  3] = 'b10111010001001101111011000101111011111011010101011101;
   symbol[  4] = 'b10111010110111011010001011111110110100011010001011101;
   symbol[  5] = 'b10000010000000011111000110001000111100000010001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000010001011000100110001110011100100101000000000;
   symbol[  8] = 'b10011111110110000010101111111110100100111001010010111;
   symbol[  9] = 'b01011100110100010100011011100111010000001001000000100;
   symbol[ 10] = 'b11111010000110001111010101011101111111010000010100001;
   symbol[ 11] = 'b01101101001010001111101011110011001011100011000101100;
   symbol[ 12] = 'b00010010110000001010111011101110010100100100001110110;
   symbol[ 13] = 'b00101101000100011100010010110010010101101000110110011;
   symbol[ 14] = 'b00100111110011010010100011010100101101101010010110011;
   symbol[ 15] = 'b00100100110101101110010101101001000010001001011100011;
   symbol[ 16] = 'b01010111000000010111011101101100111110101001100010000;
   symbol[ 17] = 'b11001100101001100111111101001100110100010100101001110;
   symbol[ 18] = 'b10001011001101010010100100110001111010000100000010111;
   symbol[ 19] = 'b00010101110110110000001100001111011001001110010101000;
   symbol[ 20] = 'b10111010001011011011000100101001000110001011110000000;
   symbol[ 21] = 'b11101101000000111101010011110110111111111001100111111;
   symbol[ 22] = 'b01011111100110001100111111010101111000111011010101001;
   symbol[ 23] = 'b11001001011111011010101011010110100101000000110100000;
   symbol[ 24] = 'b00011111101011000101000011111101001010001111111110110;
   symbol[ 25] = 'b10001000111001010100001010001001111011011001100011110;
   symbol[ 26] = 'b01001010111011100101100110101101010111111111101011101;
   symbol[ 27] = 'b11111000110110101101110110001111000100011011100010001;
   symbol[ 28] = 'b11001111111100001010001011111111111110101111111111110;
   symbol[ 29] = 'b00111100110010101101111000011000100011110011101101100;
   symbol[ 30] = 'b01000010001100011000001011111111011101000100011100111;
   symbol[ 31] = 'b11110100010000100001111011000010010010011110010001011;
   symbol[ 32] = 'b00110111011011011000100011011111000101110110111101111;
   symbol[ 33] = 'b00011100110010101110011001010001100000111011001010100;
   symbol[ 34] = 'b00010111000011100110001001001001110111111001010001011;
   symbol[ 35] = 'b11100000110101101101111110110100011001110111101001101;
   symbol[ 36] = 'b01110011100001101010000111000011100100011001010011110;
   symbol[ 37] = 'b00100101001100110011101011010010110111111001010000100;
   symbol[ 38] = 'b10100011110010100000010110100000101000101110100111111;
   symbol[ 39] = 'b00101001001010010110011110001100000100011101101011011;
   symbol[ 40] = 'b10001111110000100011110010001010010011000110000000111;
   symbol[ 41] = 'b11100001011000100101110111100101110100010101001010000;
   symbol[ 42] = 'b11011110011000000010111011100111100101100110100101111;
   symbol[ 43] = 'b01100001100101000100011011001110110110011000101011111;
   symbol[ 44] = 'b00010011100010000011011111111100100001100110111111110;
   symbol[ 45] = 'b00000000100010000011010110001010110011001000100010101;
   symbol[ 46] = 'b11111110101011101101101110101001101001000111101011011;
   symbol[ 47] = 'b10000010100101010110100110001100100101011001100010010;
   symbol[ 48] = 'b10111010111011010110011111111001111011001001111111100;
   symbol[ 49] = 'b10111010111001001110000010000011000001010011011100000;
   symbol[ 50] = 'b10111010000100100110001001011010101110011101100101110;
   symbol[ 51] = 'b10000010001100001000011111110100110111011000011110100;
   symbol[ 52] = 'b11111110111100111011000001001100010000101011110100110;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
