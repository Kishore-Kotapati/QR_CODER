   symbol[137] = 'b1111000110011000010110110011010101100010011001001011010101111100101001111101100110101001111100101000111010000011010110000001010111010110000011010111010111000;
   symbol[138] = 'b1010101001111011000110001001011001001001101011011101000000001100110011001101110010110011001100110010100011011101110111011100101111101110111011101110001111110;
   symbol[139] = 'b0000110101010101001010111001000101100101100111101100101011001000010111101000011111100110101100000111001101010011111001010011000001100000110101100001100001111;
   symbol[140] = 'b1010011100100111101110101100010100100111001001001011010111010110000011010111100011111010110000011010111001001111100001011111100101111100101001111100011101100;
   symbol[141] = 'b1110110100001010000100100001000011101000001011011001000111001110111011101111110011000010001000100011001001010101010011001100111101000100010001000011000001000;
   symbol[142] = 'b1100111101011111100010101101111111111101001111111001100011001000010111101001010011001110001110001110100110011111001100000111110011001010011111001100101111001;
   symbol[143] = 'b0101100011100011111100001111110011001011010001011010011111111110100001011110101110100001011110100000011010000011010000011011000111010110000011010001010101010;
   symbol[144] = 'b1010111110110101111100111110000010111101011011011001000101000100010001000101110110010001000100010001001010111011101110111010001111101110111011101010001111101;
   symbol[145] = 'b1001110000101110100000000101100001001100101111111101100011001010011111001011010000011111001010011110101100110101100000110101100001100000110101100001100001110;
   symbol[146] = 'b1101101011101001010100011011001111001011111001001111010010011110100001011111100000100001011110100000110001001111100101001110111101111100101001111100011101100;
   symbol[147] = 'b1111100001110001101110011101100111011001000011001000001111101100110011001100111011000100001000110011001001110111011101110111100101000100010001000101000101011;
   symbol[148] = 'b1010011010010001011000011010111110011001111111111101111111100000110101100001111111001010000110110100111111111000010111101001111111001010011111001010111111010;
   symbol[149] = 'b0000000010011000010110110010100011111010011001001010100011011100101001111101100011010110011010101001100011000110100001011111100011010110000011010110100011010;
   symbol[150] = 'b1111111001111011000110001000101011011001101011011100101011101100110011001100101011101110101010110010101010111010001000100011101011101110111011101110101011101;
   symbol[151] = 'b1000001011010101001010111001100011111101100111101101100011001000010111101000100010010111101000010111100010110100000110101100100011100000110101100001100011100;
   symbol[152] = 'b1011101000100111101110101101111110101111001001001011111111010110000011010111111110000011010110000010111110101001111100101001111111111100101001111100111111111;
   symbol[153] = 'b1011101010001010000100100000011101101000001011011000111011101110111011101111101110111011101110111010110100010001000100010000001001000100010001000100010001010;
   symbol[154] = 'b1011101001011111100010101101011111111101001111111000111100101000010111101001101000010111101000010110110010011001010011111000000111001010011111001010011111001;
   symbol[155] = 'b1000001001100011111100001110010001001011010001011010001011111110100001011111011011010110000110100000101110000101001111100100011011010110000011010110000011000;
   symbol[156] = 'b1111111010110101111100111110011000111101011011011000010011000100010001000101000011101110111100010000110110101100110011001100101011101110111011101110111011111;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
