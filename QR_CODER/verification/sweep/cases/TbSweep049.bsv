package TbSweep049;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep049(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101100011000111110100101101000101111111;
   symbol[  1] = 'b100000101110000011110100000111000001001000001;
   symbol[  2] = 'b101110100011001001011110100011111001001011101;
   symbol[  3] = 'b101110100011100001110100001001011101101011101;
   symbol[  4] = 'b101110101100101001111111100011110111101011101;
   symbol[  5] = 'b100000101000000011101000100001011000001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001110110110111000100101100001100000000;
   symbol[  8] = 'b111001101001111010011111101111000011111110011;
   symbol[  9] = 'b111001011001110000000110000101101001100100000;
   symbol[ 10] = 'b010010111111000011111100001111100011001110111;
   symbol[ 11] = 'b110001000101001001011110100001110001100000000;
   symbol[ 12] = 'b010101101101100011110110001001011010101000111;
   symbol[ 13] = 'b110001011111100001011110000011110000000011100;
   symbol[ 14] = 'b011101110000100011111100001001111010101001000;
   symbol[ 15] = 'b100000011011101001011110111000010110011001101;
   symbol[ 16] = 'b001001100110100111110110010000111100110001100;
   symbol[ 17] = 'b001100000100000111011001011010010110011011101;
   symbol[ 18] = 'b111101100011011100001011111000111110111001011;
   symbol[ 19] = 'b110010001101010110100001011100000110011101111;
   symbol[ 20] = 'b110111111011111110001111110110100101111111111;
   symbol[ 21] = 'b000010001111110110001000111100001110100010010;
   symbol[ 22] = 'b010010101100111100011010111110100110101010111;
   symbol[ 23] = 'b101110001110010110101000100101100001100010010;
   symbol[ 24] = 'b010111111011111010001111101111000011111110111;
   symbol[ 25] = 'b110110010001110000000100000101101001101000010;
   symbol[ 26] = 'b111111111001000011110110101111100010100010110;
   symbol[ 27] = 'b111101001011101001000100000001110000100000000;
   symbol[ 28] = 'b001101101101100011111110101001011010111010110;
   symbol[ 29] = 'b110001001001100001001100000011110001110001100;
   symbol[ 30] = 'b100000111111000011101001101001111010011011000;
   symbol[ 31] = 'b110111001011101001011011111000010110010001101;
   symbol[ 32] = 'b111100101110100111101001010000111101011111100;
   symbol[ 33] = 'b001101010100000111001001111010010110010111111;
   symbol[ 34] = 'b000010100100111100001001111000111111011101001;
   symbol[ 35] = 'b011110000110010110111011111100000110010111110;
   symbol[ 36] = 'b100110101110111110001111110110100101111111111;
   symbol[ 37] = 'b000000001010010110011000111100001111100010010;
   symbol[ 38] = 'b111111100010111100011010111110100111101010111;
   symbol[ 39] = 'b100000101100010110101000100101100000100010010;
   symbol[ 40] = 'b101110100001111010011111101111000011111110111;
   symbol[ 41] = 'b101110100101110000010110100101101000011000000;
   symbol[ 42] = 'b101110101001000011111110001111100010010000111;
   symbol[ 43] = 'b100000101011101001010001000001110000111010010;
   symbol[ 44] = 'b111111101111100011111011101001011010011000111;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
