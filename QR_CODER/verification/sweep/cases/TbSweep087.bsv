   symbol[127] = 'b01011101101001011100100010010110001010100001101101111110010011000111110100111110011111110100111000010011110000101101011110001111110100010;
   symbol[128] = 'b11111011100000101010001111111101001011101111001011111110101000111111101100001111111000010011111111010111111001010001100111110011111111010;
   symbol[129] = 'b00000000101111000100101110001011000101001001000100100011011100011011011100111000110000110010010000110010001010100010110110100011100010100;
   symbol[130] = 'b11111110111000000011101110101000100110001100100111101011000000010101000000001010110011011001110011011110101010101111101010101111101011000;
   symbol[131] = 'b10000010000101110001011110001101100001001011100000100011111000101101111000101000110100011110110100011010001011000011010011000010100010000;
   symbol[132] = 'b10111010000101101111001111111001101011001101101111111110001010011000001000011111111010110010111010110011111011110110100010110111111110101;
   symbol[133] = 'b10111010100110101100000011000110001010000100001100010100010111010000010100010011011101111011011000011010001101101010111110001010100100011;
   symbol[134] = 'b10111010010100101110110011001011001101100001001010001100101011111000101100010110011000110100011111010100110101000010000110100011101001001;
   symbol[135] = 'b10000010100010010101101000000101000011101111000100011101011010001001011101100100010110111010010001011011000001100111110111000111001111011;
   symbol[136] = 'b11111110101011000110000111101100100010000100100111100001000111010001000001100111110101111011110010111011101100111111101011011110001100100;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
