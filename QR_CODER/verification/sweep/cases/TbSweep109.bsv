package TbSweep109;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep109(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101010101000100110111101010000101111111;
   symbol[  1] = 'b100000101011000100110011001000100101001000001;
   symbol[  2] = 'b101110101101001110011001100110110101001011101;
   symbol[  3] = 'b101110101101011011000110110001100101101011101;
   symbol[  4] = 'b101110100111011001101111111011001011101011101;
   symbol[  5] = 'b100000101111000100101000101110111100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000101001110001000111111010001000000000;
   symbol[  8] = 'b110011100011000000101111110111111011100101111;
   symbol[  9] = 'b001011010011111111100001100010101110100011011;
   symbol[ 10] = 'b100110100011100100110011000000000110000001111;
   symbol[ 11] = 'b110010001110010001100110011011000001011010101;
   symbol[ 12] = 'b111000111100111001001100110001100010110000100;
   symbol[ 13] = 'b001000000101001110111001100100110111000100101;
   symbol[ 14] = 'b110000111100100100110011000110011111100110000;
   symbol[ 15] = 'b111011001100010001100110000010100110100011010;
   symbol[ 16] = 'b101000100000111101001100101000000100101001111;
   symbol[ 17] = 'b101000001101001000111110111101010001011100111;
   symbol[ 18] = 'b001010100101111011000100110111011011110110000;
   symbol[ 19] = 'b101001001011001110011001100110110110100111000;
   symbol[ 20] = 'b110011111111100100111111101110011101111111111;
   symbol[ 21] = 'b100010001110111001101000111011001000100011011;
   symbol[ 22] = 'b100010101101011011011010110001000011101011111;
   symbol[ 23] = 'b001010001000001110011000111111010001100010101;
   symbol[ 24] = 'b100111111011100000111111110111111011111110100;
   symbol[ 25] = 'b100101011100111111110001000010101110101111011;
   symbol[ 26] = 'b010000110110000100110001000000000111100101100;
   symbol[ 27] = 'b110001010011010001111100111011000001010000101;
   symbol[ 28] = 'b001110101111111001000110010001100010000000100;
   symbol[ 29] = 'b001011010110101110111001000100110110110110101;
   symbol[ 30] = 'b001111100110000100101110000110011111011100000;
   symbol[ 31] = 'b111011001111010001100011000010100111100001010;
   symbol[ 32] = 'b001101110010111101010001101000000101100101111;
   symbol[ 33] = 'b111001000111001000111100111101010001010000110;
   symbol[ 34] = 'b000010101111111011001110010111011010011010001;
   symbol[ 35] = 'b011110010010101110000011000110110111100111000;
   symbol[ 36] = 'b100110110100100100111111101110011101111111111;
   symbol[ 37] = 'b000000001001011001111000111011001000100011011;
   symbol[ 38] = 'b111111100101111011001010110001000010101011111;
   symbol[ 39] = 'b100000101100101110011000111111010000100010101;
   symbol[ 40] = 'b101110101111100000101111110111111011111110100;
   symbol[ 41] = 'b101110100110111111110001100010101111111101011;
   symbol[ 42] = 'b101110100100000100111011000000000111010111100;
   symbol[ 43] = 'b100000101001010001100001011011000000000010110;
   symbol[ 44] = 'b111111101111111001000011010001100010101000111;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
