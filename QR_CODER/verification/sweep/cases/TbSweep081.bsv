package TbSweep081;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep081(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101111010101111100101010011001000101101011001111111;
   symbol[  1] = 'b100000101010100111001001100110001001000111100001001000001;
   symbol[  2] = 'b101110100100001000011101101110001101100001001011001011101;
   symbol[  3] = 'b101110100000010000100101001001111110111010010101001011101;
   symbol[  4] = 'b101110100100001010110011001111110101100001000101001011101;
   symbol[  5] = 'b100000100110110010001100101000101100110000101010001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000011111000110100101000101110100000110111000000000;
   symbol[  8] = 'b010000111111101110000001011111111111010011100111110000011;
   symbol[  9] = 'b100111010110000000001000000101101100001000111100101110101;
   symbol[ 10] = 'b111101100111000010101100111010001101010011100101110101111;
   symbol[ 11] = 'b000110000011101100110000111010001000111101010000111100101;
   symbol[ 12] = 'b000110100111000010110001001101111010010111011101110010100;
   symbol[ 13] = 'b101000000010001010010111001111000000011101010001011011010;
   symbol[ 14] = 'b110000100100110001101100000010011001000100100110000100000;
   symbol[ 15] = 'b001100000001110001011101101011011101101010101101001111011;
   symbol[ 16] = 'b110001101011100000100100010111011110110011111111110100100;
   symbol[ 17] = 'b010100011110001011000011001000110111100010101110100100100;
   symbol[ 18] = 'b101011111100001011110111000111100111101000100110101110100;
   symbol[ 19] = 'b110001000011111010110111111011010000111101010000111100101;
   symbol[ 20] = 'b011100111100000011101101110101011001001100000000101101111;
   symbol[ 21] = 'b110010001000000110011001000110111010010111011011010110100;
   symbol[ 22] = 'b000000100100111011101111100000111001000100100000000101101;
   symbol[ 23] = 'b100100001011101111010011000001001001100001000111000000110;
   symbol[ 24] = 'b011010110000001101100110101100001011101001000100101000111;
   symbol[ 25] = 'b010100011110100101011010001001111001100011001110100011000;
   symbol[ 26] = 'b110011111110001010110010111111111000110010111101111111011;
   symbol[ 27] = 'b111010001001110100101100001000100100110010111010100010100;
   symbol[ 28] = 'b011110101100011011101101101010110111001010100000101010111;
   symbol[ 29] = 'b111010001011111100011001001000111110011010110000100010100;
   symbol[ 30] = 'b011011111010100001111110101111110110011001111010111110100;
   symbol[ 31] = 'b100111000010110110010011011000001001100101000110110110101;
   symbol[ 32] = 'b001000101100001110001011110110010000110100011110011001111;
   symbol[ 33] = 'b010111010001111110010010001011110011101111000100100011011;
   symbol[ 34] = 'b111001110001101010100010110000111000110100111100011000000;
   symbol[ 35] = 'b110101001010111110010110001101001110111000101000100001010;
   symbol[ 36] = 'b000111110110100001011110111110101100010000100011000111111;
   symbol[ 37] = 'b111001011010011100001001001010111110011010111000101110100;
   symbol[ 38] = 'b001000101111011011000101110101001101000011100000011111111;
   symbol[ 39] = 'b101101011101011100011001000010100011110111001010101100100;
   symbol[ 40] = 'b111100101000101011101011110110010000101100011000000001111;
   symbol[ 41] = 'b101001011010110110010001000111111001111101001000111001010;
   symbol[ 42] = 'b010010110100110010101000101001100011111111100011110011011;
   symbol[ 43] = 'b100101010100011001100111000011010111100000100110001001010;
   symbol[ 44] = 'b111000111011111101000101011101110110110011111111111100100;
   symbol[ 45] = 'b101011010100010100100010000110111101101000100001000100101;
   symbol[ 46] = 'b101001110111010001100110110101010100110011111001011111111;
   symbol[ 47] = 'b111110001011001110010011100010110000111101010000100110101;
   symbol[ 48] = 'b000000111111100110010100011111111010010111011011111110100;
   symbol[ 49] = 'b000000001000100110010110011000110000011101010001100011010;
   symbol[ 50] = 'b111111101111110001110110101010100001000100100000101010000;
   symbol[ 51] = 'b100000100110000101101001101000111101101010101100100011011;
   symbol[ 52] = 'b101110100011111101000110001111100110110011111110111110100;
   symbol[ 53] = 'b101110100110000110101110101000010111100010101110100111000;
   symbol[ 54] = 'b101110100100000010111111001010111111101000100110001101011;
   symbol[ 55] = 'b100000101011010100010010111000100110111100110000000011001;
   symbol[ 56] = 'b111111100100010111001100000111011111001101100001010100100;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
