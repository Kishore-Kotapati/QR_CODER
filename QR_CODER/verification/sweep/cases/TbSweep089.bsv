   symbol[167] = 'b000100010000100001000111010100010000111110101000011010000100010001000001100101110001111001010011001010010010100111110000001010100000001010101110011001101100110001101101110100010;
   symbol[168] = 'b010101101100010010000010001011111000110111000000000111011111100111111100100011010001111110100011101001011011101011111001100011111000100011101111111000100111101000100111111111111;
   symbol[169] = 'b000000001100000111101011100110001100001010100111000010111000110000110001001100100010100011101111111011001001111110001001011001100000111001111000111101011111111101011111100011001;
   symbol[170] = 'b111111100010100100001011111010101011000011101101001000101010110100011110110110111010101011010010011000110010100010101110001010111111101010101010100110001100100110001100101010010;
   symbol[171] = 'b100000101110010000001101001010001001110110010001010011111000101000001000101110111001100010101000000110111010110110001111000011110110100011111000101111000101101111000100100011011;
   symbol[172] = 'b101110101110101000000010100111111010100001001100010110101111100101101110011101000010111111000101111100101000000111111101110001111101110001111111111101110101111101110101111111101;
   symbol[173] = 'b101110101011110100111001010101111111010000100010011111011111011011101010111111111000011001000000100111110011011010100110000010100110000010110100111011100100100011100100100010000;
   symbol[174] = 'b101110100110010101000111100000010010001100110000000011100101111101010111111111110010111110010111010110111010011010001001000011101001000011111101110000100101101000100101101001011;
   symbol[175] = 'b100000101011111010001100001111001011100101110111000001001000101010011010111000101010111110001000010001001001111000011011010001111011010001101111100010110111111010110111111011011;
   symbol[176] = 'b111111100101011011011011000111000001111110001001001110010010001110110101101110011000010011101010100000010010100111010000101010110000101010110110110001101110100001101110100000100;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
