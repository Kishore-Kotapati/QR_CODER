package TbSweep065;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 53 N;
(* synthesize *)
module mkTbSweep065(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b11111110101000100111100111111110100111000010001111111;
   symbol[  1] = 'b10000010110111010100000101100111100000010011001000001;
   symbol[  2] = 'b10111010011001111101011110010011101010000001001011101;
   symbol[  3] = 'b10111010111100100111000100100000000011000110101011101;
   symbol[  4] = 'b10111010000011010010010111111101110111100010001011101;
   symbol[  5] = 'b10000010001000110100101010001111001100101010001000001;
   symbol[  6] = 'b11111110101010101010101010101010101010101010101111111;
   symbol[  7] = 'b00000000110100011101000010001011001010001100100000000;
   symbol[  8] = 'b10110111000000000000011011111000010100101001101001011;
   symbol[  9] = 'b00000100110111000011000111001010100011001111000100011;
   symbol[ 10] = 'b00100111100011111000110110010110110111100101110011000;
   symbol[ 11] = 'b10000100111110101111110101001011110010111011100110000;
   symbol[ 12] = 'b11100111001100001110000011111000010110000101111010110;
   symbol[ 13] = 'b00101100110100110100000001001101000111111100110101011;
   symbol[ 14] = 'b01110010101110100110011100101110000110010011011000101;
   symbol[ 15] = 'b00001101110111110100001110011110111010001110000101000;
   symbol[ 16] = 'b10010010101011011101110011000100111001000011100001011;
   symbol[ 17] = 'b10010000011110000110101001110001011010001100011111100;
   symbol[ 18] = 'b01110010000100111000101100110100101001101001010001110;
   symbol[ 19] = 'b00111000001110101001111001111011010100010000001011111;
   symbol[ 20] = 'b11000011111111000100111100110110001101011011101000101;
   symbol[ 21] = 'b10111100011001000100010011001111110000011110000101011;
   symbol[ 22] = 'b00101110000101011000100000110110011111000000110110010;
   symbol[ 23] = 'b11100000011000110101011100010000101011110001100010011;
   symbol[ 24] = 'b01101111110101110010010111111100011010100010111110000;
   symbol[ 25] = 'b00101000110101011000011010001101010101101001100010000;
   symbol[ 26] = 'b11101010111011010000110010101110110000010000101011111;
   symbol[ 27] = 'b01101000111101110010110010001110100001111110100011010;
   symbol[ 28] = 'b11111111110011110010100011111110111100000100111110100;
   symbol[ 29] = 'b00111000100101010011000101010000111000011001100100000;
   symbol[ 30] = 'b00101111101111110000100011010101001000100000100000010;
   symbol[ 31] = 'b11001001011111100010000110110001111111010001111011100;
   symbol[ 32] = 'b00100111000010010101011101010010011100111001011110011;
   symbol[ 33] = 'b00111000010010010101111101111010100111011010100011011;
   symbol[ 34] = 'b10110111111000111111101100001011110011011011010110100;
   symbol[ 35] = 'b11000001101000000000000100001101101010100000100100000;
   symbol[ 36] = 'b11101011000010111000110110000110011010010010000110100;
   symbol[ 37] = 'b10011100010000010010001111001101010011110001000000010;
   symbol[ 38] = 'b00011011001011001110110011100010110010111011101011111;
   symbol[ 39] = 'b00000101111100100110111110110010101111000000101001001;
   symbol[ 40] = 'b11100111111101101100000001100011110000110110000011000;
   symbol[ 41] = 'b10100101010011010101100110010101011110010100101001111;
   symbol[ 42] = 'b11011111101011011010100001010001001110111101110110100;
   symbol[ 43] = 'b01100000111011101001000001010110010110110111111110101;
   symbol[ 44] = 'b00010011111011100001001011111111000001011011111110110;
   symbol[ 45] = 'b00000000101000111100101110001011000100011111100010010;
   symbol[ 46] = 'b11111110111110110011001110101111011011011000101010110;
   symbol[ 47] = 'b10000010110001001000001110001010110000010100100010010;
   symbol[ 48] = 'b10111010010000100111110011111110000111100101111110110;
   symbol[ 49] = 'b10111010101110100100100001110000100000110100001111011;
   symbol[ 50] = 'b10111010111111101110100110010000010101101010001001000;
   symbol[ 51] = 'b10000010010010000111110000100011000001010100000011010;
   symbol[ 52] = 'b11111110101011011110101001110011111100010100110110110;
   Integer n = 53;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
