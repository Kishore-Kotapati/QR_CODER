   symbol[125] = 'b11011001011001010010000100100001100101111010010011000001100000101011001011100011100010000011100111100000111010010011100001100101000011100;
   symbol[126] = 'b10100111000110111100001111001101011111110100111000010100111001101101011110010011001010100001101101000001101111010110110100110001000001000;
   symbol[127] = 'b01011101101001011100100000010110001010100001101101111110010011000111110100111110011111110100111000010011110000101101011110001111110100010;
   symbol[128] = 'b11111010001101000111100011111000100110000010100110111111000101010010000001101111110101111110010010111011111100111100001010011110111110111;
   symbol[129] = 'b00000000111001110010011110001101110011111111110010100011101010101101101010001000100110000100100110000110001100010100000000010101100010010;
   symbol[130] = 'b11111110000111111100010010101111011001110011011000101010111111101010111111111010101100100110001100100010101101010000010101010000101010111;
   symbol[131] = 'b10000010101000011100110110001000001100100110001101100010010101000000010101001000111001110011011001110110001110101110111110101111100011101;
   symbol[132] = 'b10111010101100100110000011111000100010000100100110111111000011010001000001011111110011111011110011111011111010111111101011111110111111100;
   symbol[133] = 'b10111010011001010011111000111001110101111011110011101011101000101111101011101100100010000100100111100101110010010101000001110101011011100;
   symbol[134] = 'b10111010000110111100100001011001011111110011011000011110111001101010111110000100001010100110001101000110100111010000010100110001111011011;
   symbol[135] = 'b10000010101011011100100001001100001010100110001101010100010011000000010100101101011111110011011000010010001000101110111110001110000110010;
   symbol[136] = 'b11111110101011000110000111101100100010000100100111100001000111010001000001100111110101111011110010111011101100111111101011011110001100100;
   Integer n = 137;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
