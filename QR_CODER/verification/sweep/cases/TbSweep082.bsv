   symbol[ 34] = 'b1110001100101001001011110000011100101011011100000000000000001001010010001;
   symbol[ 35] = 'b0001110111111101110000001101001101001001011111011001000100000100010000100;
   symbol[ 36] = 'b1000011011000011010010111011111100001010011101101100010001001011100010101;
   symbol[ 37] = 'b0110000101001011001011000111010010100101001000110001000100010110101000100;
   symbol[ 38] = 'b1101001100101000011110110100010000101011010000000000000000001010100010001;
   symbol[ 39] = 'b0000010111111100110100101000101011001001011011011101000100001110101000100;
   symbol[ 40] = 'b1001011011000011110010011010000001001010011001101010010001001010001010101;
   symbol[ 41] = 'b1001000101001011111111100000111000100101001100110111000100011110101000100;
   symbol[ 42] = 'b0100001100101001001011010110011100101011010010000010000000001101100010001;
