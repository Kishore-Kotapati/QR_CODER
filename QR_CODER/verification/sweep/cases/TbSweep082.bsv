   symbol[ 51] = 'b0101110011100100100001011011110110101001111001111011000100011000111100100;
   symbol[ 52] = 'b1100101001011010001111100111011011001010011100100100010011011101010110101;
   symbol[ 53] = 'b1101110101011011111001001101110111100101101100010001000100001001010100100;
