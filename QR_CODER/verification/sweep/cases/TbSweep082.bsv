   symbol[ 59] = 'b0101110010111100100001011011010111101010011001111011001110011000111101000;
   symbol[ 60] = 'b1100101001011010001111000001111011101111011100100100010111011101110101101;
   symbol[ 61] = 'b0101110101000011011001101101010110000001001100001001000010001001110100100;
   symbol[ 62] = 'b1101011000011001110000110111111101101101110101010000000100011001110110001;
   symbol[ 63] = 'b0001100101101100100001011001010111101101111111100101010100011000111110100;
   symbol[ 64] = 'b1000101001100010001111001111111010001101011111111010001001011101111110101;
   symbol[ 65] = 'b0000000011111011011001101000110110001110001110001111011100001001100011011;
   symbol[ 66] = 'b1111111000111001110001111010111101101101010110101010001010011000101011111;
   symbol[ 67] = 'b1000001010111100100001101000110110110010011010001011001110011000100011011;
   symbol[ 68] = 'b1011101011011010001111111111111010000111011011111100010111011101111111101;
   symbol[ 69] = 'b1011101001000011011000000000010111011001001111000001000010001001101110110;
   symbol[ 70] = 'b1011101010011001110001111100111100010101110101100000100100011001001110001;
   symbol[ 71] = 'b1000001001101000100001101110010110101101101000110100110101011001001000110;
   symbol[ 72] = 'b1111111001100000001111110100111010000101011010000010001000111101000010111;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
