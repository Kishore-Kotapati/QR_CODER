(* synthesize *)
module mkTbSweep082(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b1111111010001010010000001000100101101000001001101111011100001010101111111;
   symbol[  1] = 'b1000001001000001110110100111100101101000000000001110011011011110001000001;
