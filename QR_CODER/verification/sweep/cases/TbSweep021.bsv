package TbSweep021;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep021(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100111010001100000011110101110111010010111001111111;
   symbol[  1] = 'b100000100011110011010100001110101100010000011101001000001;
   symbol[  2] = 'b101110100001000110101011110001010001100111100111001011101;
   symbol[  3] = 'b101110101011001011100100111000011011101111011001001011101;
   symbol[  4] = 'b101110100111010101111100101111111001000101110101001011101;
   symbol[  5] = 'b100000101001100110001001011000101001100111010110001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001001001101010001001000101001011101100000000000000;
   symbol[  8] = 'b011000100001000000110001101111101011110111000011101101000;
   symbol[  9] = 'b010011000000101000010110101101110001011101101001111011110;
   symbol[ 10] = 'b100111111111101000110010111111010011111111100011011001011;
   symbol[ 11] = 'b100101001011011111110100000110110111000000000011100101110;
   symbol[ 12] = 'b111010110000110111111010101110110101101000100010101101111;
   symbol[ 13] = 'b010100011110101001100011101101010111000010001010000100000;
   symbol[ 14] = 'b101001111100000001110111000111011111101000100000101100100;
   symbol[ 15] = 'b100001000011000000010000011011101000011101110000011000001;
   symbol[ 16] = 'b110110100111001110110010101110100010010111011011110000100;
   symbol[ 17] = 'b101000000010111000110101101100111000111101110001111011110;
   symbol[ 18] = 'b011001111111100000110111011010001010011111111011011001011;
   symbol[ 19] = 'b000110001011000001110000000001101111000000000111100001110;
   symbol[ 20] = 'b011001110000101101111010101100100101101000100100101001111;
   symbol[ 21] = 'b110110011110111101100100101000111111000010001110000011111;
   symbol[ 22] = 'b101010111100010001110101100110001111101000100110101001000;
   symbol[ 23] = 'b010000000011000110010000111011001110011100010000011101110;
   symbol[ 24] = 'b000110100111100000100010101111001100010110111011110111111;
   symbol[ 25] = 'b011001000011011100100111110100111110111100010001111100110;
   symbol[ 26] = 'b011011111111000000111110111111110110011110111011111111111;
   symbol[ 27] = 'b000110001011110111101011101000101001000100100111100010010;
   symbol[ 28] = 'b011010101000110101110000101010101011101110000100101011111;
   symbol[ 29] = 'b110110001110110101110000111000111001000101001111100011110;
   symbol[ 30] = 'b101011111111110000111001111111100011101110000110111111011;
   symbol[ 31] = 'b010001000100111111000110101100101110011000010000100001110;
   symbol[ 32] = 'b001011110010100001010110110110101100010000111010111111111;
   symbol[ 33] = 'b010101011100111100010001110010011110111010010000110110000;
   symbol[ 34] = 'b010111111111100000111110110110010110011000111010111100100;
   symbol[ 35] = 'b001011011100110111000011101000001001000101111110110110001;
   symbol[ 36] = 'b010111101011110101010000101101001011101111000100111010100;
   symbol[ 37] = 'b111101001100010100010000100001011001000101111111110001110;
   symbol[ 38] = 'b010110110010110001101001110011100011101111100110111011011;
   symbol[ 39] = 'b010101011100111111000110100101101110000000010110110001110;
   symbol[ 40] = 'b010111101000100101011110100110101100001000111100100111111;
   symbol[ 41] = 'b011101001110111111001000101110011110100010010111100110000;
   symbol[ 42] = 'b010111110100000010111111001000010110001000111110000100100;
   symbol[ 43] = 'b010111011011110000110011000000001000011101110010010110001;
   symbol[ 44] = 'b011011111111110100010000001111010010010111011111011010100;
   symbol[ 45] = 'b010101000000010000110001000101011000111101110100010001110;
   symbol[ 46] = 'b101001110100101110101010101101101010011111111101111011011;
   symbol[ 47] = 'b111110001100101101000111000001100111000000000110110001110;
   symbol[ 48] = 'b000000100000111100011110001111100101101000100100111111111;
   symbol[ 49] = 'b000000001110100000001011011000101111000010001110100010000;
   symbol[ 50] = 'b111111100100001110111010101010100111101000100110101010100;
   symbol[ 51] = 'b100000100011101100110111001000100000011001110001100010001;
   symbol[ 52] = 'b101110100111111100010111011111100010010111011010111110100;
   symbol[ 53] = 'b101110100000000110110010001001001000111001110001011010000;
   symbol[ 54] = 'b101110101100101100101010011011100010011101111011110000111;
   symbol[ 55] = 'b100000101100100101000111001011110001000001100111011000001;
   symbol[ 56] = 'b111111100000100110010001011111111011101001000101111010111;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
