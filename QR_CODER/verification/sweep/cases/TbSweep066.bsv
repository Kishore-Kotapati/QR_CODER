package TbSweep066;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep066(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100111010001100000000110101110111010010111001111111;
   symbol[  1] = 'b100000101011001011101100101000010100101000100101001000001;
   symbol[  2] = 'b101110100000001111100010111000011000101110100111001011101;
   symbol[  3] = 'b101110101001100001001110010010110001000101101001001011101;
   symbol[  4] = 'b101110101101000111101110111111101011010111111101001011101;
   symbol[  5] = 'b100000100110000100001010111000101010000100100110001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000001001110101101001111000110001100101011000100000000;
   symbol[  8] = 'b010111101010001100011001001111100010111110001010111011010;
   symbol[  9] = 'b111001001110000001111101100111011011110111000011010001011;
   symbol[ 10] = 'b110101101101111110100000101101000001101101110001001011001;
   symbol[ 11] = 'b000110001000111100010110000101001100100011100100000100010;
   symbol[ 12] = 'b111010110000110111111010101110111101101000100100101101111;
   symbol[ 13] = 'b101100000110010001011011010101110111111010110110111000111;
   symbol[ 14] = 'b010000110101001000111110001110000110100001101111100011101;
   symbol[ 15] = 'b001011001001101010111010110001000010110111011010110010100;
   symbol[ 16] = 'b110100110101011100100000111100110000000101001001100010110;
   symbol[ 17] = 'b011011000001011011010110001111011011011110010010011000010;
   symbol[ 18] = 'b011001111111100000110111011010001010011111111011011001011;
   symbol[ 19] = 'b111111010011111001001000111001010111111000111111011001001;
   symbol[ 20] = 'b010010111001100100110011100101101100100001101101100000110;
   symbol[ 21] = 'b011111010100010111001110000010010101101000100100101001000;
   symbol[ 22] = 'b111010101110000011100011110100011101111010110100111011000;
   symbol[ 23] = 'b110011000000111101110101011001001101111111110011111110000;
   symbol[ 24] = 'b000110100111001000101110101111001100010110111011110111111;
   symbol[ 25] = 'b100001011010001100000111001100100110000100101001000100001;
   symbol[ 26] = 'b010011111110001001101111111111111111010111110010111110010;
   symbol[ 27] = 'b101110001000111101000001001000100011101111001101100011011;
   symbol[ 28] = 'b001010101010100111100010111010111001111101010110101010101;
   symbol[ 29] = 'b010110001101010110010011011000111010100110001100100010010;
   symbol[ 30] = 'b101011111111110000111001111111100011101111100111111111011;
   symbol[ 31] = 'b101001011100000111111110010101110110100000101000111001001;
   symbol[ 32] = 'b001010101011101000011111111111100101011001110010110110110;
   symbol[ 33] = 'b110111001110010110111011011000110100010000111010011100101;
   symbol[ 34] = 'b000001100101110010101100100100000100001010101001101110110;
   symbol[ 35] = 'b100000001111010100100000001011101010100110000101010101101;
   symbol[ 36] = 'b010111101011110101010000111101001011101111000100111010100;
   symbol[ 37] = 'b000101010100101100101000001001100001111101010111001001001;
   symbol[ 38] = 'b011111111101111000100000100010101010100110101111110010010;
   symbol[ 39] = 'b111111010000010101001100001111000100101010111100011011011;
   symbol[ 40] = 'b000101111000110010101101110110111110011010101110111101101;
   symbol[ 41] = 'b111110001101011010101010001111111101000001110100010101100;
   symbol[ 42] = 'b010111110100000110111111001000010110001000111110000100100;
   symbol[ 43] = 'b101111000011001000001010011010111000100101001000101110110;
   symbol[ 44] = 'b010010110110111101011001000110011011011110010010010011101;
   symbol[ 45] = 'b111111001010111010011011101111110010010111011010111011011;
   symbol[ 46] = 'b101001100110111100111000111111100000001101101001101001001;
   symbol[ 47] = 'b111110001111001110100100100010000100100011100101010010010;
   symbol[ 48] = 'b000000100000111100011110001111100101101000100100111111111;
   symbol[ 49] = 'b000000001110011000110011101000110111111010110110100010111;
   symbol[ 50] = 'b111111100101000111110011101010101110100001101111101011101;
   symbol[ 51] = 'b100000101001000110011101101000101010110111011011100010100;
   symbol[ 52] = 'b101110101101101110000101001111110000000101001000111110110;
   symbol[ 53] = 'b101110101011100101010001101010101011011110010010111001100;
   symbol[ 54] = 'b101110100100110100101010011011100010011111111011110010111;
   symbol[ 55] = 'b100000101100001101111001110011001001111001011111100110101;
   symbol[ 56] = 'b111111100000010111010000010110110010100000001100110101110;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
