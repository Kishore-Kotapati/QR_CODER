package TbSweep111;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 57 N;
(* synthesize *)
module mkTbSweep111(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111101100001010111011011111110101100001001111001111111;
   symbol[  1] = 'b100000100111010111110000110110001000110100111001001000001;
   symbol[  2] = 'b101110100010011101110000101010001010111100100111001011101;
   symbol[  3] = 'b101110100111101111000000011100111111001011111101001011101;
   symbol[  4] = 'b101110101100001110100111111111100010011110110101001011101;
   symbol[  5] = 'b100000101111000010101101111000101101000011111010001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000001101001010101101000101101111001000100100000000;
   symbol[  8] = 'b011111110100011001001011011111110000101100011000100110001;
   symbol[  9] = 'b110111000010001101110011101001010101111001001101011111010;
   symbol[ 10] = 'b111100100100110011101000000100001000100100111000000010000;
   symbol[ 11] = 'b000001001111111101010000000010010011110100100001000111010;
   symbol[ 12] = 'b100001101011101100100001110101100110111011111001110110100;
   symbol[ 13] = 'b110000011010001101000111001001110011110110101100100000100;
   symbol[ 14] = 'b110010100111011010101100011100000100101011111011110001111;
   symbol[ 15] = 'b010101000111100100110100111111001100111001010100111100101;
   symbol[ 16] = 'b111101111100010101101001110101111001001100000000101011111;
   symbol[ 17] = 'b111100000110011100010001001000011100011001010101011111010;
   symbol[ 18] = 'b000010100100111011101100000001010001000100100000000010000;
   symbol[ 19] = 'b100001001111100101010100100101001011100110100011000101010;
   symbol[ 20] = 'b000011101011110110100001110111111110110001111111110010100;
   symbol[ 21] = 'b010001011010011001000000001100011011100010101010100111011;
   symbol[ 22] = 'b110000100111000010101010111101010100110011111101110010001;
   symbol[ 23] = 'b110100000111110010110110011111001010111000110100111001001;
   symbol[ 24] = 'b011101111101001011110011110100110111001101100000101100100;
   symbol[ 25] = 'b111101000111110000001001010000111010011000110101011001110;
   symbol[ 26] = 'b000011111101111011110101101111101101000101100000111110000;
   symbol[ 27] = 'b100010001110010011000111001000101101100000100011100010110;
   symbol[ 28] = 'b000010101011101110101011111010110000110101111111101011100;
   symbol[ 29] = 'b010010001010010001010100011000111101100000101011100011010;
   symbol[ 30] = 'b110011111100101011100010101111111000110101011101111110000;
   symbol[ 31] = 'b110101000000011011100010001000101010111100110101100101010;
   symbol[ 32] = 'b010000101001111010001101101101110111001011100001000100100;
   symbol[ 33] = 'b111101000000011000110101010110111010011110110101110010100;
   symbol[ 34] = 'b000000100100111011100101101101001101000011100000100111111;
   symbol[ 35] = 'b101011011000010011100111011100101100100001000010010010101;
   symbol[ 36] = 'b001100110000101110001011101110010000110100001111100001111;
   symbol[ 37] = 'b011001001000110000110100011101111100000001011011010101010;
   symbol[ 38] = 'b001101101001101011110010100000111000110100101101100000000;
   symbol[ 39] = 'b110001011100011011100010001001001010100100110010010101010;
   symbol[ 40] = 'b001100110001111011100100011111110111010011100111100100100;
   symbol[ 41] = 'b111001001010011000101101001100111010000110110011001010100;
   symbol[ 42] = 'b001100101111011011100100110111001101010011100101010111111;
   symbol[ 43] = 'b110011011111010100010110000100110100111001010010111010101;
   symbol[ 44] = 'b000000100100101111001011010100011001000100000100000001111;
   symbol[ 45] = 'b110001000100110100010101100001100100000001010010110101010;
   symbol[ 46] = 'b101001101111110101110001110110111001001100100010100000000;
   symbol[ 47] = 'b111110001000001001100011100101000011100100100010010101010;
   symbol[ 48] = 'b000000111011100111000101011111111110110011111111111110100;
   symbol[ 49] = 'b000000001010000100101111111000101011100110101010100010100;
   symbol[ 50] = 'b111111101111010101100001111010111100110011111101101011111;
   symbol[ 51] = 'b100000101111001000010011101000100100111001010101100010101;
   symbol[ 52] = 'b101110101100100111001100001111111001001100000001111111111;
   symbol[ 53] = 'b101110101100100010010110101101101100011111010101111000100;
   symbol[ 54] = 'b101110101111101111110111000000111001000110100000101001100;
   symbol[ 55] = 'b100000101000011001100001101111010101100101000011111100101;
   symbol[ 56] = 'b111111100010011101001000000100100000110010011110100001100;
   Integer n = 57;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
