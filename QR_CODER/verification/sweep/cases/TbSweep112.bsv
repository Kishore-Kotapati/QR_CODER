   symbol[ 30] = 'b1011101000111001111110001011001000100000011010100110111011001100001000100;
   symbol[ 31] = 'b0110110101010010101011011000010110111010011110010100100100100110011110000;
   symbol[ 32] = 'b1111111101001010110101000000111010111011101011111100101001111101000010110;
   symbol[ 33] = 'b1001010000011011010100000000101101010101100110011001000100010001111000101;
   symbol[ 34] = 'b1100101100011000101110111111100000000100111111000010011111001011110100000;
   symbol[ 35] = 'b0001100011100100011001111101000110001100110010100010010010000110111000110;
   symbol[ 36] = 'b1100111111011101000111010111010100101001101101101110111011110000100000100;
   symbol[ 37] = 'b1110110100111010100100100011100011110001011010111101100000100010001100001;
   symbol[ 38] = 'b1001001010101100101100001001011010110010001001110100101001110110111010110;
   symbol[ 39] = 'b0010100001110111001110101010110011011110100100110100000000010010101010100;
   symbol[ 40] = 'b1001011011111001100010010010001100101101001011001100011111010000001100000;
   symbol[ 41] = 'b0010010010001100000110110010111110000111101100001101010110001000111010111;
   symbol[ 42] = 'b1111011000111110011011111001000101000000011111100100111011100011101000100;
   symbol[ 43] = 'b1110000101010011110101101011111010011010000010010110100100101101101110000;
   symbol[ 44] = 'b1111111111001110100101001111111010011011111111111100101001100011111110110;
   symbol[ 45] = 'b0100100010011110010000011000100111010101111110001001000100001011100010101;
   symbol[ 46] = 'b0111101010011010110000111010101001000100111010101010011111011100101010000;
   symbol[ 47] = 'b1000100011101101000110101000101101001101110110001110010010010011100010110;
   symbol[ 48] = 'b1001111111001101011110111111110000001000101011111000111011101110111110100;
   symbol[ 49] = 'b0100000110110010111100001110101010110001111110011011100000110100011000001;
   symbol[ 50] = 'b1101001110101100001111101000001111010011001011011110101001110101001110110;
   symbol[ 51] = 'b1010000101100111010101011110001110111110000000110010000100001000111100100;
   symbol[ 52] = 'b1001011001101000001011101011001100101100001111000010011011010011011010000;
   symbol[ 53] = 'b0110110000010100000010011001101101000110101110101011010110011010001110111;
   symbol[ 54] = 'b0011011101101110011100011100101101100001011111001110111001111110111100100;
   symbol[ 55] = 'b1110100011100011110000011001001011111001000010010000110100100101111000000;
   symbol[ 56] = 'b1011101010011111011100111000111010011000011011110010110111111100001100110;
   symbol[ 57] = 'b0000100100111110010000101010111110010110111010110111011100010000111101001;
   symbol[ 58] = 'b1011111011101010111001011110001001100100011101110000010101000011111001100;
   symbol[ 59] = 'b1000010110000101100110101101111101001000010010111000011000011010101111010;
   symbol[ 60] = 'b1101111000110100001111001110101001101000001011100110111101110111011101100;
   symbol[ 61] = 'b1100000100100011010100001010011011110101011000011101100110101100011010001;
   symbol[ 62] = 'b1101011111111100001110001000111110110010001101000100101101100101001100110;
   symbol[ 63] = 'b0001100101000110110100011101101111001101100110100100010000001000111100100;
   symbol[ 64] = 'b1000101010101000101010001111101100001110101111111100000111010011111110000;
   symbol[ 65] = 'b0000000010101101100011011000101100100100101110001101001110011011100011011;
   symbol[ 66] = 'b1111111011001110011100111010101100110000111110101100110001110111101011001;
   symbol[ 67] = 'b1000001000110010010000101000101010111110100110001110001110101100100011100;
   symbol[ 68] = 'b1011101010100110011101001111111010110010011111111101101111100101111111101;
   symbol[ 69] = 'b1011101010000111110000100011111111010001111010110000000010001001101110101;
   symbol[ 70] = 'b1011101001001110111000110001001000011100111001011011111011010011001110011;
   symbol[ 71] = 'b1000001001010100100110011111111100000111101000010110010011011011111000111;
   symbol[ 72] = 'b1111111000001010001111011000101000101010011111101001101010010111101010101;
   Integer n = 73;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
