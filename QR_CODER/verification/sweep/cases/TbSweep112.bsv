   symbol[ 10] = 'b1101101001100011010000100100011100001101000100000011000011001000111011000;
   symbol[ 11] = 'b0001100000110010010011110101000000011010111011101010000011010101101110110;
   symbol[ 12] = 'b1111001101111110011111010100110100111111110110101110100010001001000100100;
   symbol[ 13] = 'b1111100000111000101110100010100101110011001100110101100001010011000000111;
   symbol[ 14] = 'b1011011110101101100110000010101010110000010010010100010001011110010101001;
   symbol[ 15] = 'b0001010011110110000011101111010000000000101001011000101000100111101101111;
