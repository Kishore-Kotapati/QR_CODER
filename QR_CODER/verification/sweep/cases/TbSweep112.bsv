package TbSweep112;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 73 N;
(* synthesize *)
module mkTbSweep112(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b1111111000010001011111011011010101101100100101001101110110100010101111111;
   symbol[  1] = 'b1000001001110100000101111001001000110000000111111110001110111010001000001;
   symbol[  2] = 'b1011101010101101000110110000010101010000101110011111110110100100001011101;
   symbol[  3] = 'b1011101010100001001010011001100001110000000100111010110111011111001011101;
   symbol[  4] = 'b1011101001111101111011111111110000100001100011111001001100000101101011101;
   symbol[  5] = 'b1000001000101010110011011000111111111101110110001000010110001010001000001;
   symbol[  6] = 'b1111111010101010101010101010101010101010101010101010101010101010101111111;
   symbol[  7] = 'b0000000001110010100101001000110110100111101110001101101110000011000000000;
   symbol[  8] = 'b0001101101010100001101001111100110111001001111111101111111111011000001100;
