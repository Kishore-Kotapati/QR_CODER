   symbol[ 18] = 'b1010001100011111110100000000111010101110000000100111111011101100011110100;
   symbol[ 19] = 'b0110010111010100100001000010010010101010001101011100100101100011011000000;
   symbol[ 20] = 'b1111011111001100001011000110100000101011100101111100101000011011010110110;
   symbol[ 21] = 'b1000000100011100001010000111100011010101101000110001000101110111100100111;
   symbol[ 22] = 'b1111101000011011010100110101011110000100100101100010111111101000100010011;
   symbol[ 23] = 'b0000000001100100011101111100000000010100111010001010110011110001111110101;
   symbol[ 24] = 'b1101111111011110000111001111101000101001111111111111011011101111111110111;
   symbol[ 25] = 'b1101100010111100110000101000101001110001011110001100000000010101100010001;
   symbol[ 26] = 'b1010101010101001111000001010110110111010010110101101101001011100101010110;
