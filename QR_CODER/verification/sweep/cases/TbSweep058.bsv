   symbol[139] = 'b0010100101101010111101010110011100000000010000101010001000101100011001001100011001101000001000001001001001010101111111010100001111100110110011100110101111111;
   symbol[140] = 'b0001011110101001011101000010110000010101100010000001000110111000001101011001101101110100111110010100111111001001001101011001101001010000101111010000010001001;
   symbol[141] = 'b0010100101001011101011100000011011111000000110001001100000001110111011101110111011000010001000100011001001110111011011101110111101001100110011001011000111001;
   symbol[142] = 'b1001001110000000000100010110100011101110101011000000001011111000001101011001101001010100111110010101011110100111110100111111001011110010100111110100010111110;
   symbol[143] = 'b0001000101101010111101010110011110010000010000101010001010101100011001001100011110011001001100011000101000110011100000101010111111100110110011100000101001100;
   symbol[144] = 'b0101011000011111101011110100000010110011010100110111110000001110111011101111011100111011101110111011101000011001100110011000100111100110011001100010100111100;
   symbol[145] = 'b0011100111101001001001000010111001011010100100101011000010001100011001001100011110011001001100011000001010010001101110010001100111101110010001101111100111111;
   symbol[146] = 'b1101101110000000000100010110100011101110101011000000001100011000001101011001101100001101011000001101111111000001101011000000110011110010100111110010010011101;
   symbol[147] = 'b1111100111001000011111110100111110110010110010001000101010001110111011101110111011001100101010111011101011110111011101110110101101000100010001000100001101011;
   symbol[148] = 'b1010011110101001011101000010111110000101100010000001111110111000001101011001111111110010111110001100111111001000001101011001111111010000101111010000111111001;
   symbol[149] = 'b0000000011101001001001000011100011011010100100101010100010101100011001001101100011100110101010011001100011010100011001001101100011101110010001101110100011101;
   symbol[150] = 'b1111111000110110110010100001101011011000011101110110101011001110111011101111101011100110001000111010101010010000100010001001101011000100010001000100101011000;
   symbol[151] = 'b1000001001101010111101010111100010010000010000101010100010101100011001001100100010011001001100011001100010110010000000101010100011100110110011100111100011100;
   symbol[152] = 'b1011101000101001011101000010111110000101100010000000111110111000001101011001111110001101011000001101111110101111010000101111111111010000101111010000111111010;
   symbol[153] = 'b1011101001001011101011100001110111111000000110001000100100101110111011101111101110111011101110111010111100110011001100110010101011001100110011001100110011001;
   symbol[154] = 'b1011101000000000000100010111111001101110101011000001000010011000001101011001011000001101011000001100001010100001101011000000111111110010100111110010100111101;
   symbol[155] = 'b1000001001101010111101010111000010010000010000101010101010101100011001001101001001101110010100011000011110110101111111010100101011100110110011100110110011101;
   symbol[156] = 'b1111111010011111101011110100001010110011010100110111011100001110111011101111101001000100010110111010111110001110111011101110001001100110011001100110011001101;
   Integer n = 157;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
