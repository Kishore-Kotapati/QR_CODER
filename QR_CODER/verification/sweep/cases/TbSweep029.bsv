   symbol[170] = 'b111111101101001011000100111110101001010111101011001000101010100000100110100101101000101011001101000101111101000110101011100111010010000111001010101011100001001011100001101011111;
   symbol[171] = 'b100000101111100011011000010010001101111001101010011101001000110101101100100011110110100010010100111101000011100110001110110010000111010010001000111110110100011110110101100010101;
   symbol[172] = 'b101110101111001011001001010011111101101100011011100100001111111100000101111001000001111111111001011010011110110111111011100101000011100101001111100011100001000011100001111111111;
   symbol[173] = 'b101110101000011011010111111111000100010110111010110110110101001110100101010001110100101001110011011111001011100010111100110010111100110010100100100001010100111001010100111000100;
   symbol[174] = 'b101110101000110011010001101010100001010001111111001010100001100000100110100001101000100111000001000010111100110110101101100111001101100111011001010100000001001100000001001101100;
   symbol[175] = 'b100000101000011011000011000101010101111000011110011101101010100101101100100001110110110010100110111000100010111011111000110010011000110010001100000001010100011001010100011000100;
   symbol[176] = 'b111111100111100011001011101010000101101000000101100111110011001100000101010001000001011110001101011101111111001000110101100101010101100101011001010100100001000100100001000101110;
   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
