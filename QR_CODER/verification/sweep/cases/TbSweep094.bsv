package TbSweep094;
import Vector::*;
import QRTypes::*;
import QRDecoder::*;
typedef 45 N;
(* synthesize *)
module mkTbSweep094(Empty);
   Vector#(N, Bit#(N)) symbol = replicate(0);
   symbol[  0] = 'b111111100101101111100001111010010100101111111;
   symbol[  1] = 'b100000100101011100101011010000111101001000001;
   symbol[  2] = 'b101110100010101101111010000101010101001011101;
   symbol[  3] = 'b101110101100010110101011011100001001101011101;
   symbol[  4] = 'b101110101110100101111111100111010111101011101;
   symbol[  5] = 'b100000100110011100111000110110100100001000001;
   symbol[  6] = 'b111111101010101010101010101010101010101111111;
   symbol[  7] = 'b000000000011001001101000111000110110100000000;
   symbol[  8] = 'b110001110111011100111111101011100111100011000;
   symbol[  9] = 'b011001001001101101110011110000111100110001000;
   symbol[ 10] = 'b010111111010000111010000100011100101100010010;
   symbol[ 11] = 'b010101001011110110000001111100100110111101010;
   symbol[ 12] = 'b001111111101011110001011110110100101110111110;
   symbol[ 13] = 'b000100011111110110100001111100101111011100010;
   symbol[ 14] = 'b010111111111100111010000100101111100000100100;
   symbol[ 15] = 'b011101010000011100001011101111001011001110111;
   symbol[ 16] = 'b110100110100100001010000110100011000110101000;
   symbol[ 17] = 'b110001000101010000100110100101001001000100100;
   symbol[ 18] = 'b110011100001000011111100001111100011001110101;
   symbol[ 19] = 'b101110001110101001111110000001010001000000100;
   symbol[ 20] = 'b001111111011111000101111110010000001111111110;
   symbol[ 21] = 'b011110001011101011111000101001011010100011101;
   symbol[ 22] = 'b000010101111111000111010110010100000101010011;
   symbol[ 23] = 'b101110001110101001111000111000110110100010101;
   symbol[ 24] = 'b100011111100100111111111110000111100111111100;
   symbol[ 25] = 'b111101000100100111101001011010110110110111001;
   symbol[ 26] = 'b000011110101100111010010100011100100000110010;
   symbol[ 27] = 'b111100011110111100010001010110101100111101000;
   symbol[ 28] = 'b011010111001100101011010001101111110011100101;
   symbol[ 29] = 'b010110001010110110100001011100101110101110110;
   symbol[ 30] = 'b111110110110111100010110111110100111100101111;
   symbol[ 31] = 'b010110000000110110000100100101000000000110110;
   symbol[ 32] = 'b010001101110100001001101110100011001111000100;
   symbol[ 33] = 'b101011010101011010101110101111000011000010101;
   symbol[ 34] = 'b000010101110011000101101110100111001111001110;
   symbol[ 35] = 'b011110010111001001100100100001010000000000110;
   symbol[ 36] = 'b100110100001100011111111101001011010111110101;
   symbol[ 37] = 'b000000001101000001101000100011010000100011000;
   symbol[ 38] = 'b111111101110011000101010110010100001101010011;
   symbol[ 39] = 'b100000101001000011111000110010111101100011000;
   symbol[ 40] = 'b101110100011111100111111101011100111111110111;
   symbol[ 41] = 'b101110100110100111101001111010110111100101000;
   symbol[ 42] = 'b101110100110111100000011111000111111101111011;
   symbol[ 43] = 'b100000101110110110000110111100100111100101000;
   symbol[ 44] = 'b111111101001100101011111001101111110110100110;
   Integer n = 45;
   QRDecoder dut <- mkQRDecoder;
   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);
   rule tick; cycle <= cycle + 1; endrule
   rule go (!started);
      dut.start(fromInteger(n)); started <= True; startAt <= cycle;
   endrule
   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule
   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp; dut.mem.resp(answer); endrule
   rule get (started);
      let b <- dut.getByte;
      $display("BYTE %02h", b.data);
      if (b.last) begin
         $display("RESULT DONE cycles=%0d", cycle - startAt);
         $finish(0);
      end
   endrule
   rule fail (started && dut.failed);
      $display("RESULT FAILED cycles=%0d", cycle - startAt);
      $finish(0);
   endrule
   rule timeout (started && cycle - startAt > 200000);
      $display("RESULT TIMEOUT");
      $finish(1);
   endrule
endmodule
endpackage
