   symbol[167] = 'b000000011111100000101111011001111101101110111010010001000010000100001101010100010000111101010011001000100101001000110000111011110000100011110100101110100010010100111011000010100;
   symbol[168] = 'b000000110001110010000000111011111111101100110010111011101111101110100101110110111011111111110001000010001111000111111010110111011011101011001111101100101010111110110010111110101;
   symbol[169] = 'b000000001010100111011110110010001101000100110010010001001000100100001111011100010001100011011011101000100101101010001000110101010001000011001000110100100100010101010010100010100;
   symbol[170] = 'b111111101001111101100100101010101001000100010000111011111010101010101100110110101010101011110011001010101111001110101010010111011011101001001010111100001110111101110000101010001;
   symbol[171] = 'b100000101110000000101111010110001111101110111010010001011000100010001100110100001000100011010011001001000101010110001000111101110001000011111000110110100100010111011011100010100;
   symbol[172] = 'b101110101001110010000000110011111001101100110010111011111111101001000100010110100011111111110001000011101111011011111010110011011011101011001111111100101110111101110010111110101;
   symbol[173] = 'b101110100010100111011110110111111111000100110010010001001111000011101110111100001001101001011011101001000101110011001000110011010001000011010101001100100010010000110010010100110;
   symbol[174] = 'b101110101001111101100100101110100001000100010000111011101101101111001101110110111011001011110011001011101111011001000010010001011011101001010111000100001000111010010000111100001;
   symbol[175] = 'b100000101110000000101111010110111101101110111010010001001101000101001101010100010001001001010011001001000101001011101000111011110001000011111101101110100010010000111010010110111;
   symbol[176] = 'b111111101001110010000000110010001111101100110010111011100101101110100101101110111011000011110001000011101111000011011010110011011011101011010111001100101010111010110010111100101;

   Integer n = 177;
   QRDecoder dut <- mkQRDecoder;

   Reg#(Bool)      started <- mkReg(False);
   Reg#(UInt#(32)) cycle   <- mkReg(0);
   Reg#(UInt#(32)) startAt <- mkReg(0);
   Reg#(Bit#(1))   answer  <- mkReg(0);

   rule tick;
      cycle <= cycle + 1;
   endrule

   rule go (!started);
      dut.start(fromInteger(n));
      started <= True;
      startAt <= cycle;
      $display("start: %0dx%0d symbol (Version 40)", n, n);
   endrule

   rule serve_req;
      match {.r, .c} <- dut.mem.req;
      Bit#(1) b = 0;
      if (r < fromInteger(n) && c < fromInteger(n)) begin
         Bit#(N) row = symbol[r];
         b = row[fromInteger(n - 1) - c];
      end
      answer <= b;
   endrule

   (* fire_when_enabled, no_implicit_conditions *)
   rule serve_resp;
      dut.mem.resp(answer);
   endrule

   rule get (started);
      let b <- dut.getByte;
      if (!b.last)
         $display("byte: %02h  '%c'", b.data, b.data);
      else begin
         $display("byte: %02h  '%c'   <- last", b.data, b.data);
         $display("SUCCESS: Version 40 decoded in %0d cycles", cycle - startAt);
         $finish(0);
      end
   endrule

   rule fail (started && dut.failed);
      $display("FAIL: Decoder raised failed after %0d cycles", cycle - startAt);
      $finish(1);
   endrule

   rule timeout (started && cycle - startAt > 150000);
      $display("TIMEOUT: after %0d cycles", cycle - startAt);
      $finish(1);
   endrule
endmodule

endpackage
